<!-- ============ ADMIN CURRICULUM MANAGEMENT HEADER ============ -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
  <div>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-1 small">
        <li class="breadcrumb-item"><a href="/admin/dashboard" class="text-decoration-none">Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">Curriculum Cards</li>
      </ol>
    </nav>
    <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
      <i class="ri-graduation-cap-line text-primary"></i>
      <span>Curriculum & Academic Year Cards</span>
    </h3>
    <p class="text-muted small mb-0">Manage and reorder the 5 Academic Year Cards, or customize the homepage section headline and syllabus settings.</p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <a href="/#subjects-section" target="_blank" class="btn btn-outline-primary rounded-pill px-3.5 py-2 fw-semibold">
      <i class="ri-external-link-line me-1"></i> Preview on Homepage
    </a>
    <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addCardModal" style="background: #0a5dc2; border:none;">
      <i class="ri-add-circle-line me-1.5"></i> Add New Year Card
    </button>
  </div>
</div>

<!-- ============ SEGMENTED TAB NAVIGATION ============ -->
<div class="pe-hero-nav-tabs-container mb-4">
  <ul class="nav nav-pills pe-hero-segmented-tabs" id="curriculumManagerTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active d-flex align-items-center gap-2" id="tab-cards-btn" data-bs-toggle="pill" data-bs-target="#tab-cards" type="button" role="tab" onclick="setCurriculumTab('cards')">
        <i class="ri-layout-masonry-line fs-5"></i>
        <span>Academic Year Cards</span>
        <span class="badge bg-primary text-white rounded-pill px-2 py-0.5 small ms-1"><%= cards.length %> Cards</span>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link d-flex align-items-center gap-2" id="tab-settings-btn" data-bs-toggle="pill" data-bs-target="#tab-settings" type="button" role="tab" onclick="setCurriculumTab('settings')">
        <i class="ri-settings-4-line fs-5"></i>
        <span>Section Headline & Preview</span>
      </button>
    </li>
  </ul>
</div>

<!-- ======================================================== -->
<!-- TAB CONTENT PANELS -->
<!-- ======================================================== -->
<div class="tab-content" id="curriculumManagerTabContent">

  <!-- ======================================================== -->
  <!-- TAB 1: ACADEMIC YEAR CARDS MANAGEMENT (FULL WIDTH, NO SCROLL) -->
  <!-- ======================================================== -->
  <div class="tab-pane fade show active" id="tab-cards" role="tabpanel" aria-labelledby="tab-cards-btn">
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
      <div class="card-header bg-white p-4 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <div class="p-2 bg-primary-subtle text-primary rounded-3 d-inline-flex">
              <i class="ri-apps-2-fill fs-5"></i>
            </div>
            <h5 class="fw-bold text-dark mb-0">Homepage Academic Year Cards (<%= cards.length %>)</h5>
          </div>
          <p class="text-muted small mb-0">Click <strong>Move Up</strong> or <strong>Move Down</strong> arrows to reorder how the cards appear on the homepage.</p>
        </div>

        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3.5 py-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#addCardModal" style="background:#0a5dc2; border:none;">
          <i class="ri-add-circle-line me-1"></i> Add Another Card
        </button>
      </div>

      <!-- Year Cards List / Table (Generous padding, fits completely without horizontal scroll) -->
      <div class="p-0">
        <table class="table pe-table align-middle mb-0" style="table-layout: auto; width: 100%;">
          <thead class="bg-light text-muted small text-uppercase" style="letter-spacing: 0.5px; border-bottom: 1.5px solid #e2e8f0;">
            <tr>
              <th class="ps-4 py-3" style="min-width: 320px;">Card Title & Subtitle</th>
              <th class="py-3 text-center" style="width: 140px;">Target Syllabus</th>
              <th class="py-3 text-center" style="width: 130px;">Theme Palette</th>
              <th class="py-3 text-center" style="width: 160px;">Position Order</th>
              <th class="py-3 text-center" style="width: 100px;">Status</th>
              <th class="pe-4 py-3 text-end" style="width: 150px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!cards || cards.length === 0) { %>
              <tr>
                <td colspan="6" class="text-center text-muted py-5">
                  <i class="ri-inbox-line fs-1 text-muted d-block mb-2"></i>
                  No year cards found. Click <strong>"Add New Year Card"</strong> to create one.
                </td>
              </tr>
            <% } %>
            <% cards.forEach((card, idx) => { %>
              <tr class="border-bottom">
                <!-- Card Title & Icon Preview -->
                <td class="ps-4 py-3">
                  <div class="d-flex align-items-center gap-3">
                    <div class="p-2.5 rounded-3 bg-<%= card.theme_color || 'primary' %>-subtle text-<%= card.theme_color || 'primary' %> fs-4 d-flex align-items-center justify-content-center" style="width:48px; height:48px; flex-shrink:0;">
                      <i class="<%= card.icon || 'ri-book-3-fill' %>"></i>
                    </div>
                    <div>
                      <div class="d-flex align-items-center gap-2 mb-0.5 flex-wrap">
                        <span class="fw-bold text-dark fs-6"><%= card.title %></span>
                        <% if (card.tag) { %>
                          <span class="badge bg-light text-<%= card.theme_color || 'primary' %> border rounded-pill px-2.5 py-0.5" style="font-size: 0.72rem; font-weight: 600;">
                            <%= card.tag %>
                          </span>
                        <% } %>
                      </div>
                      <div class="text-muted small" style="font-size: 0.82rem; line-height: 1.35;"><%= card.subtitle %></div>
                    </div>
                  </div>
                </td>

                <!-- Target Year -->
                <td class="py-3 text-center">
                  <% if (card.year_key === 'other') { %>
                    <span class="badge bg-purple-subtle text-purple px-3 py-1.5 rounded-pill fw-bold" style="background:#f5f3ff; color:#7c3aed; font-size: 0.76rem;">
                      <i class="ri-apps-2-line me-1"></i> Allied / Other
                    </span>
                  <% } else { %>
                    <span class="badge bg-light text-dark border px-3 py-1.5 rounded-pill fw-bold" style="font-size: 0.76rem;">
                      <i class="ri-book-read-line me-1 text-primary"></i> Year <%= card.year_key %>
                    </span>
                  <% } %>
                </td>

                <!-- Theme Color Badge -->
                <td class="py-3 text-center">
                  <% 
                    const colorMap = {
                      primary: { label: 'Blue', hex: '#0a5dc2' },
                      success: { label: 'Green', hex: '#16a34a' },
                      danger: { label: 'Crimson', hex: '#e11d48' },
                      warning: { label: 'Amber', hex: '#d97706' },
                      purple: { label: 'Purple', hex: '#7c3aed' }
                    };
                    const cInfo = colorMap[card.theme_color] || { label: card.theme_color, hex: '#0a5dc2' };
                  %>
                  <span class="badge bg-<%= card.theme_color || 'primary' %> text-white px-2.5 py-1 rounded-pill text-capitalize" style="font-size: 0.74rem;">
                    <%= cInfo.label %>
                  </span>
                </td>

                <!-- Position Order & Move Up/Down Controls -->
                <td class="py-3 text-center">
                  <div class="d-inline-flex align-items-center justify-content-center gap-1.5 bg-light p-1 rounded-pill border">
                    <!-- Move Up Form -->
                    <form action="/admin/curriculum/cards/<%= card.id %>/move-up" method="POST" class="d-inline mb-0">
                      <button type="submit" class="btn btn-sm btn-white bg-white border shadow-2xs rounded-circle p-0 <%= idx === 0 ? 'disabled opacity-40 pe-none' : '' %>" style="width: 28px; height: 28px; display:inline-flex; align-items:center; justify-content:center;" title="Move Up in Order">
                        <i class="ri-arrow-up-s-line text-dark fw-bold"></i>
                      </button>
                    </form>

                    <span class="badge bg-white text-dark border px-2.5 py-1 fw-bold font-monospace shadow-2xs" style="font-size: 0.8rem;">
                      #<%= card.display_order %>
                    </span>

                    <!-- Move Down Form -->
                    <form action="/admin/curriculum/cards/<%= card.id %>/move-down" method="POST" class="d-inline mb-0">
                      <button type="submit" class="btn btn-sm btn-white bg-white border shadow-2xs rounded-circle p-0 <%= idx === cards.length - 1 ? 'disabled opacity-40 pe-none' : '' %>" style="width: 28px; height: 28px; display:inline-flex; align-items:center; justify-content:center;" title="Move Down in Order">
                        <i class="ri-arrow-down-s-line text-dark fw-bold"></i>
                      </button>
                    </form>
                  </div>
                </td>

                <!-- Status -->
                <td class="py-3 text-center">
                  <% if (card.is_active) { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold" style="font-size: 0.74rem;">
                      <i class="ri-checkbox-circle-fill me-1"></i> Active
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1.5 rounded-pill fw-semibold" style="font-size: 0.74rem;">
                      <i class="ri-eye-off-line me-1"></i> Hidden
                    </span>
                  <% } %>
                </td>

                <!-- Actions -->
                <td class="pe-4 py-3 text-end">
                  <div class="d-flex align-items-center justify-content-end gap-1.5">
                    <!-- Edit Button Trigger Modal -->
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-semibold" data-bs-toggle="modal" data-bs-target="#editCardModal_<%= card.id %>">
                      <i class="ri-edit-line me-1"></i> Edit
                    </button>

                    <!-- Delete Form -->
                    <form action="/admin/curriculum/cards/<%= card.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete card &quot;<%= card.title %>&quot;?')" class="d-inline mb-0">
                      <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-0" style="width:32px; height:32px; display:inline-flex; align-items:center; justify-content:center;" title="Delete Card">
                        <i class="ri-delete-bin-line"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>

              <!-- EDIT MODAL FOR THIS CARD -->
              <div class="modal fade" id="editCardModal_<%= card.id %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="modal-header bg-light border-bottom px-4 py-3">
                      <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                        <i class="ri-edit-2-line text-primary"></i> Edit "<%= card.title %>" Card
                      </h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <form action="/admin/curriculum/cards/<%= card.id %>/update" method="POST">
                      <div class="modal-body p-4">
                        <!-- Title -->
                        <div class="mb-3">
                          <label class="form-label fw-semibold small text-dark">Card Title <span class="text-danger">*</span></label>
                          <input type="text" name="title" class="form-control" value="<%= card.title %>" required>
                        </div>

                        <!-- Tag / Pill -->
                        <div class="mb-3">
                          <label class="form-label fw-semibold small text-dark">Header Tag / Pill Label</label>
                          <input type="text" name="tag" class="form-control" value="<%= card.tag %>" placeholder="e.g. Year 1 • Foundation">
                        </div>

                        <!-- Subtitle -->
                        <div class="mb-3">
                          <label class="form-label fw-semibold small text-dark">Description / Subtitle</label>
                          <textarea name="subtitle" class="form-control" rows="2" placeholder="Short description of covered subjects..."><%= card.subtitle %></textarea>
                        </div>

                        <div class="row g-3 mb-3">
                          <!-- Target Year Key -->
                          <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Target Year Panel</label>
                            <select name="year_key" class="form-select">
                              <option value="1" <%= card.year_key === '1' ? 'selected' : '' %>>First Year (1)</option>
                              <option value="2" <%= card.year_key === '2' ? 'selected' : '' %>>Second Year (2)</option>
                              <option value="3" <%= card.year_key === '3' ? 'selected' : '' %>>Third Year (3)</option>
                              <option value="4" <%= card.year_key === '4' ? 'selected' : '' %>>Fourth Year (4)</option>
                              <option value="other" <%= card.year_key === 'other' ? 'selected' : '' %>>Other / Allied Subjects (other)</option>
                            </select>
                          </div>

                          <!-- Theme Color -->
                          <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Theme Color Palette</label>
                            <select name="theme_color" class="form-select">
                              <option value="primary" <%= card.theme_color === 'primary' ? 'selected' : '' %>>Blue (First Year)</option>
                              <option value="success" <%= card.theme_color === 'success' ? 'selected' : '' %>>Emerald Green (Second Year)</option>
                              <option value="danger" <%= card.theme_color === 'danger' ? 'selected' : '' %>>Crimson Red (Third Year)</option>
                              <option value="warning" <%= card.theme_color === 'warning' ? 'selected' : '' %>>Amber Gold (Fourth Year)</option>
                              <option value="purple" <%= card.theme_color === 'purple' ? 'selected' : '' %>>Deep Purple (Other Subjects)</option>
                            </select>
                          </div>
                        </div>

                        <div class="row g-3 mb-3">
                          <!-- Icon -->
                          <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Card Icon (Remix Icon)</label>
                            <div class="input-group">
                              <span class="input-group-text bg-light"><i class="<%= card.icon || 'ri-book-3-fill' %>" id="iconEditPrev_<%= card.id %>"></i></span>
                              <input type="text" name="icon" class="form-control" value="<%= card.icon || 'ri-book-3-fill' %>" oninput="document.getElementById('iconEditPrev_<%= card.id %>').className = this.value">
                            </div>
                          </div>

                          <!-- Display Order -->
                          <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Order Position</label>
                            <input type="number" name="display_order" class="form-control" value="<%= card.display_order %>" min="1">
                          </div>
                        </div>

                        <!-- Active Switch -->
                        <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                          <div>
                            <div class="fw-bold small text-dark">Card Active Status</div>
                            <div class="text-muted" style="font-size: 0.75rem;">When active, this card is shown on the homepage navigation</div>
                          </div>
                          <div class="form-check form-switch fs-5 mb-0">
                            <input class="form-check-input" type="checkbox" name="is_active" value="1" <%= card.is_active ? 'checked' : '' %>>
                          </div>
                        </div>
                      </div>

                      <div class="modal-footer bg-light border-top px-4 py-3">
                        <button type="button" class="btn btn-light rounded-pill px-3.5" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background: #0a5dc2; border:none;">
                          <i class="ri-save-3-line me-1"></i> Update Card
                        </button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- TAB 2: SECTION HEADLINE & LIVE PREVIEW -->
  <!-- ======================================================== -->
  <div class="tab-pane fade" id="tab-settings" role="tabpanel" aria-labelledby="tab-settings-btn">
    <div class="row g-4">
      <!-- Left Column: Settings Form -->
      <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
          <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
            <div class="d-flex align-items-center gap-2">
              <div class="p-2 bg-primary-subtle text-primary rounded-3 d-inline-flex">
                <i class="ri-edit-line fs-5"></i>
              </div>
              <h5 class="fw-bold text-dark mb-0">Section Headline & Content</h5>
            </div>
          </div>

          <form action="/admin/curriculum/settings" method="POST">
            <!-- Visibility Switch -->
            <div class="p-3 rounded-3 bg-light border d-flex align-items-center justify-content-between mb-4">
              <div>
                <div class="fw-bold text-dark small">Enable Curriculum Section on Homepage</div>
                <div class="text-muted" style="font-size: 0.75rem;">Turn on/off the entire curriculum and academic year cards section</div>
              </div>
              <div class="form-check form-switch fs-5 mb-0">
                <input class="form-check-input" type="checkbox" name="is_enabled" value="1" id="sectionEnabledSwitch" <%= curriculumSettings.isEnabled ? 'checked' : '' %>>
              </div>
            </div>

            <!-- Badge Icon & Text -->
            <div class="mb-3">
              <label class="form-label fw-semibold small text-dark">Section Badge Text & Icon</label>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="<%= curriculumSettings.badgeIcon || 'ri-graduation-cap-line' %>" id="badgeIconPreview"></i></span>
                <input type="text" name="badge_icon" class="form-control" value="<%= curriculumSettings.badgeIcon || 'ri-graduation-cap-line' %>" placeholder="Remix icon class" style="max-width: 140px;" oninput="document.getElementById('badgeIconPreview').className = this.value; document.getElementById('liveBadgeIcon').className = this.value + ' me-1.5 align-middle';">
                <input type="text" name="badge_text" class="form-control" value="<%= curriculumSettings.badgeText %>" placeholder="Badge text" oninput="document.getElementById('liveBadgeText').innerText = this.value;" required>
              </div>
            </div>

            <!-- Section Title -->
            <div class="mb-3">
              <label class="form-label fw-semibold small text-dark">Section Headline Title</label>
              <input type="text" name="title" class="form-control form-control-lg fs-6" value="<%= curriculumSettings.title %>" placeholder="e.g. Comprehensive Physiotherapy Curriculum by Year" oninput="document.getElementById('liveTitle').innerText = this.value;" required>
            </div>

            <!-- Section Subtext -->
            <div class="mb-4">
              <label class="form-label fw-semibold small text-dark">Section Subtitle / Description</label>
              <textarea name="subtext" class="form-control" rows="3" placeholder="Brief curriculum overview..." oninput="document.getElementById('liveSubtext').innerText = this.value;"><%= curriculumSettings.subtext %></textarea>
            </div>

            <div class="d-flex justify-content-end">
              <button type="submit" class="btn btn-primary rounded-pill px-5 py-2.5 fw-bold shadow-sm" style="background: #0a5dc2; border:none;">
                <i class="ri-save-3-line me-1.5"></i> Save Section Settings
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Right Column: Live Appearance Preview -->
      <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white position-sticky" style="top: 20px;">
          <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
            <i class="ri-eye-line text-primary"></i> Live Homepage Header Preview
          </h6>
          <div class="p-4 rounded-4 text-center" style="background: #f8fafc; border: 1.5px dashed #cbd5e1;">
            <span class="badge bg-primary-subtle text-primary fw-bold text-uppercase px-3.5 py-2 rounded-pill mb-3 shadow-xs" style="font-size: 0.74rem; letter-spacing: 0.05em;">
              <i class="<%= curriculumSettings.badgeIcon || 'ri-graduation-cap-line' %> me-1.5 align-middle" id="liveBadgeIcon"></i>
              <span id="liveBadgeText"><%= curriculumSettings.badgeText %></span>
            </span>
            <h4 class="fw-bold text-dark mb-2" style="letter-spacing: -0.015em; line-height: 1.3;" id="liveTitle"><%= curriculumSettings.title %></h4>
            <p class="text-secondary small mb-0" style="font-size: 0.88rem; line-height: 1.55;" id="liveSubtext"><%= curriculumSettings.subtext %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<!-- ========================================== -->
<!-- ADD NEW YEAR CARD MODAL -->
<!-- ========================================== -->
<div class="modal fade" id="addCardModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
      <div class="modal-header bg-light border-bottom px-4 py-3">
        <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
          <i class="ri-add-circle-fill text-primary"></i> Add New Academic Year Card
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form action="/admin/curriculum/cards" method="POST">
        <div class="modal-body p-4">
          <!-- Title -->
          <div class="mb-3">
            <label class="form-label fw-semibold small text-dark">Card Title <span class="text-danger">*</span></label>
            <input type="text" name="title" class="form-control" placeholder="e.g. Fifth Year / Post Graduate" required>
          </div>

          <!-- Tag / Pill -->
          <div class="mb-3">
            <label class="form-label fw-semibold small text-dark">Header Tag / Pill Label</label>
            <input type="text" name="tag" class="form-control" placeholder="e.g. Master • MPT Clinical">
          </div>

          <!-- Subtitle -->
          <div class="mb-3">
            <label class="form-label fw-semibold small text-dark">Description / Subtitle</label>
            <textarea name="subtitle" class="form-control" rows="2" placeholder="Brief summary of modules covered..."></textarea>
          </div>

          <div class="row g-3 mb-3">
            <!-- Target Year Key -->
            <div class="col-md-6">
              <label class="form-label fw-semibold small text-dark">Target Year Panel</label>
              <select name="year_key" class="form-select">
                <option value="1">First Year (1)</option>
                <option value="2">Second Year (2)</option>
                <option value="3">Third Year (3)</option>
                <option value="4">Fourth Year (4)</option>
                <option value="other" selected>Other / Allied Subjects (other)</option>
              </select>
            </div>

            <!-- Theme Color -->
            <div class="col-md-6">
              <label class="form-label fw-semibold small text-dark">Theme Color Palette</label>
              <select name="theme_color" class="form-select">
                <option value="primary">Blue (First Year)</option>
                <option value="success">Emerald Green (Second Year)</option>
                <option value="danger">Crimson Red (Third Year)</option>
                <option value="warning">Amber Gold (Fourth Year)</option>
                <option value="purple" selected>Deep Purple (Other Subjects)</option>
              </select>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <!-- Icon -->
            <div class="col-md-6">
              <label class="form-label fw-semibold small text-dark">Card Icon (Remix Icon)</label>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="ri-book-3-fill" id="newCardIconPreview"></i></span>
                <input type="text" name="icon" class="form-control" value="ri-book-3-fill" oninput="document.getElementById('newCardIconPreview').className = this.value">
              </div>
            </div>

            <!-- Display Order -->
            <div class="col-md-6">
              <label class="form-label fw-semibold small text-dark">Order Position</label>
              <input type="number" name="display_order" class="form-control" value="<%= cards.length + 1 %>" min="1">
            </div>
          </div>

          <!-- Active Switch -->
          <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
            <div>
              <div class="fw-bold small text-dark">Card Active Status</div>
              <div class="text-muted" style="font-size: 0.75rem;">Make card visible immediately on homepage</div>
            </div>
            <div class="form-check form-switch fs-5 mb-0">
              <input class="form-check-input" type="checkbox" name="is_active" value="1" checked>
            </div>
          </div>
        </div>

        <div class="modal-footer bg-light border-top px-4 py-3">
          <button type="button" class="btn btn-light rounded-pill px-3.5" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background: #0a5dc2; border:none;">
            <i class="ri-add-line me-1"></i> Add Card
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function setCurriculumTab(tabKey) {
    if (history.pushState) {
      history.pushState(null, null, '#' + tabKey);
    } else {
      location.hash = '#' + tabKey;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const hash = window.location.hash.replace('#', '');
    if (hash === 'settings') {
      const tabBtn = document.getElementById('tab-settings-btn');
      if (tabBtn) {
        bootstrap.Tab.getOrCreateInstance(tabBtn).show();
      }
    }
  });
</script>
