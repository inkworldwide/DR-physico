<div class="pe-page-head d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h2 class="pe-page-title mb-1">Learning Modules & Question Bank</h2>
    <p class="text-muted small mb-0">Upload and manage MCQs, Large Questions (10-15M), Small Questions (2-5M), and PDF/Doc materials by Subject & Course.</p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <button class="btn btn-outline-primary btn-sm rounded-pill fw-semibold px-3" data-bs-toggle="modal" data-bs-target="#uploadDocModal">
      <i class="ri-upload-cloud-line me-1"></i> Upload PDF / Doc
    </button>
    <a href="/admin/learning-modules/new" class="btn btn-primary btn-sm rounded-pill fw-semibold px-3.5 shadow-sm">
      <i class="ri-add-line me-1"></i> Add Question
    </a>
  </div>
</div>

<!-- ============ KPI STATS CARDS ============ -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Total Questions</div>
          <div class="fs-4 fw-800 text-dark"><%= stats.totalQuestions %></div>
          <div class="small text-muted" style="font-size: 0.75rem;"><%= stats.totalSubjectsCovered %> Subjects Covered</div>
        </div>
        <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
          <i class="ri-questionnaire-line fs-4"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">MCQs</div>
          <div class="fs-4 fw-800 text-primary"><%= stats.totalMcqs %></div>
          <div class="small text-muted" style="font-size: 0.75rem;">Interactive practice</div>
        </div>
        <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
          <i class="ri-checkbox-circle-line fs-4"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Large Q&A (10-15M)</div>
          <div class="fs-4 fw-800 text-info"><%= stats.totalLargeQa %></div>
          <div class="small text-muted" style="font-size: 0.75rem;">Model essays & cases</div>
        </div>
        <div class="rounded-3 bg-info-subtle text-info d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
          <i class="ri-file-list-3-line fs-4"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Small Q&A / Docs</div>
          <div class="fs-4 fw-800 text-warning"><%= stats.totalSmallQa %> <span class="fs-6 text-muted fw-normal">/ <%= stats.totalDocs %> Docs</span></div>
          <div class="small text-muted" style="font-size: 0.75rem;">2-5M short notes</div>
        </div>
        <div class="rounded-3 bg-warning-subtle text-warning d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
          <i class="ri-question-answer-line fs-4"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ============ FILTER BAR ============ -->
<div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
  <form action="/admin/learning-modules" method="GET" class="row g-2 align-items-center">
    <div class="col-md-3">
      <select name="category_id" class="form-select form-select-sm rounded-pill" onchange="this.form.submit()">
        <option value="">All Subjects</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat.id %>" <%= filters.category_id == cat.id ? 'selected' : '' %>>
            <%= cat.name %> (Year <%= cat.year || 'Elective' %>)
          </option>
        <% }) %>
      </select>
    </div>

    <div class="col-md-3">
      <select name="course_id" class="form-select form-select-sm rounded-pill" onchange="this.form.submit()">
        <option value="">All Courses</option>
        <% allCourses.forEach(co => { %>
          <option value="<%= co.id %>" <%= filters.course_id == co.id ? 'selected' : '' %>>
            <%= co.title %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="col-md-2">
      <select name="type" class="form-select form-select-sm rounded-pill" onchange="this.form.submit()">
        <option value="">All Types</option>
        <option value="mcq" <%= filters.type === 'mcq' ? 'selected' : '' %>>MCQ</option>
        <option value="large_qa" <%= filters.type === 'large_qa' ? 'selected' : '' %>>Large Q&A (10-15M)</option>
        <option value="small_qa" <%= filters.type === 'small_qa' ? 'selected' : '' %>>Small Q&A (2-5M)</option>
      </select>
    </div>

    <div class="col-md-3">
      <div class="position-relative">
        <i class="ri-search-line position-absolute top-50 start-0 translate-middle-y ms-2.5 text-muted small"></i>
        <input type="text" name="search" class="form-control form-control-sm ps-4.5 rounded-pill bg-light border-0" placeholder="Search questions..." value="<%= filters.search %>">
      </div>
    </div>

    <div class="col-md-1 d-flex gap-1">
      <button type="submit" class="btn btn-sm btn-primary rounded-pill w-100"><i class="ri-filter-3-line"></i></button>
      <% if (filters.category_id || filters.course_id || filters.type || filters.search) { %>
        <a href="/admin/learning-modules" class="btn btn-sm btn-light rounded-pill border" title="Clear Filters"><i class="ri-close-line"></i></a>
      <% } %>
    </div>
  </form>
</div>

<!-- ============ MAIN QUESTIONS TABLE ============ -->
<div class="card border-0 shadow-sm rounded-4 bg-white mb-4 overflow-hidden">
  <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
    <h5 class="fw-bold text-dark mb-0">Questions Directory (<%= questions.length %>)</h5>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-light text-dark border"><%= filters.show_deleted === '1' ? 'Showing Recycle Bin' : 'Active Questions' %></span>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="bg-light text-muted small text-uppercase">
        <tr>
          <th class="ps-4">ID & Type</th>
          <th>Subject & Course</th>
          <th style="min-width: 260px;">Question Prompt</th>
          <th>Marks / Difficulty</th>
          <th>Status</th>
          <th class="text-end pe-4">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (questions.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center py-5 text-muted">
              <i class="ri-inbox-line display-4 d-block mb-2 opacity-50"></i>
              No questions found. Click <strong>Add Question</strong> or <strong>Upload PDF / Doc</strong> to get started.
            </td>
          </tr>
        <% } %>

        <% questions.forEach(q => { %>
          <tr>
            <td class="ps-4">
              <span class="fw-bold text-dark">#<%= q.id %></span>
              <div class="mt-1">
                <% if (q.question_type === 'mcq') { %>
                  <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-0.5 small fw-bold">MCQ</span>
                <% } else if (q.question_type === 'large_qa') { %>
                  <span class="badge bg-info-subtle text-info rounded-pill px-2.5 py-0.5 small fw-bold">Large Q&A</span>
                <% } else { %>
                  <span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-0.5 small fw-bold">Small Q&A</span>
                <% } %>
              </div>
            </td>

            <td>
              <div class="fw-semibold text-dark"><%= q.category_name || 'General' %></div>
              <% if (q.course_title) { %>
                <div class="text-muted small"><i class="ri-book-2-line me-1"></i><%= q.course_title %></div>
              <% } %>
            </td>

            <td>
              <% if (q.title) { %><strong class="text-dark d-block mb-0.5"><%= q.title %></strong><% } %>
              <div class="text-secondary small line-clamp-2" style="max-width: 380px;"><%= q.question %></div>
              <% if (q.document_url) { %>
                <a href="<%= q.document_url %>" target="_blank" class="badge bg-light text-primary border text-decoration-none mt-1">
                  <i class="ri-attachment-line me-1"></i> Attached Document
                </a>
              <% } %>
            </td>

            <td>
              <span class="badge bg-light text-dark border px-2 py-1 small fw-semibold font-monospace"><%= q.marks %> Marks</span>
              <% if (q.difficulty) { %>
                <span class="badge <%= q.difficulty === 'Easy' ? 'bg-success-subtle text-success' : q.difficulty === 'Medium' ? 'bg-warning-subtle text-warning' : 'bg-danger-subtle text-danger' %> px-2 py-0.5 rounded-pill small fw-bold ms-1">
                  <%= q.difficulty %>
                </span>
              <% } %>
            </td>

            <td>
              <form action="/admin/learning-modules/<%= q.id %>/toggle" method="POST" class="d-inline">
                <button type="submit" class="badge <%= q.is_active ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary' %> border-0 px-2.5 py-1 rounded-pill small fw-bold" style="cursor: pointer;">
                  <%= q.is_active ? 'Active' : 'Draft' %>
                </button>
              </form>
            </td>

            <td class="text-end pe-4">
              <div class="d-inline-flex align-items-center gap-1">
                <a href="/admin/learning-modules/<%= q.id %>/edit" class="btn btn-sm btn-outline-primary rounded-circle p-1.5" title="Edit Question" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                  <i class="ri-edit-line"></i>
                </a>
                <form action="/admin/learning-modules/<%= q.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Move question to trash?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-1.5" title="Delete Question" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="ri-delete-bin-line"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- ============ UPLOADED PDF & DOCUMENTS SECTION ============ -->
<div class="card border-0 shadow-sm rounded-4 bg-white mb-4 overflow-hidden">
  <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
    <div>
      <h5 class="fw-bold text-dark mb-0">Uploaded Learning Documents & PDFs (<%= documents.length %>)</h5>
      <p class="text-muted small mb-0">PDFs, Word docs, and study materials attached to subjects & courses</p>
    </div>
    <button class="btn btn-outline-primary btn-sm rounded-pill fw-semibold px-3" data-bs-toggle="modal" data-bs-target="#uploadDocModal">
      <i class="ri-upload-cloud-line me-1"></i> Upload Document
    </button>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="bg-light text-muted small text-uppercase">
        <tr>
          <th class="ps-4">Document Title</th>
          <th>Subject / Course</th>
          <th>Type / Size</th>
          <th>Uploaded Date</th>
          <th class="text-end pe-4">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (documents.length === 0) { %>
          <tr>
            <td colspan="5" class="text-center py-4 text-muted">
              No documents uploaded yet. Upload PDFs or DOCs to make them viewable online in the Learning Modules.
            </td>
          </tr>
        <% } %>

        <% documents.forEach(doc => { %>
          <tr>
            <td class="ps-4">
              <div class="d-flex align-items-center gap-2.5">
                <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                  <i class="ri-file-pdf-line fs-5"></i>
                </div>
                <div>
                  <strong class="text-dark d-block"><%= doc.title %></strong>
                  <span class="text-muted small"><%= doc.file_name %></span>
                </div>
              </div>
            </td>

            <td>
              <div class="fw-semibold text-dark"><%= doc.category_name || 'General' %></div>
              <% if (doc.course_title) { %>
                <div class="text-muted small"><i class="ri-book-2-line me-1"></i><%= doc.course_title %></div>
              <% } %>
            </td>

            <td>
              <span class="badge bg-light text-dark border px-2 py-1 small text-uppercase fw-bold font-monospace"><%= doc.file_type || 'PDF' %></span>
              <span class="text-muted small ms-1"><%= doc.file_size || '' %></span>
            </td>

            <td class="text-muted small">
              <%= new Date(doc.created_at).toLocaleDateString() %>
            </td>

            <td class="text-end pe-4">
              <div class="d-inline-flex align-items-center gap-1.5">
                <a href="<%= doc.file_url %>" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 font-weight-semibold">
                  <i class="ri-eye-line me-1"></i> View / Open
                </a>
                <form action="/admin/learning-modules/doc/<%= doc.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this document?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-1.5" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="ri-delete-bin-line"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- ============ UPLOAD DOCUMENT MODAL ============ -->
<div class="modal fade" id="uploadDocModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 rounded-4 shadow-lg">
      <form action="/admin/learning-modules/upload-doc" method="POST" enctype="multipart/form-data">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold text-dark"><i class="ri-upload-cloud-line text-primary me-2"></i>Upload Learning Material (PDF/Doc)</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body py-4">
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Subject <span class="text-danger">*</span></label>
            <select name="category_id" class="form-select rounded-3" required>
              <option value="">Select Subject...</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.name %> (Year <%= cat.year || 'Elective' %>)</option>
              <% }) %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Course (Optional)</label>
            <select name="course_id" class="form-select rounded-3">
              <option value="">All Courses in Subject</option>
              <% allCourses.forEach(co => { %>
                <option value="<%= co.id %>"><%= co.title %></option>
              <% }) %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Document Title <span class="text-danger">*</span></label>
            <input type="text" name="title" class="form-control rounded-3" placeholder="e.g. Upper Limb Comprehensive Notes & MCQs" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Choose PDF / Doc File <span class="text-danger">*</span></label>
            <input type="file" name="note_file" class="form-control rounded-3" accept=".pdf,.doc,.docx,.txt" required>
            <div class="form-text small">Supported: PDF, Word (.doc, .docx), Text files (up to 100MB).</div>
          </div>

          <div class="mb-0">
            <label class="form-label small fw-bold text-dark">Description (Optional)</label>
            <textarea name="description" class="form-control rounded-3" rows="2" placeholder="Brief summary of what this document covers..."></textarea>
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold"><i class="ri-upload-2-line me-1"></i>Upload Document</button>
        </div>
      </form>
    </div>
  </div>
</div>
