<!-- ADD HERO FEATURE CARD MODAL -->
<!-- ========================================== -->
<div class="modal fade" id="addHeroFeatureModal" tabindex="-1" aria-labelledby="addHeroFeatureModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
      <div class="modal-header bg-primary text-white p-4">
        <h5 class="modal-title font-weight-bold text-white d-flex align-items-center gap-2" id="addHeroFeatureModalLabel">
          <i class="ri-add-circle-fill text-warning fs-4"></i> Add Hero Feature Card
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form action="/admin/features" method="POST" class="d-flex flex-column">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Card Title <span class="text-danger">*</span></label>
            <input type="text" name="title" class="form-control form-control-lg rounded-3" placeholder="e.g. Masterclasses, Live Q&A, Free Notes" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Subtitle / Counter <span class="text-danger">*</span></label>
            <input type="text" name="subtitle" class="form-control rounded-3" placeholder="e.g. 40+ Interactive Sessions" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Remix Icon Class</label>
            <input type="text" name="icon" class="form-control rounded-3" value="ri-slideshow-3-line" placeholder="e.g. ri-slideshow-3-line, ri-book-read-line, ri-microscope-line">
            <span class="text-muted small">Supports any Remix Icon (e.g. <code>ri-live-line</code>, <code>ri-gift-line</code>, <code>ri-award-line</code>)</span>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Target URL Link</label>
            <input type="text" name="url" class="form-control rounded-3" value="/live-sessions" placeholder="e.g. /subjects, /live-sessions, /learning-modules">
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Theme Badge Color</label>
            <select name="badge_color" class="form-select rounded-3">
              <option value="warning" selected>Warning (Amber Gold)</option>
              <option value="info">Info (Sky Blue)</option>
              <option value="success">Success (Emerald Green)</option>
              <option value="danger">Danger (Rose Red)</option>
              <option value="primary">Primary (Royal Blue)</option>
            </select>
          </div>

          <div class="mb-0">
            <label class="form-label small fw-bold text-primary">
              <i class="ri-sort-asc me-1"></i> Position / Display Order
            </label>
            <input type="number" name="display_order" class="form-control rounded-3 fw-bold text-primary" value="<%= heroFeatures.length + 1 %>" min="1" required>
          </div>
        </div>

        <div class="modal-footer bg-light p-3 border-top justify-content-between">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4 font-weight-bold shadow-sm py-2">
            <i class="ri-check-line me-1"></i> Add Feature Card
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- EDIT HERO FEATURE CARD MODALS -->
<!-- ========================================== -->
<% heroFeatures.forEach(f => { %>
<div class="modal fade" id="editHeroFeatureModal_<%= f.id %>" tabindex="-1" aria-labelledby="editHeroFeatureModalLabel_<%= f.id %>" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
      <div class="modal-header bg-primary text-white p-4">
        <h5 class="modal-title font-weight-bold text-white d-flex align-items-center gap-2" id="editHeroFeatureModalLabel_<%= f.id %>">
          <i class="ri-edit-circle-fill text-warning fs-4"></i> Edit Feature Card: <%= f.title %>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form action="/admin/features/<%= f.id %>/update" method="POST" class="d-flex flex-column">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Card Title <span class="text-danger">*</span></label>
            <input type="text" name="title" class="form-control form-control-lg rounded-3" value="<%= f.title %>" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Subtitle / Counter <span class="text-danger">*</span></label>
            <input type="text" name="subtitle" class="form-control rounded-3" value="<%= f.subtitle %>" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Remix Icon Class</label>
            <input type="text" name="icon" class="form-control rounded-3" value="<%= f.icon %>">
            <span class="text-muted small">Supports any Remix Icon (e.g. <code>ri-slideshow-3-line</code>, <code>ri-book-line</code>)</span>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Target URL Link</label>
            <input type="text" name="url" class="form-control rounded-3" value="<%= f.url %>">
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Theme Badge Color</label>
            <select name="badge_color" class="form-select rounded-3">
              <option value="warning" <%= f.badge_color === 'warning' ? 'selected' : '' %>>Warning (Amber Gold)</option>
              <option value="info" <%= f.badge_color === 'info' ? 'selected' : '' %>>Info (Sky Blue)</option>
              <option value="success" <%= f.badge_color === 'success' ? 'selected' : '' %>>Success (Emerald Green)</option>
              <option value="danger" <%= f.badge_color === 'danger' ? 'selected' : '' %>>Danger (Rose Red)</option>
              <option value="primary" <%= f.badge_color === 'primary' ? 'selected' : '' %>>Primary (Royal Blue)</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-primary">
              <i class="ri-sort-asc me-1"></i> Position / Display Order
            </label>
            <input type="number" name="display_order" class="form-control rounded-3 fw-bold text-primary" value="<%= f.display_order || 1 %>" min="1" required>
          </div>

          <!-- Mini Live Preview Box -->
          <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
              <div class="pe-feature-icon bg-<%= f.badge_color || 'primary' %>-subtle text-<%= f.badge_color || 'primary' %> p-2 rounded-3 fs-3 d-flex align-items-center justify-content-center" style="width:44px;height:44px;">
                <i class="<%= f.icon %>"></i>
              </div>
              <div>
                <span class="fw-bold d-block text-dark"><%= f.title %></span>
                <span class="text-muted small"><%= f.subtitle %></span>
              </div>
            </div>
            <span class="badge bg-success rounded-pill px-2.5 py-1 small">Live Card</span>
          </div>
        </div>

        <div class="modal-footer bg-light p-3 border-top justify-content-between">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4 font-weight-bold shadow-sm py-2">
            <i class="ri-save-line me-1"></i> Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<% }) %>

<script>
function setHeroTab(tabName) {
  window.location.hash = tabName;
}

// Auto-switch tab on page load based on URL hash
document.addEventListener('DOMContentLoaded', function() {
  const hash = (window.location.hash || '').replace('#', '');
  if (hash === 'cards' || hash === 'hero-features-section' || hash === 'hero-cards') {
    const btn = document.getElementById('tab-cards-btn');
    if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
  } else if (hash === 'tickers' || hash === 'trust-bar') {
    const btn = document.getElementById('tab-tickers-btn');
    if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
  } else {
    const btn = document.getElementById('tab-showcase-btn');
    if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
  }
});

function updateLivePreview() {
  const badgeText = document.getElementById('inputBadgeText').value;
  const badgeIcon = document.getElementById('inputBadgeIcon').value;
  const titlePrefix = document.getElementById('inputTitlePrefix').value;
  const titleHighlight = document.getElementById('inputTitleHighlight').value;
  const subtext = document.getElementById('inputSubtext').value;

  document.getElementById('previewBadgeText').innerText = badgeText;
  document.getElementById('previewBadgeIcon').className = badgeIcon + ' me-1';
  document.getElementById('previewTitlePrefix').innerText = titlePrefix + ' ';
  document.getElementById('previewTitleHighlight').innerText = titleHighlight;
  document.getElementById('previewSubtext').innerHTML = subtext;
}

function previewSelectedImage(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = function(e) {
      document.getElementById('heroImagePreview').src = e.target.result;
    }
    reader.readAsDataURL(input.files[0]);
  }
}

function updateTrustIconPreview(input, previewId) {
  const preview = document.getElementById(previewId);
  if (preview) {
    preview.className = (input.value || 'ri-check-line') + ' text-primary';
  }
}

let trustItemCounter = <%= (heroSettings.trustBarItems ? heroSettings.trustBarItems.length : 6) + 20 %>;
function addTrustItem() {
  trustItemCounter++;
  const container = document.getElementById('trustItemsContainer');
  const div = document.createElement('div');
  div.className = 'd-flex align-items-center gap-2 trust-item-row p-2 bg-light rounded-3 border';
  div.innerHTML = `
    <div class="input-group input-group-sm" style="max-width: 160px;">
      <span class="input-group-text bg-white"><i class="ri-check-line text-primary" id="iconPreview_${trustItemCounter}"></i></span>
      <input type="text" name="trust_item_icon[]" class="form-control" value="ri-check-line" placeholder="Icon class" oninput="updateTrustIconPreview(this, 'iconPreview_${trustItemCounter}')">
    </div>
    <input type="text" name="trust_item_text[]" class="form-control form-control-sm rounded-2 flex-grow-1 font-weight-semibold" placeholder="e.g. 100% Free Video Modules" required>
    <button type="button" class="btn btn-sm btn-outline-danger rounded-circle p-1" style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;" onclick="removeTrustItem(this)" title="Remove item">
      <i class="ri-delete-bin-line"></i>
    </button>
  `;
  container.appendChild(div);
}

function removeTrustItem(btn) {
  const row = btn.closest('.trust-item-row');
  if (row) {
    row.remove();
  }
}

function setSpeedPreset(type, value) {
  if (type === 'trust') {
    const range = document.getElementById('trustBarSpeedRange');
    const label = document.getElementById('trustSpeedLabel');
    if (range) range.value = value;
    if (label) label.innerText = value + 's';
  } else if (type === 'ticker') {
    const range = document.getElementById('tickerSpeedRange');
    const label = document.getElementById('tickerSpeedLabel');
    if (range) range.value = value;
    if (label) label.innerText = value + 's';
  }
}
</script>
