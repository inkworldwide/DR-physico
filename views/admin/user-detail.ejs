<!-- ============ PAGE HEADER & TOP NAVIGATION ============ -->
<div class="pe-detail-hero mb-4">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
    <!-- Breadcrumb -->
    <nav class="d-flex align-items-center gap-2 small">
      <a href="/admin/users" class="text-decoration-none text-muted fw-semibold d-inline-flex align-items-center gap-1 hover-primary">
        <i class="ri-arrow-left-line"></i> Manage Users
      </a>
      <span class="text-muted opacity-50">/</span>
      <% const headerRInfo = getRoleInfo(profileUser.role); %>
      <span class="pe-role-badge <%= headerRInfo.cls %>">
        <i class="<%= headerRInfo.icon %>"></i> <%= headerRInfo.label %>
      </span>
      <span class="text-muted opacity-50">/</span>
      <span class="fw-bold text-dark"><%= profileUser.name %></span>
    </nav>

    <!-- Top Action Buttons -->
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <a href="/admin/users" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 fw-bold d-inline-flex align-items-center gap-1 shadow-2xs">
        <i class="ri-arrow-left-line"></i> Back to Directory
      </a>
      <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3 py-1.5 fw-bold d-inline-flex align-items-center gap-1.5 shadow-2xs" onclick="openEditUserModal(<%= JSON.stringify(profileUser) %>)">
        <i class="ri-edit-line text-warning-emphasis"></i> Edit User
      </button>
      <% if (profileUser.role !== 'admin' && profileUser.role !== 'instructor') { %>
        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-bold d-inline-flex align-items-center gap-1.5 shadow-2xs" data-bs-toggle="modal" data-bs-target="#enrollStudentModal">
          <i class="ri-add-circle-line"></i> Enroll in Course
        </button>
        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3.5 py-1.5 fw-bold shadow-sm d-inline-flex align-items-center gap-1.5 hover-lift" style="background: linear-gradient(135deg, #0a5dc2 0%, #034694 100%); border: none;" onclick="openSmsModal('', '', '', '', '')">
          <i class="ri-message-3-line"></i> Send Direct SMS
        </button>
      <% } %>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- ============ LEFT COLUMN: EXECUTIVE PROFILE CARD ============ -->
  <div class="col-lg-4">
    <div class="pe-profile-card p-4 mb-4">
      <div class="text-center mb-3">
        <div class="position-relative d-inline-block mx-auto mb-2">
          <img src="<%= profileUser.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(profileUser.name) + '&background=0a5dc2&color=fff&size=256' %>" 
               class="pe-avatar-circle shadow-xs" 
               onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(profileUser.name) %>&background=0a5dc2&color=fff&size=256'">
          <span class="position-absolute bottom-0 end-0 badge <%= profileUser.is_active ? 'bg-success' : 'bg-danger' %> rounded-circle p-1.5 border border-white" style="width: 16px; height: 16px;" title="<%= profileUser.is_active ? 'Active Account' : 'Inactive Account' %>"></span>
        </div>

        <h4 class="fw-black text-dark mb-0" style="letter-spacing: -0.3px;"><%= profileUser.name %></h4>
        <p class="text-muted small mb-2"><%= profileUser.email %></p>
        
        <div class="mb-2">
          <span class="pe-user-id-pill">
            <i class="ri-fingerprint-line text-primary"></i> <%= profileUser.user_code || ('PE-' + (profileUser.role ? profileUser.role.substring(0,3).toUpperCase() : 'USR') + '-' + String(profileUser.id).padStart(4, '0')) %>
          </span>
        </div>
        
        <div class="d-flex align-items-center justify-content-center gap-1.5 mb-2 flex-wrap">
          <% const cardRInfo = getRoleInfo(profileUser.role); %>
          <span class="pe-role-badge <%= cardRInfo.cls %>">
            <i class="<%= cardRInfo.icon %>"></i> <%= cardRInfo.label %>
          </span>
          <span class="badge <%= profileUser.is_active ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle' %> px-2.5 py-1 rounded-pill font-weight-bold">
            <i class="ri-<%= profileUser.is_active ? 'checkbox-circle-line' : 'close-circle-line' %> me-1"></i> <%= profileUser.is_active ? 'Active' : 'Inactive' %>
          </span>
        </div>
      </div>

      <!-- Attributes List -->
      <div class="bg-light-subtle rounded-3 p-3 text-start small border mb-3">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
          <span class="text-muted fw-medium"><i class="ri-lock-password-line me-1"></i> Password</span>
          <div class="d-inline-flex align-items-center gap-1 bg-white px-2 py-0.5 rounded border shadow-2xs">
            <span id="detailUserPwVal" class="font-monospace fw-bold text-dark" style="font-size: 0.8rem;" data-hidden="true" data-plain="<%= profileUser.plain_password || (profileUser.role === 'admin' ? 'Admin@123' : (profileUser.role === 'instructor' ? 'Instructor@123' : 'Student@123')) %>">••••••••</span>
            <button type="button" class="btn btn-sm btn-light border p-0 rounded d-inline-flex align-items-center justify-content-center" style="width:20px;height:20px;" onclick="toggleDetailPw()" title="Show/Hide Password">
              <i class="ri-eye-line" id="detailPwEye" style="font-size: 0.75rem;"></i>
            </button>
            <button type="button" class="btn btn-sm btn-light border p-0 rounded d-inline-flex align-items-center justify-content-center" style="width:20px;height:20px;" id="detailCopyBtn" onclick="copyDetailPw()" title="Copy Password">
              <i class="ri-file-copy-line" style="font-size: 0.75rem;"></i>
            </button>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
          <span class="text-muted fw-medium"><i class="ri-phone-line me-1"></i> Mobile / SMS</span>
          <span class="fw-bold text-dark"><%= profileUser.phone || '+91 9111111101' %></span>
        </div>

        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
          <span class="text-muted fw-medium"><i class="ri-calendar-line me-1"></i> Joined Date</span>
          <span class="text-secondary"><%= new Date(profileUser.created_at).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
        </div>

        <div>
          <span class="text-muted fw-medium d-block mb-1"><i class="ri-profile-line me-1"></i> Bio & Qualification</span>
          <div class="p-2 bg-white rounded border text-secondary" style="font-size: 0.78rem;">
            <%= profileUser.bio || profileUser.qualification || 'BPT Undergraduate Student registered on PhysioEdvance.' %>
          </div>
        </div>
      </div>

      <!-- Account Actions -->
      <div class="d-flex flex-column gap-2">
        <form action="/admin/users/<%= profileUser.id %>/reset-password" method="POST" onsubmit="return confirm('Generate a new random temporary password for <%= profileUser.name %>?')">
          <button type="submit" class="btn btn-outline-primary btn-sm w-100 rounded-pill font-weight-bold py-1.5 shadow-2xs">
            <i class="ri-key-2-line me-1"></i> Reset & Generate Password
          </button>
        </form>
        <form action="/admin/users/<%= profileUser.id %>/toggle-active" method="POST">
          <button type="submit" class="btn btn-outline-secondary btn-sm w-100 rounded-pill py-1.5 font-weight-medium">
            <i class="ri-switch-line me-1"></i> <%= profileUser.is_active ? 'Deactivate Account' : 'Activate Account' %>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- ============ RIGHT COLUMN: CURRICULUM SUBSCRIPTIONS ============ -->
  <div class="col-lg-8">
    <% if (profileUser.role !== 'admin' && profileUser.role !== 'instructor') { %>
      <!-- TOP KPI METRICS FOR STUDENT / MEMBER -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="pe-kpi-micro-card shadow-xs d-flex align-items-center justify-content-between">
            <div>
              <div class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Enrolled</div>
              <div class="fs-4 fw-black text-dark mt-0.5"><%= (enrollments || []).length %></div>
            </div>
            <div class="pe-kpi-micro-icon bg-primary-subtle text-primary">
              <i class="ri-book-open-line"></i>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="pe-kpi-micro-card shadow-xs d-flex align-items-center justify-content-between">
            <div>
              <div class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Active Subscriptions</div>
              <div class="fs-4 fw-black text-success mt-0.5"><%= activeEnrollments.length %></div>
            </div>
            <div class="pe-kpi-micro-icon bg-success-subtle text-success">
              <i class="ri-checkbox-circle-line"></i>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="pe-kpi-micro-card shadow-xs d-flex align-items-center justify-content-between">
            <div>
              <div class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Expiring Soon</div>
              <div class="fs-4 fw-black <%= expiringSoonCount > 0 ? 'text-danger' : 'text-muted' %> mt-0.5"><%= expiringSoonCount %></div>
            </div>
            <div class="pe-kpi-micro-icon <%= expiringSoonCount > 0 ? 'bg-danger-subtle text-danger' : 'bg-light text-muted' %>">
              <i class="ri-alarm-warning-line"></i>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="pe-kpi-micro-card shadow-xs d-flex align-items-center justify-content-between">
            <div>
              <div class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Avg Progress</div>
              <div class="fs-4 fw-black text-info mt-0.5"><%= avgProgress %>%</div>
            </div>
            <div class="pe-kpi-micro-icon bg-info-subtle text-info">
              <i class="ri-pie-chart-line"></i>
            </div>
          </div>
        </div>
      </div>

      <!-- MAIN SUBSCRIPTIONS SECTION -->
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
          <div>
            <h5 class="fw-black text-dark mb-0 d-flex align-items-center gap-2">
              <i class="ri-graduation-cap-line text-primary"></i> Curriculum Subjects & Subscriptions
            </h5>
            <p class="text-muted small mb-0">Track course access, validity duration, and trigger SMS reminders.</p>
          </div>
          <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1.5 fw-bold shadow-2xs d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#enrollStudentModal">
            <i class="ri-add-line"></i> Add Course
          </button>
        </div>

        <!-- Expiring Soon Highlight Alert Banner (≤ 3 Days) -->
        <% const expiringItems = (enrollments || []).filter(e => e.is_expiring_soon); %>
        <% if (expiringItems.length > 0) { %>
          <div class="alert alert-danger border-danger-subtle bg-danger-subtle rounded-4 p-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2 shadow-2xs">
            <div class="d-flex align-items-center gap-2.5">
              <i class="ri-alarm-warning-fill text-danger fs-3"></i>
              <div>
                <strong class="text-danger">Action Recommended: Course Expiring in ≤ 3 Days</strong>
                <div class="small text-danger opacity-90 mt-0.5">
                  <%= expiringItems.map(e => `"${e.title}" (Expires in ${e.days_left} day${e.days_left !== 1 ? 's' : ''})`).join(', ') %>
                </div>
              </div>
            </div>
            <button type="button" class="btn btn-sm btn-danger rounded-pill px-3.5 py-1.5 fw-bold shadow-sm d-inline-flex align-items-center gap-1.5" onclick="openSmsModal('<%= expiringItems[0].course_id %>', '<%= expiringItems[0].title.replace(/'/g, '\\\'') %>', '<%= expiringItems[0].category_name || 'Subject' %>', '<%= expiringItems[0].valid_until ? new Date(expiringItems[0].valid_until).toLocaleDateString() : '' %>', '<%= expiringItems[0].days_left %>')">
              <i class="ri-message-3-line"></i> Send Expiry SMS Alert
            </button>
          </div>
        <% } %>

        <!-- EMPTY STATE (if 0 enrollments) -->
        <% if (!enrollments || enrollments.length === 0) { %>
          <div class="text-center py-5 px-3 border rounded-4 my-2" style="background: #f8fafc; border: 1.5px dashed #cbd5e1 !important;">
            <div class="pe-kpi-micro-icon bg-primary-subtle text-primary mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.7rem; border-radius: 14px;">
              <i class="ri-book-open-line"></i>
            </div>
            <h5 class="fw-black text-dark mb-1">No Curriculum Courses Enrolled Yet</h5>
            <p class="text-muted small mb-3 mx-auto" style="max-width: 420px;">
              This student is not enrolled in any subjects. You can enroll them directly to grant access to syllabus modules, video lectures, and study notes.
            </p>
            <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2 hover-lift" style="background: linear-gradient(135deg, #0a5dc2 0%, #034694 100%); border: none;" data-bs-toggle="modal" data-bs-target="#enrollStudentModal">
              <i class="ri-add-circle-fill fs-5"></i> Enroll Student in a Subject Course
            </button>
          </div>
        <% } else { %>
          <!-- MODERN CARD-BASED SUBSCRIPTION ITEMS (NO HORIZONTAL SCROLL) -->
          <div class="d-flex flex-column gap-3">
            <% enrollments.forEach(e => { 
                 const fromDateStr = e.valid_from ? new Date(e.valid_from).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : 'N/A';
                 const untilDateStr = e.valid_until ? new Date(e.valid_until).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : 'N/A';
            %>
              <div class="pe-sub-item-card <%= e.is_expiring_soon ? 'is-expiring' : '' %>">
                <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
                  
                  <!-- Left: Course Icon & Title & Subject Pill -->
                  <div class="d-flex align-items-center gap-3" style="min-width: 200px;">
                    <div class="pe-course-icon-badge <%= e.is_expiring_soon ? 'bg-danger-subtle text-danger' : '' %>">
                      <i class="ri-book-open-line"></i>
                    </div>
                    <div>
                      <h6 class="fw-bold text-dark mb-1" style="font-size: 0.95rem;"><%= e.title %></h6>
                      <div class="d-flex align-items-center gap-1.5 flex-wrap">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill font-weight-bold" style="font-size: 0.7rem;">
                          <i class="ri-stack-line me-1"></i><%= e.category_name || 'Subject' %> <% if (e.category_year) { %>(Year <%= e.category_year %>)<% } %>
                        </span>
                        <span class="badge bg-light text-muted border rounded-pill" style="font-size: 0.68rem;">
                          <i class="ri-user-2-line me-1"></i><%= e.instructor_name || 'Instructor' %>
                        </span>
                        <span class="badge bg-light text-muted border rounded-pill" style="font-size: 0.68rem;">
                          <%= e.course_type === 'pdf_document' ? 'PDF Notes' : 'Video & Hybrid' %>
                        </span>
                      </div>
                    </div>
                  </div>

                  <!-- Middle: Validity Period & Expiry Status -->
                  <div class="d-flex flex-column" style="min-width: 170px;">
                    <div class="small fw-semibold text-dark">
                      <i class="ri-calendar-check-line text-primary me-1"></i>
                      <span><%= fromDateStr %></span>
                      <span class="text-muted mx-1">➔</span>
                      <span class="<%= e.is_expiring_soon ? 'text-danger fw-black' : '' %>"><%= untilDateStr %></span>
                    </div>
                    <div class="d-flex align-items-center gap-1.5 mt-1">
                      <% if (e.is_expiring_soon) { %>
                        <span class="badge bg-danger text-white border border-danger-subtle px-2 py-0.5 rounded-pill font-weight-bold shadow-2xs" style="font-size: 0.7rem;">
                          <i class="ri-alarm-warning-fill me-1"></i> Expiring in <%= e.days_left %> day<%= e.days_left !== 1 ? 's' : '' %>
                        </span>
                      <% } else if (e.is_expired) { %>
                        <span class="badge bg-secondary text-white px-2 py-0.5 rounded-pill font-weight-bold" style="font-size: 0.7rem;">
                          <i class="ri-time-line me-1"></i> Expired (<%= Math.abs(e.days_left) %>d ago)
                        </span>
                      <% } else { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5 rounded-pill font-weight-bold" style="font-size: 0.7rem;">
                          <i class="ri-checkbox-circle-line me-1"></i> <%= e.days_left !== null ? e.days_left + ' days left' : 'Active' %>
                        </span>
                      <% } %>
                      <span class="text-muted" style="font-size: 0.68rem;">(<%= e.plan_type || 'Subscription' %>)</span>
                    </div>
                  </div>

                  <!-- Right: Progress & Actions -->
                  <div class="d-flex align-items-center gap-2.5 ms-auto flex-wrap">
                    <!-- Progress Bar -->
                    <div style="width: 80px;">
                      <div class="progress" style="height: 5px; border-radius: 6px;">
                        <div class="progress-bar <%= e.progress_percent >= 100 ? 'bg-success' : 'bg-primary' %>" style="width: <%= e.progress_percent %>%"></div>
                      </div>
                      <div class="text-muted text-center fw-bold mt-1" style="font-size: 0.68rem;"><%= e.progress_percent %>%</div>
                    </div>

                    <!-- SMS Reminder Button -->
                    <button type="button" 
                            class="btn btn-sm <%= e.is_expiring_soon ? 'btn-danger' : 'btn-outline-danger' %> rounded-pill px-2.5 py-1 fw-bold d-inline-flex align-items-center gap-1 shadow-2xs" 
                            style="font-size: 0.75rem;"
                            onclick="openSmsModal('<%= e.course_id %>', '<%= e.title.replace(/'/g, '\\\'') %>', '<%= e.category_name || 'Subject' %>', '<%= untilDateStr %>', '<%= e.days_left %>')" 
                            title="Send SMS Reminder">
                      <i class="ri-message-3-line"></i> SMS Reminder
                    </button>

                    <!-- Extend Access Dropdown -->
                    <div class="dropdown d-inline">
                      <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 font-weight-bold dropdown-toggle shadow-2xs" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.75rem;">
                        Extend
                      </button>
                      <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                        <li><h6 class="dropdown-header small text-uppercase">Extend Validity</h6></li>
                        <li>
                          <form action="/admin/users/<%= profileUser.id %>/extend-enrollment" method="POST">
                            <input type="hidden" name="course_id" value="<%= e.course_id %>">
                            <input type="hidden" name="days" value="30">
                            <button type="submit" class="dropdown-item small py-1.5"><i class="ri-add-line text-success me-1"></i> +30 Days (1 Month)</button>
                          </form>
                        </li>
                        <li>
                          <form action="/admin/users/<%= profileUser.id %>/extend-enrollment" method="POST">
                            <input type="hidden" name="course_id" value="<%= e.course_id %>">
                            <input type="hidden" name="days" value="90">
                            <button type="submit" class="dropdown-item small py-1.5"><i class="ri-add-line text-primary me-1"></i> +90 Days (1 Semester)</button>
                          </form>
                        </li>
                        <li>
                          <form action="/admin/users/<%= profileUser.id %>/extend-enrollment" method="POST">
                            <input type="hidden" name="course_id" value="<%= e.course_id %>">
                            <input type="hidden" name="days" value="365">
                            <button type="submit" class="dropdown-item small py-1.5"><i class="ri-add-line text-info me-1"></i> +365 Days (1 Year)</button>
                          </form>
                        </li>
                      </ul>
                    </div>
                  </div>

                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } else if (profileUser.role === 'instructor') { %>
      <!-- Instructor Courses View -->
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
              <i class="ri-presentation-line text-info"></i> Courses Instructed by <%= profileUser.name %>
            </h5>
            <p class="text-muted small mb-0"><%= courses.length %> published course<%= courses.length !== 1 ? 's' : '' %> total</p>
          </div>
        </div>

        <% if (courses.length === 0) { %>
          <div class="text-center py-5 text-muted">
            <i class="ri-folder-2-line display-4 text-muted opacity-40 mb-2 d-block"></i>
            <h6 class="fw-bold text-dark">This instructor hasn't created any courses yet.</h6>
          </div>
        <% } %>

        <div class="accordion" id="instructorCourses">
          <% courses.forEach((c, ci) => { %>
            <div class="card border rounded-3 mb-2 overflow-hidden">
              <div class="card-header bg-light-subtle d-flex align-items-center justify-content-between p-3">
                <div>
                  <div class="fw-bold text-dark"><%= c.title %> <span class="badge bg-info-subtle text-info text-capitalize ms-1"><%= c.status %></span></div>
                  <div class="text-muted small" style="font-size:.78rem;">
                    <%= c.category_name || 'General Subject' %> · <%= c.modules.length %> modules · <%= c.lessonCount %> lessons · <%= c.students_count %> students
                  </div>
                </div>
                <a href="/subjects/<%= c.slug || '' %>" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                  View Course <i class="ri-external-link-line"></i>
                </a>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } else { %>
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <h6 class="mb-2"><i class="ri-shield-star-line me-2 text-primary"></i>Administrator Account</h6>
        <p class="text-muted small mb-0">Admins manage the platform curriculum, settings, and users.</p>
      </div>
    <% } %>
  </div>
</div>

