<!-- ============ SMS EXPIRY REMINDER MODAL ============ -->
<div class="modal fade" id="smsReminderModal" tabindex="-1" aria-labelledby="smsReminderModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
      <div class="modal-header text-white p-3.5" style="background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);">
        <div class="d-flex align-items-center gap-2">
          <i class="ri-message-3-fill fs-5"></i>
          <h6 class="modal-title fw-bold mb-0" id="smsReminderModalLabel">Send Student SMS Reminder</h6>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      
      <form action="/admin/users/<%= profileUser.id %>/send-sms-reminder" method="POST" id="smsReminderForm">
        <input type="hidden" name="course_id" id="smsCourseId" value="">
        <div class="modal-body p-4">
          <!-- Student & Phone Details -->
          <div class="bg-light p-3 rounded-3 border mb-3">
            <div class="d-flex align-items-center justify-content-between mb-1">
              <span class="text-muted small">Student Name:</span>
              <span class="fw-bold text-dark"><%= profileUser.name %></span>
            </div>
            <div class="d-flex align-items-center justify-content-between">
              <span class="text-muted small">Recipient Mobile:</span>
              <span class="badge bg-success-subtle text-success border border-success-subtle font-weight-bold px-2.5 py-1 rounded-pill">
                <i class="ri-phone-line me-1"></i> <%= profileUser.phone || '+91 9111111101' %>
              </span>
            </div>
          </div>

          <!-- Target Course Box -->
          <div class="mb-3" id="modalCourseTargetWrap">
            <label class="form-label small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">Target Course & Expiry</label>
            <div class="p-2.5 bg-light-subtle rounded-3 border">
              <div class="fw-bold text-dark" id="modalCourseTitle">General Student Notification</div>
              <div class="small text-danger mt-0.5" id="modalExpiryText">Subscription Expiry Alert</div>
            </div>
          </div>

          <!-- SMS Message Text -->
          <div class="mb-3">
            <label class="form-label small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">SMS Message Preview</label>
            <textarea name="custom_message" id="smsMessageContent" class="form-control rounded-3 border font-monospace small" rows="4" style="line-height: 1.4;"></textarea>
            <div class="d-flex justify-content-between text-muted small mt-1" style="font-size: 0.72rem;">
              <span><i class="ri-information-line"></i> DLT-compliant SMS dispatched to registered mobile</span>
              <span id="smsCharCount">142 chars</span>
            </div>
          </div>
        </div>

        <div class="modal-footer bg-light p-3 justify-content-between border-top">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm d-inline-flex align-items-center gap-1.5" style="background: #dc2626; border: none;">
            <i class="ri-send-plane-fill"></i> Send SMS Reminder Now
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function toggleDetailPw() {
    const el = document.getElementById('detailUserPwVal');
    const eye = document.getElementById('detailPwEye');
    if (!el || !eye) return;
    const isHidden = el.getAttribute('data-hidden') === 'true';
    const plain = el.getAttribute('data-plain') || '';
    if (isHidden) {
      el.innerText = plain;
      el.setAttribute('data-hidden', 'false');
      eye.className = 'ri-eye-off-line';
    } else {
      el.innerText = '••••••••';
      el.setAttribute('data-hidden', 'true');
      eye.className = 'ri-eye-line';
    }
  }

  function copyDetailPw() {
    const el = document.getElementById('detailUserPwVal');
    const btn = document.getElementById('detailCopyBtn');
    if (!el || !btn) return;
    const plain = el.getAttribute('data-plain') || '';
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(plain);
    }
    const orig = btn.innerHTML;
    btn.innerHTML = '<i class="ri-check-line text-success"></i>';
    setTimeout(() => { btn.innerHTML = orig; }, 1500);
  }

  function openSmsModal(courseId, courseTitle, subjectName, expiryDate, daysLeft) {
    document.getElementById('smsCourseId').value = courseId || '';
    
    if (courseTitle) {
      document.getElementById('modalCourseTitle').innerText = courseTitle + (subjectName ? ' (' + subjectName + ')' : '');
      let expiryLabel = 'Expiring on ' + expiryDate;
      if (daysLeft !== 'null' && daysLeft !== '') {
        const dNum = Number(daysLeft);
        if (dNum <= 0) {
          expiryLabel += ' (Expired)';
        } else {
          expiryLabel += ' (in ' + dNum + ' day' + (dNum !== 1 ? 's' : '') + ')';
        }
      }
      document.getElementById('modalExpiryText').innerText = expiryLabel;
    } else {
      document.getElementById('modalCourseTitle').innerText = 'PhysioEdvance Curriculum Notice';
      document.getElementById('modalExpiryText').innerText = 'General Student Notification';
    }

    const studentName = '<%= profileUser.name %>';
    let defaultMsg = '';
    if (courseTitle) {
      const daysMsg = (daysLeft && Number(daysLeft) > 0) ? `in ${daysLeft} days` : 'soon';
      defaultMsg = `PhysioEdvance Reminder: Dear ${studentName}, your access for "${courseTitle}" (${subjectName}) is expiring on ${expiryDate} (${daysMsg}). Renew now at physioadvance.com to keep your video lectures and notes active.`;
    } else {
      defaultMsg = `PhysioEdvance: Dear ${studentName}, please check your registered courses and updates on physioadvance.com.`;
    }
    
    const msgBox = document.getElementById('smsMessageContent');
    msgBox.value = defaultMsg;
    updateCharCount();

    msgBox.oninput = updateCharCount;

    const modalEl = document.getElementById('smsReminderModal');
    if (window.bootstrap && bootstrap.Modal) {
      bootstrap.Modal.getOrCreateInstance(modalEl).show();
    } else {
      modalEl.classList.add('show');
      modalEl.style.display = 'block';
    }
  }

  function updateCharCount() {
    const msgBox = document.getElementById('smsMessageContent');
    const countEl = document.getElementById('smsCharCount');
    if (msgBox && countEl) {
      countEl.innerText = msgBox.value.length + ' chars';
    }
  }

  function handleEditRoleChange(role) {
    const qual = document.getElementById('editLblQualification');
    const head = document.getElementById('editLblHeadline');
    const qualInput = document.getElementById('editInputQualification');
    const headInput = document.getElementById('editInputHeadline');

    document.querySelectorAll('.pe-edit-role-card').forEach(card => card.classList.remove('active'));
    const activeRadio = document.querySelector(`input[name="role"][value="${role}"]#editRole_${role}`);
    if (activeRadio) {
      activeRadio.checked = true;
      const parentLabel = activeRadio.closest('.pe-edit-role-card');
      if (parentLabel) parentLabel.classList.add('active');
    }

    if (role === 'student') {
      if (qual) qual.innerText = 'Degree / Year (e.g. BPT 1st Year)';
      if (head) head.innerText = 'College / Institution';
      if (qualInput) qualInput.placeholder = 'e.g. BPT 1st Year, 2nd Year';
      if (headInput) headInput.placeholder = 'e.g. Apex Institute of Physiotherapy';
    } else if (role === 'intern') {
      if (qual) qual.innerText = 'Internship Hospital / Center';
      if (head) head.innerText = 'Clinical Rotation / Department';
      if (qualInput) qualInput.placeholder = 'e.g. AIIMS Orthopedic & Neuro Department';
      if (headInput) headInput.placeholder = 'e.g. 6-Month Compulsory Rotatory Intern';
    } else if (role === 'clinician') {
      if (qual) qual.innerText = 'Clinical Qualifications (e.g. BPT, MPT, MIAP)';
      if (head) head.innerText = 'Clinic / Hospital Name & Specialty';
      if (qualInput) qualInput.placeholder = 'e.g. MPT (Musculoskeletal), MIAP';
      if (headInput) headInput.placeholder = 'e.g. Consultant PT at Care Hospital';
    } else if (role === 'educator') {
      if (qual) qual.innerText = 'Academic Credentials / Faculty Title';
      if (head) head.innerText = 'University / Department';
      if (qualInput) qualInput.placeholder = 'e.g. Associate Professor, MPT, PhD';
      if (headInput) headInput.placeholder = 'e.g. Dept. of Physiotherapy, Metro University';
    } else if (role === 'researcher') {
      if (qual) qual.innerText = 'Research Focus / Fellowship';
      if (head) head.innerText = 'Research Lab / Institution';
      if (qualInput) qualInput.placeholder = 'e.g. Biomechanics & Gait Analysis Research';
      if (headInput) headInput.placeholder = 'e.g. National Center for Health Research';
    } else if (role === 'instructor') {
      if (qual) qual.innerText = 'Teaching Credentials (e.g. MPT, PhD)';
      if (head) head.innerText = 'Designation / Specialization';
      if (qualInput) qualInput.placeholder = 'e.g. MPT (Neuro), Certified Master Trainer';
      if (headInput) headInput.placeholder = 'e.g. Senior Lecturer & Course Author';
    } else {
      if (qual) qual.innerText = 'Department / Title';
      if (head) head.innerText = 'Administrative Scope';
      if (qualInput) qualInput.placeholder = 'e.g. Platform Operations Lead';
      if (headInput) headInput.placeholder = 'e.g. Full Platform & System Superadmin';
    }
  }

  function openEditUserModal(u) {
    if (!u) return;
    const form = document.getElementById('editUserForm');
    if (form) {
      form.action = '/admin/users/' + u.id + '/edit';
    }
    
    document.getElementById('editUserId').value = u.id || '';
    document.getElementById('editUserName').value = u.name || '';
    document.getElementById('editUserEmail').value = u.email || '';
    document.getElementById('editUserCode').value = u.user_code || '';
    document.getElementById('editUserPhone').value = u.phone || '';
    document.getElementById('editUserPassword').value = '';
    document.getElementById('editInputQualification').value = u.qualification || '';
    document.getElementById('editInputHeadline').value = u.headline || '';
    document.getElementById('editUserBio').value = u.bio || '';
    
    const activeCheck = document.getElementById('editUserIsActive');
    if (activeCheck) {
      activeCheck.checked = (u.is_active === 1 || u.is_active === true || u.is_active === '1');
    }

    const currentRole = (u.role === 'academic_educator' || u.role === 'academic_mission') ? 'educator' : (u.role || 'student');
    handleEditRoleChange(currentRole);

    const modalEl = document.getElementById('editUserModal');
    if (modalEl) {
      if (modalEl.parentElement !== document.body) {
        document.body.appendChild(modalEl);
      }
      if (window.bootstrap && bootstrap.Modal) {
        const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
        bsModal.show();
      } else {
        modalEl.classList.add('show');
        modalEl.style.display = 'block';
      }
    }
  }

  function generateEditPassword() {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789@#$';
    let pw = '';
    pw += 'ABCDEFGHJKLMNPQRSTUVWXYZ'[(Math.random() * 24) | 0];
    pw += 'abcdefghijkmnopqrstuvwxyz'[(Math.random() * 24) | 0];
    pw += '23456789'[(Math.random() * 8) | 0];
    pw += '@#$'[(Math.random() * 3) | 0];
    for (let i = 0; i < 4; i++) {
      pw += chars[(Math.random() * chars.length) | 0];
    }
    const input = document.getElementById('editUserPassword');
    if (input) {
      input.value = pw;
      input.type = 'text';
    }
  }

  function toggleEditModalPwVisibility() {
    const input = document.getElementById('editUserPassword');
    const eye = document.getElementById('editModalPwEye');
    if (!input || !eye) return;
    if (input.type === 'password') {
      input.type = 'text';
      eye.className = 'ri-eye-off-line';
    } else {
      input.type = 'password';
      eye.className = 'ri-eye-line';
    }
  }
</script>

<!-- ============ EDIT USER MODAL ============ -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
      <div class="modal-header text-white p-3.5" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);">
        <div class="d-flex align-items-center gap-2.5">
          <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center shadow-xs" style="width: 36px; height: 36px;">
            <i class="ri-edit-line fs-5"></i>
          </div>
          <div>
            <h6 class="modal-title fw-bold mb-0 text-white" id="editUserModalLabel">Edit User Account & Privileges</h6>
            <span class="small text-white-50" style="font-size: 0.75rem;">Modify credentials, role classification, institutional ID, and profile details</span>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form action="" method="POST" id="editUserForm">
        <input type="hidden" name="id" id="editUserId">

        <div class="modal-body p-4">
          <!-- Role Selection Cards -->
          <div class="mb-4">
            <label class="form-label small fw-bold text-uppercase text-secondary mb-2" style="letter-spacing: 0.5px;">1. Change Account Role</label>
            <div class="row g-2">
              <div class="col-6 col-md-4 col-xl-3">
                <label class="pe-role-option-card pe-edit-role-card d-block p-2.5 rounded-3 text-center h-100 position-relative" onclick="handleEditRoleChange('student')">
                  <input type="radio" name="role" value="student" class="btn-check" id="editRole_student">
                  <div class="pe-role-box">
                    <div class="pe-role-icon text-primary bg-primary-subtle mx-auto mb-1.5 rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-size: 1.1rem;">
                      <i class="ri-graduation-cap-line"></i>
                    </div>
                    <div class="fw-bold text-dark mb-0.5" style="font-size: 0.82rem;">Student</div>
                    <div class="text-muted" style="font-size: 0.68rem;">Learner member</div>
                  </div>
                </label>
              </div>

              <div class="col-6 col-md-4 col-xl-3">
                <label class="pe-role-option-card pe-edit-role-card d-block p-2.5 rounded-3 text-center h-100 position-relative" onclick="handleEditRoleChange('intern')">
                  <input type="radio" name="role" value="intern" class="btn-check" id="editRole_intern">
                  <div class="pe-role-box">
                    <div class="pe-role-icon text-warning-emphasis bg-warning-subtle mx-auto mb-1.5 rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-size: 1.1rem;">
                      <i class="ri-stethoscope-line"></i>
                    </div>
                    <div class="fw-bold text-dark mb-0.5" style="font-size: 0.82rem;">Intern</div>
                    <div class="text-muted" style="font-size: 0.68rem;">Clinical resident</div>
                  </div>
                </label>
              </div>

              <div class="col-6 col-md-4 col-xl-3">
                <label class="pe-role-option-card pe-edit-role-card d-block p-2.5 rounded-3 text-center h-100 position-relative" onclick="handleEditRoleChange('clinician')">
                  <input type="radio" name="role" value="clinician" class="btn-check" id="editRole_clinician">
                  <div class="pe-role-box">
                    <div class="pe-role-icon text-success bg-success-subtle mx-auto mb-1.5 rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-size: 1.1rem;">
                      <i class="ri-hospital-line"></i>
                    </div>
                    <div class="fw-bold text-dark mb-0.5" style="font-size: 0.82rem;">Clinician</div>
                    <div class="text-muted" style="font-size: 0.68rem;">Practitioner</div>
                  </div>
                </label>
              </div>

              <div class="col-6 col-md-4 col-xl-3">
                <label class="pe-role-option-card pe-edit-role-card d-block p-2.5 rounded-3 text-center h-100 position-relative" onclick="handleEditRoleChange('educator')">
                  <input type="radio" name="role" value="educator" class="btn-check" id="editRole_educator">
                  <div class="pe-role-box">
                    <div class="pe-role-icon text-info bg-info-subtle mx-auto mb-1.5 rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-size: 1.1rem;">
                      <i class="ri-book-read-line"></i>
                    </div>
                    <div class="fw-bold text-dark mb-0.5" style="font-size: 0.82rem;">Educator</div>
                    <div class="text-muted" style="font-size: 0.68rem;">Academic faculty</div>
                  </div>
                </label>
              </div>

              <div class="col-6 col-md-4 col-xl-4">
                <label class="pe-role-option-card pe-edit-role-card d-block p-2.5 rounded-3 text-center h-100 position-relative" onclick="handleEditRoleChange('researcher')">
                  <input type="radio" name="role" value="researcher" class="btn-check" id="editRole_researcher">
                  <div class="pe-role-box">
                    <div class="pe-role-icon text-teal bg-teal-subtle mx-auto mb-1.5 rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-size: 1.1rem;">
                      <i class="ri-microscope-line"></i>
                    </div>
                    <div class="fw-bold text-dark mb-0.5" style="font-size: 0.82rem;">Researcher</div>
                    <div class="text-muted" style="font-size: 0.68rem;">Research scholar</div>
                  </div>
                </label>
              </div>

              <div class="col-6 col-md-4 col-xl-4">
                <label class="pe-role-option-card pe-edit-role-card d-block p-2.5 rounded-3 text-center h-100 position-relative" onclick="handleEditRoleChange('instructor')">
                  <input type="radio" name="role" value="instructor" class="btn-check" id="editRole_instructor">
                  <div class="pe-role-box">
                    <div class="pe-role-icon text-indigo bg-indigo-subtle mx-auto mb-1.5 rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-size: 1.1rem;">
                      <i class="ri-presentation-line"></i>
                    </div>
                    <div class="fw-bold text-dark mb-0.5" style="font-size: 0.82rem;">Instructor</div>
                    <div class="text-muted" style="font-size: 0.68rem;">Course author</div>
                  </div>
                </label>
              </div>

              <div class="col-12 col-md-4 col-xl-4">
                <label class="pe-role-option-card pe-edit-role-card d-block p-2.5 rounded-3 text-center h-100 position-relative" onclick="handleEditRoleChange('admin')">
                  <input type="radio" name="role" value="admin" class="btn-check" id="editRole_admin">
                  <div class="pe-role-box">
                    <div class="pe-role-icon text-purple bg-purple-subtle mx-auto mb-1.5 rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-size: 1.1rem;">
                      <i class="ri-shield-star-line"></i>
                    </div>
                    <div class="fw-bold text-dark mb-0.5" style="font-size: 0.82rem;">Administrator</div>
                    <div class="text-muted" style="font-size: 0.68rem;">Super admin</div>
                  </div>
                </label>
              </div>
            </div>
          </div>

          <!-- Basic Info -->
          <div class="mb-3">
            <label class="form-label small fw-bold text-uppercase text-secondary mb-2" style="letter-spacing: 0.5px;">2. Account Credentials & Status</label>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-dark">Full Name <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-user-line"></i></span>
                  <input type="text" name="name" id="editUserName" class="form-control border-start-0 ps-0" placeholder="e.g. Dr. Aryan Sharma" required>
                </div>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-dark">Email Address <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-mail-line"></i></span>
                  <input type="email" name="email" id="editUserEmail" class="form-control border-start-0 ps-0" placeholder="e.g. aryan@physioedvance.com" required>
                </div>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-dark">Institutional / Custom User ID</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-fingerprint-line"></i></span>
                  <input type="text" name="user_code" id="editUserCode" class="form-control border-start-0 ps-0 font-monospace" placeholder="e.g. PE-STU-0011">
                </div>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-dark">Mobile / Phone (for SMS Reminders)</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-phone-line"></i></span>
                  <input type="tel" name="phone" id="editUserPhone" class="form-control border-start-0 ps-0" placeholder="+91 9876543210">
                </div>
              </div>

              <div class="col-md-6">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label class="form-label small fw-semibold text-dark mb-0">Reset Password <span class="badge bg-light text-muted border font-monospace" style="font-size:0.68rem;">Leave blank to keep unchanged</span></label>
                  <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small text-primary fw-bold" onclick="generateEditPassword()" style="font-size: 0.75rem;">
                    <i class="ri-magic-line"></i> Auto Generate
                  </button>
                </div>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-lock-2-line"></i></span>
                  <input type="password" name="password" id="editUserPassword" class="form-control border-start-0 border-end-0 px-2 font-monospace" placeholder="Enter new password to change">
                  <button type="button" class="btn btn-outline-secondary border-start-0" onclick="toggleEditModalPwVisibility()" title="Toggle visibility">
                    <i class="ri-eye-line" id="editModalPwEye"></i>
                  </button>
                </div>
              </div>

              <div class="col-md-6 d-flex align-items-end">
                <div class="p-2.5 bg-light rounded-3 border w-100 d-flex align-items-center justify-content-between">
                  <div>
                    <label class="form-check-label fw-bold text-dark small d-block" for="editUserIsActive">Account Active Status</label>
                    <span class="text-muted" style="font-size:0.7rem;">Active accounts can log in to the portal</span>
                  </div>
                  <div class="form-check form-switch mb-0 fs-5">
                    <input class="form-check-input" type="checkbox" role="switch" name="is_active" value="1" id="editUserIsActive" checked>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Role-specific Profile Fields -->
          <div class="mb-2">
            <label class="form-label small fw-bold text-uppercase text-secondary mb-2" style="letter-spacing: 0.5px;">3. Profile & Academic Details</label>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-dark" id="editLblQualification">Degree / Year</label>
                <input type="text" name="qualification" id="editInputQualification" class="form-control" placeholder="e.g. BPT 1st Year, 2nd Year">
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-dark" id="editLblHeadline">College / Institution</label>
                <input type="text" name="headline" id="editInputHeadline" class="form-control" placeholder="e.g. Apex Institute of Physiotherapy">
              </div>

              <div class="col-12">
                <label class="form-label small fw-semibold text-dark">Bio / Staff Notes</label>
                <textarea name="bio" id="editUserBio" class="form-control" rows="2" placeholder="Brief background or notes..."></textarea>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer bg-light p-3 justify-content-between border-top">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-3.5" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2 hover-lift" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); border: none;">
            <i class="ri-save-line fs-5"></i> Save User Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
