<%
  const activeEnrollments = (enrollments || []).filter(e => !e.is_expired);
  const expiringSoonCount = (enrollments || []).filter(e => e.is_expiring_soon).length;
  const avgProgress = enrollments && enrollments.length > 0 
    ? Math.round(enrollments.reduce((sum, e) => sum + (Number(e.progress_percent) || 0), 0) / enrollments.length) 
    : 0;
  const courseList = allCourses || [];

  function getRoleInfo(role) {
    const r = (role || 'student').toLowerCase().trim();
    if (r === 'admin') {
      return { cls: 'pe-role-admin', icon: 'ri-shield-star-line', label: 'Admin' };
    } else if (r === 'instructor') {
      return { cls: 'pe-role-instructor', icon: 'ri-presentation-line', label: 'Instructor' };
    } else if (r === 'intern') {
      return { cls: 'pe-role-intern', icon: 'ri-stethoscope-line', label: 'Intern' };
    } else if (r === 'clinician') {
      return { cls: 'pe-role-clinician', icon: 'ri-hospital-line', label: 'Clinician' };
    } else if (r === 'educator' || r === 'academic_educator' || r === 'academic_mission') {
      return { cls: 'pe-role-educator', icon: 'ri-book-read-line', label: 'Educator' };
    } else if (r === 'researcher') {
      return { cls: 'pe-role-researcher', icon: 'ri-microscope-line', label: 'Researcher' };
    } else {
      return { cls: 'pe-role-student', icon: 'ri-graduation-cap-line', label: 'Student' };
    }
  }
%>

