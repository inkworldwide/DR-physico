<!-- ============ EXECUTIVE HEADER BANNER ============ -->
<div class="card border-0 rounded-4 shadow-sm text-white mb-4 overflow-hidden position-relative" style="background: linear-gradient(135deg, #0865c3 0%, #0284c7 60%, #0369a1 100%);">
  <div class="position-absolute end-0 bottom-0 opacity-10 pe-none me-4 mb-2">
    <i class="ri-heart-pulse-fill" style="font-size: 11rem; color: #ffffff;"></i>
  </div>
  <div class="card-body p-4 p-lg-4 position-relative z-1">
    <div class="row align-items-center g-3">
      <div class="col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
          <% if (isSuperAdmin) { %>
            <span class="badge px-3 py-1.5 rounded-pill shadow-sm" style="background: #fef08a; color: #854d0e; font-weight: 700; font-size:0.75rem;">
              <i class="ri-vip-crown-fill me-1" style="color: #ca8a04;"></i> Super Admin Master Authority
            </span>
          <% } else { %>
            <span class="badge px-3 py-1.5 rounded-pill" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(8px); color: #ffffff; font-weight: 600; font-size:0.75rem;">
              <i class="ri-shield-user-fill me-1"></i> Administrator
            </span>
          <% } %>
          <span class="badge px-3 py-1.5 rounded-pill" style="background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); color: #ffffff; font-size:0.75rem; font-weight: 500;">
            <i class="ri-checkbox-circle-fill text-success me-1"></i> System Online
          </span>
        </div>
        <h3 class="fw-bold text-white mb-1" style="font-size: 1.65rem; letter-spacing: -0.02em;">Welcome back, <%= currentUser.name.split(' ')[0] %> 👋</h3>
        <p class="text-white-75 mb-0" style="max-width: 600px; font-size: 0.92rem; opacity: 0.9;">
          Here is your real-time academic overview, platform performance metrics, and quick control panel for PhysioEdvance.
        </p>
      </div>
      <div class="col-lg-5 text-lg-end">
        <div class="d-flex gap-2 justify-content-lg-end flex-wrap">
          <% if (isSuperAdmin) { %>
            <a href="/admin/admins" class="btn btn-light rounded-pill px-3.5 py-2 font-weight-bold shadow-sm" style="color: #0865c3; font-weight: 700;">
              <i class="ri-admin-line me-1" style="color: #0865c3;"></i> Manage Admins
            </a>
            <a href="/admin/audit-logs" class="btn btn-outline-light rounded-pill px-3.5 py-2 font-weight-semibold" style="backdrop-filter: blur(4px);">
              <i class="ri-shield-check-line me-1"></i> Audit Logs
            </a>
          <% } else { %>
            <% if (hasPermission('SUBJECT', 'VIEW')) { %>
              <a href="/admin/categories" class="btn btn-light rounded-pill px-3.5 py-2 font-weight-bold shadow-sm" style="color: #0865c3; font-weight: 700;">
                <i class="ri-folder-2-line me-1" style="color: #0865c3;"></i> Manage Subjects
              </a>
            <% } %>
            <% if (hasPermission('LIVE_CLASS', 'CREATE')) { %>
              <a href="/admin/live-sessions" class="btn btn-outline-light rounded-pill px-3.5 py-2 font-weight-semibold" style="backdrop-filter: blur(4px);">
                <i class="ri-video-add-line me-1"></i> Schedule Class
              </a>
            <% } %>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ============ RESPONSIVE KPI STAT CARDS GRID ============ -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-4 g-3 g-xl-4 mb-4">
  <!-- 1. Published Courses -->
  <div class="col">
    <div class="pe-kpi-card rounded-4 p-3.5 bg-white border border-light-subtle shadow-sm h-100 transition-all position-relative overflow-hidden" style="border-top: 4px solid #0865c3 !important;">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="pe-kpi-icon m-0" style="background: rgba(8, 101, 195, 0.1); color: #0865c3; border-radius: 12px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
          <i class="ri-book-2-line"></i>
        </div>
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 small fw-bold">Published</span>
      </div>
      <div class="pe-kpi-value mb-1 text-dark" style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em;"><%= stats.totalCourses %></div>
      <div class="pe-kpi-label text-muted small fw-semibold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em;">Active BPT Courses</div>
    </div>
  </div>

  <!-- 2. Total Students -->
  <div class="col">
    <div class="pe-kpi-card rounded-4 p-3.5 bg-white border border-light-subtle shadow-sm h-100 transition-all position-relative overflow-hidden" style="border-top: 4px solid #10b981 !important;">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="pe-kpi-icon m-0" style="background: rgba(16, 185, 129, 0.1); color: #10b981; border-radius: 12px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
          <i class="ri-group-line"></i>
        </div>
        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1 small fw-bold">Students</span>
      </div>
      <div class="pe-kpi-value mb-1 text-dark" style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em;"><%= stats.totalStudents %></div>
      <div class="pe-kpi-label text-muted small fw-semibold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em;">Registered Learners</div>
    </div>
  </div>

  <!-- 3. Total Instructors -->
  <div class="col">
    <div class="pe-kpi-card rounded-4 p-3.5 bg-white border border-light-subtle shadow-sm h-100 transition-all position-relative overflow-hidden" style="border-top: 4px solid #0284c7 !important;">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="pe-kpi-icon m-0" style="background: rgba(2, 132, 199, 0.1); color: #0284c7; border-radius: 12px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
          <i class="ri-user-star-line"></i>
        </div>
        <span class="badge bg-info-subtle text-info rounded-pill px-3 py-1 small fw-bold">Faculty</span>
      </div>
      <div class="pe-kpi-value mb-1 text-dark" style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em;"><%= stats.totalInstructors %></div>
      <div class="pe-kpi-label text-muted small fw-semibold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em;">Faculty Instructors</div>
    </div>
  </div>

  <!-- 4. Total Revenue -->
  <div class="col">
    <div class="pe-kpi-card rounded-4 p-3.5 bg-white border border-light-subtle shadow-sm h-100 transition-all position-relative overflow-hidden" style="border-top: 4px solid #f59e0b !important;">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="pe-kpi-icon m-0" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b; border-radius: 12px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
          <i class="ri-money-rupee-circle-line"></i>
        </div>
        <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-1 small fw-bold">Revenue</span>
      </div>
      <div class="pe-kpi-value mb-1 text-dark" style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em;">₹<%= totalRevenue.toLocaleString() %></div>
      <div class="pe-kpi-label text-muted small fw-semibold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em;">Total Revenue Generated</div>
    </div>
  </div>

  <!-- 5. Total Subjects -->
  <div class="col">
    <div class="pe-kpi-card rounded-4 p-3.5 bg-white border border-light-subtle shadow-sm h-100 transition-all position-relative overflow-hidden" style="border-top: 4px solid #8b5cf6 !important;">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="pe-kpi-icon m-0" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6; border-radius: 12px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
          <i class="ri-folders-line"></i>
        </div>
        <span class="badge rounded-pill px-3 py-1 small fw-bold" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6;">Subjects</span>
      </div>
      <div class="pe-kpi-value mb-1 text-dark" style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em;"><%= totalSubjects %></div>
      <div class="pe-kpi-label text-muted small fw-semibold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em;">Curriculum Subjects</div>
    </div>
  </div>

  <!-- 6. Live Classes -->
  <div class="col">
    <div class="pe-kpi-card rounded-4 p-3.5 bg-white border border-light-subtle shadow-sm h-100 transition-all position-relative overflow-hidden" style="border-top: 4px solid #ef4444 !important;">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="pe-kpi-icon m-0" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; border-radius: 12px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
          <i class="ri-live-line"></i>
        </div>
        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1 small fw-bold">Live</span>
      </div>
      <div class="pe-kpi-value mb-1 text-dark" style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em;"><%= totalLiveClasses %></div>
      <div class="pe-kpi-label text-muted small fw-semibold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em;">Live Sessions & Workshops</div>
    </div>
  </div>

  <!-- 7. Total Enrollments -->
  <div class="col">
    <div class="pe-kpi-card rounded-4 p-3.5 bg-white border border-light-subtle shadow-sm h-100 transition-all position-relative overflow-hidden" style="border-top: 4px solid #10b981 !important;">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="pe-kpi-icon m-0" style="background: rgba(16, 185, 129, 0.1); color: #10b981; border-radius: 12px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
          <i class="ri-user-add-line"></i>
        </div>
        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1 small fw-bold">Enrollments</span>
      </div>
      <div class="pe-kpi-value mb-1 text-dark" style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em;"><%= stats.totalEnrollments %></div>
      <div class="pe-kpi-label text-muted small fw-semibold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em;">Course Enrollments</div>
    </div>
  </div>

  <!-- 8. Responsive Quick Actions -->
  <div class="col">
    <div class="pe-kpi-card rounded-4 p-3.5 bg-white border border-light-subtle shadow-sm h-100 transition-all d-flex flex-column justify-content-between position-relative overflow-hidden" style="border-top: 4px solid #0865c3 !important;">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <div class="pe-kpi-icon m-0" style="background: rgba(8, 101, 195, 0.1); color: #0865c3; border-radius: 12px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
          <i class="ri-flashlight-fill text-warning"></i>
        </div>
        <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1 small fw-bold">Shortcuts</span>
      </div>
      <div class="fw-bold text-dark mb-2" style="font-size:0.9rem;">Quick Navigation</div>
      <div class="d-flex flex-wrap gap-1.5 mt-auto">
        <a href="/admin/courses" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-1 fw-semibold text-nowrap" style="font-size:0.75rem; border-color: #0865c3; color: #0865c3;">
          <i class="ri-book-open-line me-1"></i> Courses
        </a>
        <a href="/admin/users" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-1 fw-semibold text-nowrap" style="font-size:0.75rem; border-color: #0865c3; color: #0865c3;">
          <i class="ri-user-line me-1"></i> Users
        </a>
        <a href="/admin/live-sessions" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-1 fw-semibold text-nowrap" style="font-size:0.75rem; border-color: #0865c3; color: #0865c3;">
          <i class="ri-video-chat-line me-1"></i> Live Class
        </a>
      </div>
    </div>
  </div>
</div>

<!-- ============ ANALYTICS CHARTS ROW ============ -->
<div class="row g-4 mb-4">
  <div class="col-12 col-xl-7">
    <div class="pe-admin-card p-4 rounded-4 shadow-sm border-0 bg-white">
      <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
        <h6 class="fw-bold text-dark mb-0"><i class="ri-line-chart-line me-2" style="color: #0865c3;"></i>Revenue Trend (Last 6 Months)</h6>
        <span class="badge rounded-pill px-3 py-1 font-weight-bold small" style="background: rgba(8, 101, 195, 0.1); color: #0865c3;">INR ₹</span>
      </div>
      <div class="chart-container" style="position: relative; height: 260px; width: 100%;">
        <canvas id="revenueChart"></canvas>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-5">
    <div class="pe-admin-card p-4 rounded-4 shadow-sm border-0 bg-white h-100">
      <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
        <h6 class="fw-bold text-dark mb-0"><i class="ri-pie-chart-line me-2" style="color: #0865c3;"></i>Enrollments by Category</h6>
        <span class="badge bg-light text-secondary border rounded-pill px-3 py-1 font-weight-bold small">Categories</span>
      </div>
      <div class="chart-container" style="position: relative; height: 260px; width: 100%;">
        <canvas id="categoryChart"></canvas>
      </div>
    </div>
  </div>
</div>

<!-- ============ RECENT ORDERS & ACTIVITY ROW ============ -->
<div class="row g-4">
  <div class="col-12 col-xl-7">
    <div class="pe-admin-card rounded-4 shadow-sm border-0 bg-white overflow-hidden mb-4">
      <div class="pe-admin-card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
        <h6 class="mb-0 fw-bold text-dark"><i class="ri-shopping-bag-3-line me-2" style="color: #0865c3;"></i>Recent Orders</h6>
        <a href="/admin/orders" class="small text-decoration-none fw-bold" style="color: #0865c3;">View All Orders <i class="ri-arrow-right-line"></i></a>
      </div>
      <div class="table-responsive">
        <table class="table pe-table align-middle mb-0">
          <thead>
            <tr>
              <th>Student</th>
              <th>Course</th>
              <th>Amount</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentOrders.length === 0) { %>
              <tr><td colspan="4" class="text-center text-muted py-4">No recent orders recorded yet.</td></tr>
            <% } %>
            <% recentOrders.forEach(o => { %>
              <tr>
                <td class="fw-semibold text-dark"><%= o.student_name %></td>
                <td><span class="text-muted small"><%= o.course_title %></span></td>
                <td class="fw-bold text-dark">₹<%= o.amount.toLocaleString() %></td>
                <td><span class="badge bg-success-subtle text-success font-weight-bold px-3 py-1 rounded-pill text-capitalize"><%= o.status %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="pe-admin-card rounded-4 shadow-sm border-0 bg-white overflow-hidden">
      <div class="pe-admin-card-header bg-white py-3 px-4 border-bottom">
        <h6 class="mb-0 fw-bold text-dark"><i class="ri-pulse-line me-2" style="color: #0865c3;"></i>Recent Activity Stream</h6>
      </div>
      <div class="p-4">
        <% if (recentActivity.length === 0) { %>
          <p class="text-muted small mb-0">No recent activity recorded.</p>
        <% } %>
        <% recentActivity.forEach(a => { %>
          <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom last-no-border">
            <div class="pe-activity-dot shadow-sm" style="width:38px; height:38px; min-width:38px; border-radius:50%; background:rgba(8,101,195,0.1); color:#0865c3; display:flex; align-items:center; justify-content:center;">
              <i class="ri-user-add-line"></i>
            </div>
            <div class="flex-grow-1">
              <div class="small fw-bold text-dark"><%= a.name %> <span class="text-muted font-weight-normal">joined as <%= a.role %></span></div>
              <div class="text-muted small" style="font-size:0.75rem;"><%= new Date(a.created_at).toLocaleString() %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-5">
    <div class="pe-admin-card rounded-4 shadow-sm border-0 bg-white overflow-hidden h-100">
      <div class="pe-admin-card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
        <h6 class="mb-0 fw-bold text-dark"><i class="ri-trophy-line me-2 text-warning"></i>Top Performing Courses</h6>
        <a href="/admin/courses" class="small text-decoration-none fw-bold" style="color: #0865c3;">All Courses <i class="ri-arrow-right-line"></i></a>
      </div>
      <div class="p-4">
        <% if (topCourses.length === 0) { %>
          <p class="text-muted small mb-0">No course data recorded.</p>
        <% } %>
        <% topCourses.forEach((c, idx) => { %>
          <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
            <div class="d-flex align-items-center gap-3">
              <div style="width: 28px; height: 28px; border-radius: 8px; background: <%= idx === 0 ? '#fef08a' : (idx === 1 ? '#e2e8f0' : '#fed7aa') %>; color: <%= idx === 0 ? '#854d0e' : (idx === 1 ? '#475569' : '#9a3412') %>; font-weight: 800; font-size: 0.75rem; display: flex; align-items: center; justify-content: center;">
                #<%= idx + 1 %>
              </div>
              <div>
                <div class="small fw-bold text-dark mb-0.5"><%= c.title %></div>
                <div class="text-muted small" style="font-size:0.78rem;">by <%= c.instructor_name %></div>
              </div>
            </div>
            <span class="badge rounded-pill px-3 py-1 shadow-sm font-weight-bold" style="font-size:0.75rem; background: rgba(8, 101, 195, 0.1); color: #0865c3;">
              <%= c.students_count %> learners
            </span>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const revenueData = <%- JSON.stringify(revenueByMonth) %>;
    const revCanvas = document.getElementById('revenueChart');
    if (revCanvas) {
      new Chart(revCanvas, {
        type: 'line',
        data: {
          labels: revenueData.map(r => r.month),
          datasets: [{
            label: 'Revenue (₹)',
            data: revenueData.map(r => r.total),
            borderColor: '#0a5dc2',
            backgroundColor: 'rgba(10,93,194,0.08)',
            fill: true,
            tension: 0.35,
            borderWidth: 3,
            pointRadius: 4,
            pointBackgroundColor: '#0a5dc2'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.04)' } },
            x: { grid: { display: false } }
          }
        }
      });
    }

    const categoryData = <%- JSON.stringify(enrollmentsByCategory) %>;
    const catCanvas = document.getElementById('categoryChart');
    if (catCanvas) {
      new Chart(catCanvas, {
        type: 'doughnut',
        data: {
          labels: categoryData.map(c => c.name),
          datasets: [{
            data: categoryData.map(c => c.count),
            backgroundColor: ['#0a5dc2','#0ea5e9','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899','#64748b']
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 11 } } }
          }
        }
      });
    }
  });
</script>
