<script>
  function updateEditIconPreview(iconClass) {
    const preview = document.getElementById('editIconPreview');
    if (preview) {
      preview.innerHTML = `<i class="${iconClass || 'ri-book-open-line'}"></i>`;
    }
  }

  function setEditIcon(iconClass) {
    const input = document.getElementById('editSubjectIcon');
    if (input) {
      input.value = iconClass;
      updateEditIconPreview(iconClass);
    }
  }

  function openEditSubjectModal(cat) {
    if (!cat) return;
    const form = document.getElementById('editSubjectForm');
    if (form) {
      form.action = '/admin/categories/' + cat.id + '/edit';
    }
    
    document.getElementById('editSubjectId').value = cat.id || '';
    document.getElementById('editSubjectName').value = cat.name || '';
    document.getElementById('editSubjectSlug').value = cat.slug || '';
    document.getElementById('editSubjectYear').value = cat.year ? String(cat.year) : '';
    document.getElementById('editSubjectIcon').value = cat.icon || 'ri-book-open-line';
    document.getElementById('editSubjectDescription').value = cat.description || '';
    updateEditIconPreview(cat.icon || 'ri-book-open-line');

    const modalEl = document.getElementById('editSubjectModal');
    if (modalEl) {
      if (modalEl.parentElement !== document.body) {
        document.body.appendChild(modalEl);
      }
      if (window.bootstrap && bootstrap.Modal) {
        const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
        bsModal.show();
      } else {
        modalEl.classList.add('show');
        modalEl.style.display = 'block';
      }
    }
  }

(function() {
  function initAddSubjectModal() {
    var modalEl = document.getElementById('addSubjectModal');
    var btn = document.getElementById('openAddSubjectBtn');
    if (!modalEl || !btn) return;

    if (modalEl.parentElement !== document.body) {
      document.body.appendChild(modalEl);
    }

    btn.onclick = function(e) {
      e.preventDefault();
      if (window.bootstrap && bootstrap.Modal) {
        try {
          var bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
          bsModal.show();
          return;
        } catch (err) {}
      }
      modalEl.classList.add('show');
      modalEl.style.display = 'block';
      modalEl.removeAttribute('aria-hidden');
      modalEl.setAttribute('aria-modal', 'true');
      if (!document.querySelector('.modal-backdrop')) {
        var bd = document.createElement('div');
        bd.className = 'modal-backdrop fade show';
        document.body.appendChild(bd);
      }
      document.body.classList.add('modal-open');
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAddSubjectModal);
  } else {
    initAddSubjectModal();
  }
})();
</script>

