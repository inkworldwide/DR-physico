<div class="pe-page-header mb-4">
  <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <a href="/admin/admins" class="text-decoration-none text-muted small fw-medium">
          <i class="ri-arrow-left-line me-1"></i>Back to Admins
        </a>
      </div>
      <h1 class="h3 fw-bold text-slate-900 mb-1">Create New Administrator</h1>
      <p class="text-muted small mb-0">Set up an administrator account and assign initial granular resource permissions.</p>
    </div>
  </div>
</div>

<form action="/admin/admins" method="POST" class="needs-validation" novalidate>
  <div class="row g-4">
    <!-- Left Column: Account Details -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 bg-white p-4 sticky-top" style="top: 20px; z-index: 10;">
        <h5 class="fw-bold text-slate-900 mb-3">Account Details</h5>
        
        <div class="mb-3">
          <label class="form-label text-slate-700 fw-semibold small">Full Name <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="ri-user-line text-muted"></i></span>
            <input type="text" name="name" class="form-control border-start-0" placeholder="e.g. Dr. Sarah Jenkins" required>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label text-slate-700 fw-semibold small">Email Address <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="ri-mail-line text-muted"></i></span>
            <input type="email" name="email" class="form-control border-start-0" placeholder="admin@physioedvance.com" required>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label text-slate-700 fw-semibold small">Password <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="ri-lock-line text-muted"></i></span>
            <input type="password" name="password" class="form-control border-start-0" placeholder="••••••••" minlength="6" required>
          </div>
          <div class="form-text text-muted small">Must be at least 6 characters.</div>
        </div>

        <div class="mb-3">
          <label class="form-label text-slate-700 fw-semibold small">Phone Number</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="ri-phone-line text-muted"></i></span>
            <input type="tel" name="phone" class="form-control border-start-0" placeholder="+91 98765 43210">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label text-slate-700 fw-semibold small">Headline / Designation</label>
          <input type="text" name="headline" class="form-control" placeholder="e.g. Academic Coordinator">
        </div>

        <div class="mb-4">
          <label class="form-label text-slate-700 fw-semibold small">Qualification</label>
          <input type="text" name="qualification" class="form-control" placeholder="e.g. MPT, Ph.D">
        </div>

        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-primary rounded-pill py-2.5 fw-semibold shadow-sm">
            <i class="ri-user-add-line me-1.5"></i>Create Administrator
          </button>
          <a href="/admin/admins" class="btn btn-light rounded-pill py-2 text-muted fw-medium">Cancel</a>
        </div>
      </div>
    </div>

    <!-- Right Column: Granular Permissions Matrix -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between pb-3 mb-4 border-bottom gap-2">
          <div>
            <h5 class="fw-bold text-slate-900 mb-1">Delegate Permissions</h5>
            <p class="text-muted small mb-0">Select the functional modules and actions this admin is authorized to access.</p>
          </div>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="toggleAllCheckboxes(true)">
              <i class="ri-checkbox-multiple-line me-1"></i>Select All
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="toggleAllCheckboxes(false)">
              <i class="ri-checkbox-indeterminate-line me-1"></i>Deselect All
            </button>
          </div>
        </div>

        <div class="d-flex flex-column gap-4">
          <% Object.keys(resourceGroups).forEach(resKey => { 
               const group = resourceGroups[resKey];
          %>
            <div class="border rounded-3 p-3 bg-light-subtle">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-2">
                  <div class="w-8 h-8 rounded-2 bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="<%= group.icon || 'ri-shield-line' %>"></i>
                  </div>
                  <div>
                    <h6 class="fw-bold text-slate-900 mb-0"><%= group.label %></h6>
                    <span class="badge bg-light text-muted border text-xs" style="font-size: 0.65rem;"><%= group.resource %></span>
                  </div>
                </div>
                <button type="button" class="btn btn-sm btn-link text-primary p-0 small fw-medium" onclick="toggleGroupCheckboxes('<%= group.resource %>')">
                  Toggle Category
                </button>
              </div>

              <div class="row g-2">
                <% group.permissions.forEach(perm => { %>
                  <div class="col-sm-6 col-md-4">
                    <label class="form-check border rounded-3 p-2.5 bg-white d-flex align-items-center gap-2 mb-0 cursor-pointer shadow-xs hover-shadow-sm transition-all" style="cursor: pointer;">
                      <input class="form-check-input mt-0 perm-checkbox perm-group-<%= group.resource %>" type="checkbox" name="permissions[]" value="<%= perm.permission_key %>">
                      <div class="overflow-hidden">
                        <div class="fw-semibold text-slate-900 text-sm"><%= perm.action %></div>
                        <div class="text-muted text-xs text-truncate" title="<%= perm.description || perm.name %>"><%= perm.name %></div>
                      </div>
                    </label>
                  </div>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</form>

<script>
  function toggleAllCheckboxes(checked) {
    document.querySelectorAll('.perm-checkbox').forEach(cb => {
      cb.checked = checked;
    });
  }

  function toggleGroupCheckboxes(groupKey) {
    const groupCbs = document.querySelectorAll('.perm-group-' + groupKey);
    const anyUnchecked = Array.from(groupCbs).some(cb => !cb.checked);
    groupCbs.forEach(cb => {
      cb.checked = anyUnchecked;
    });
  }
</script>
