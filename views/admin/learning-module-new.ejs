function removeMultiCard(id) {
  const card = document.getElementById('dynamicCard_' + id);
  if (card) card.remove();
}

function changeCardType(id, type) {
  const card = document.getElementById('dynamicCard_' + id);
  if (!card) return;
  const mcqSec = card.querySelector('.card-mcq-section');
  const qaSec = card.querySelector('.card-qa-section');
  if (type === 'mcq') {
    mcqSec.classList.remove('d-none');
    qaSec.classList.add('d-none');
  } else {
    mcqSec.classList.add('d-none');
    qaSec.classList.remove('d-none');
  }
}

function submitInteractiveCards(e) {
  const categoryId = document.getElementById('multiCategorySelect').value;
  if (!categoryId) {
    alert('Please select a Subject for all questions.');
    e.preventDefault();
    return false;
  }

  const cards = document.querySelectorAll('.dynamic-q-card');
  const questionsList = [];

  cards.forEach(card => {
    const type = card.querySelector('.card-type-select').value;
    const title = card.querySelector('.card-title').value.trim();
    const topic = card.querySelector('.card-topic').value.trim();
    const difficulty = card.querySelector('.card-difficulty').value;
    const question = card.querySelector('.card-question').value.trim();

    if (!question) return;

    if (type === 'mcq') {
      const optA = card.querySelector('.card-opt-a').value.trim();
      const optB = card.querySelector('.card-opt-b').value.trim();
      const optC = card.querySelector('.card-opt-c').value.trim();
      const optD = card.querySelector('.card-opt-d').value.trim();
      const explanation = card.querySelector('.card-explanation').value.trim();
      
      const correctRadios = card.querySelectorAll('input[type="radio"]');
      let correctIdx = 0;
      correctRadios.forEach(r => { if (r.checked) correctIdx = parseInt(r.value, 10); });

      const options = [optA, optB, optC, optD].filter(Boolean);

      questionsList.push({
        question_type: 'mcq',
        title: title || null,
        topic: topic || null,
        difficulty: difficulty,
        question: question,
        options: options.length > 0 ? options : ['Option A', 'Option B', 'Option C', 'Option D'],
        correct_option: correctIdx,
        explanation: explanation || null,
        marks: 1
      });
    } else {
      const modelAnswer = card.querySelector('.card-model-answer').value.trim();
      questionsList.push({
        question_type: type,
        title: title || null,
        topic: topic || null,
        difficulty: difficulty,
        question: question,
        model_answer: modelAnswer || null,
        marks: type === 'large_qa' ? 15 : 5
      });
    }
  });

  if (questionsList.length === 0) {
    alert('Please fill in at least one question card.');
    e.preventDefault();
    return false;
  }

  document.getElementById('interactiveBulkJson').value = JSON.stringify(questionsList);
  return true;
}

document.addEventListener('DOMContentLoaded', function() {
  toggleQuestionType();
  addMultiQuestionCard(); // Add first interactive card
});
</script>

