<!-- ============ ACTIVE USERS TABLE ============ -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
  <div class="table-responsive">
    <table class="table pe-user-table align-middle mb-0" id="activeUsersTable">
      <thead class="bg-light text-muted small text-uppercase" style="letter-spacing: 0.5px;">
        <tr>
          <th class="ps-4 py-3" style="min-width: 140px;">User ID</th>
          <th class="py-3">User Profile</th>
          <th class="py-3">Email Address</th>
          <th class="py-3">Password / Credentials</th>
          <th class="py-3 text-center">Role</th>
          <th class="py-3 text-center">Status</th>
          <th class="py-3">Joined Date</th>
          <th class="pe-4 py-3 text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr id="emptyUsersRow">
            <td colspan="8" class="text-center text-muted py-5">
              <i class="ri-user-unfollow-line display-5 text-muted opacity-50 d-block mb-2"></i>
              <h6 class="fw-bold text-dark">No active users found.</h6>
              <p class="small text-muted mb-0">Try changing the role filter above.</p>
            </td>
          </tr>
        <% } %>
        <% users.forEach(u => { 
             const userPass = u.plain_password || (u.role === 'admin' ? 'Admin@123' : (u.role === 'instructor' ? 'Instructor@123' : 'Student@123'));
             const formattedId = u.user_code || ('PE-' + (u.role ? u.role.substring(0,3).toUpperCase() : 'USR') + '-' + String(u.id).padStart(4, '0'));
        %>
          <tr class="user-row" data-search="<%= (u.name + ' ' + u.email + ' ' + u.role + ' ' + formattedId).toLowerCase() %>">
            <td class="ps-4 py-3">
              <span class="pe-user-id-pill">
                <i class="ri-fingerprint-line text-primary"></i> <%= formattedId %>
              </span>
            </td>
            <td class="py-3">
              <a href="/admin/users/<%= u.id %>" class="d-flex align-items-center gap-2.5 text-decoration-none text-dark group-hover">
                <img src="<%= u.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(u.name) + '&background=0a5dc2&color=fff' %>" 
                     class="user-avatar-box shadow-xs" 
                     onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(u.name) %>&background=0a5dc2&color=fff'">
                <div>
                  <div class="fw-bold text-dark"><%= u.name %></div>
                </div>
              </a>
            </td>
            <td class="py-3">
              <div class="d-inline-flex align-items-center gap-1.5 text-secondary">
                <i class="ri-mail-line text-muted small"></i>
                <span class="small font-weight-medium"><%= u.email %></span>
              </div>
            </td>
            <td class="py-3">
              <div class="pe-pw-box" id="pw-box-<%= u.id %>">
                <span class="pw-value" data-hidden="true" data-plain="<%= userPass %>">••••••••</span>
                <button type="button" class="pe-pw-toggle-btn" onclick="togglePassword('<%= u.id %>')" title="Show/Hide Password">
                  <i class="ri-eye-line" id="eye-icon-<%= u.id %>"></i>
                </button>
                <button type="button" class="pe-pw-copy-btn" id="copy-btn-<%= u.id %>" onclick="copyPassword('<%= u.id %>')" title="Copy Password">
                  <i class="ri-file-copy-line"></i>
                </button>
              </div>
            </td>
            <td class="py-3 text-center">
              <% const rInfo = getRoleInfo(u.role); %>
              <span class="pe-role-badge <%= rInfo.cls %>">
                <i class="<%= rInfo.icon %>"></i> <%= rInfo.label %>
              </span>
            </td>
            <td class="py-3 text-center">
              <form action="/admin/users/<%= u.id %>/toggle-active" method="POST" class="d-inline">
                <button type="submit" class="badge <%= u.is_active ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle' %> rounded-pill px-2.5 py-1 font-weight-bold border-0" style="cursor:pointer;" title="Click to toggle account status">
                  <i class="ri-<%= u.is_active ? 'checkbox-circle-line' : 'close-circle-line' %> me-1"></i> <%= u.is_active ? 'Active' : 'Inactive' %>
                </button>
              </form>
            </td>
            <td class="py-3 text-muted small">
              <i class="ri-calendar-line me-1 text-muted"></i><%= new Date(u.created_at).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) %>
            </td>
            <td class="pe-4 py-3 text-end">
              <div class="d-inline-flex align-items-center gap-1.5">
                <a href="/admin/users/<%= u.id %>" class="action-btn-circle btn btn-sm btn-outline-primary" title="View Detailed Profile">
                  <i class="ri-eye-line"></i>
                </a>
                <button type="button" class="action-btn-circle btn btn-sm btn-outline-warning text-dark border shadow-2xs" onclick="openEditUserModal(<%= JSON.stringify(u) %>)" title="Edit User Details & Role">
                  <i class="ri-edit-line text-warning-emphasis"></i>
                </button>
                <% if (u.role !== 'admin') { %>
                  <form action="/admin/users/<%= u.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Move user &quot;<%= u.name %>&quot; to Deleted Users (Recycle Bin)?')">
                    <button type="submit" class="action-btn-circle btn btn-sm btn-outline-danger" title="Move to Recycle Bin">
                      <i class="ri-delete-bin-line"></i>
                    </button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- ============ DELETED USERS (RECYCLE BIN / TRASH) ============ -->
<div class="mt-5 pt-4 border-top">
  <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
      <h5 class="fw-black text-danger mb-1 d-flex align-items-center gap-2">
        <i class="ri-delete-bin-line"></i> Deleted Users (Recycle Bin)
      </h5>
      <p class="text-muted small mb-0">Users in the recycle bin can be instantly restored back or permanently deleted from the database.</p>
    </div>
    <% if (deletedUsers && deletedUsers.length > 0) { %>
      <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1.5 rounded-pill font-weight-bold">
        <i class="ri-recycle-line me-1"></i> <%= deletedUsers.length %> in Recycle Bin
      </span>
    <% } %>
  </div>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5" style="background: #fffafa; border: 1px dashed #f5c2c7 !important;">
    <div class="table-responsive">
      <table class="table pe-user-table align-middle mb-0">
        <thead style="background: #ffebe9;">
          <tr>
            <th class="ps-4 py-3" style="min-width: 140px; color: #842029;">User ID</th>
            <th class="py-3" style="color: #842029;">User</th>
            <th class="py-3" style="color: #842029;">Email Address</th>
            <th class="py-3" style="color: #842029;">Password</th>
            <th class="py-3 text-center" style="color: #842029;">Role</th>
            <th class="py-3" style="color: #842029;">Deleted At</th>
            <th class="pe-4 py-3 text-end" style="color: #842029;">Recycle Bin Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!deletedUsers || deletedUsers.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center text-muted py-4">
                <i class="ri-check-double-line text-success fs-5 me-1"></i> Recycle bin is empty. No deleted users.
              </td>
            </tr>
          <% } else { %>
            <% deletedUsers.forEach(u => { 
                 const userPass = u.plain_password || (u.role === 'admin' ? 'Admin@123' : (u.role === 'instructor' ? 'Instructor@123' : 'Student@123'));
                 const formattedId = u.user_code || ('PE-' + (u.role ? u.role.substring(0,3).toUpperCase() : 'USR') + '-' + String(u.id).padStart(4, '0'));
            %>
              <tr>
                <td class="ps-4 py-3">
                  <span class="pe-user-id-pill" style="background: #fee2e2; border-color: #fca5a5; color: #991b1b;">
                    <i class="ri-fingerprint-line"></i> <%= formattedId %>
                  </span>
                </td>
                <td class="py-3">
                  <div class="d-flex align-items-center gap-2.5 opacity-75">
                    <img src="<%= u.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(u.name) + '&background=dc3545&color=fff' %>" 
                         class="user-avatar-box grayscale" 
                         onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(u.name) %>&background=dc3545&color=fff'">
                    <div>
                      <span class="fw-bold text-decoration-line-through text-muted"><%= u.name %></span>
                      <span class="badge bg-danger text-white ms-2" style="font-size:0.68rem;">Deleted</span>
                    </div>
                  </div>
                </td>
                <td class="py-3 text-muted small"><%= u.email %></td>
                <td class="py-3">
                  <div class="pe-pw-box" id="pw-box-del-<%= u.id %>">
                    <span class="pw-value" data-hidden="true" data-plain="<%= userPass %>">••••••••</span>
                    <button type="button" class="pe-pw-toggle-btn" onclick="togglePassword('del-<%= u.id %>')" title="Show/Hide Password">
                      <i class="ri-eye-line" id="eye-icon-del-<%= u.id %>"></i>
                    </button>
                    <button type="button" class="pe-pw-copy-btn" id="copy-btn-del-<%= u.id %>" onclick="copyPassword('del-<%= u.id %>')" title="Copy Password">
                      <i class="ri-file-copy-line"></i>
                    </button>
                  </div>
                </td>
                <td class="py-3 text-center">
                  <% const delRInfo = getRoleInfo(u.role); %>
                  <span class="pe-role-badge <%= delRInfo.cls %>">
                    <i class="<%= delRInfo.icon %>"></i> <%= delRInfo.label %>
                  </span>
                </td>
                <td class="py-3 text-muted small"><%= new Date(u.updated_at || u.created_at).toLocaleDateString() %></td>
                <td class="pe-4 py-3 text-end">
                  <div class="d-inline-flex align-items-center gap-2">
                    <!-- Restore Form -->
                    <form action="/admin/users/<%= u.id %>/restore" method="POST" class="d-inline">
                      <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 py-1 font-weight-bold d-inline-flex align-items-center gap-1 shadow-xs" title="Restore User">
                        <i class="ri-restart-line"></i> Restore
                      </button>
                    </form>

                    <!-- Permanent Delete Form -->
                    <form action="/admin/users/<%= u.id %>/permanent-delete" method="POST" class="d-inline" onsubmit="return confirm('WARNING: Are you sure you want to PERMANENTLY delete user &quot;<%= u.name %>&quot;? All associated records will be deleted and CANNOT be recovered!')">
                      <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 font-weight-bold d-inline-flex align-items-center gap-1" title="Delete Permanently">
                        <i class="ri-delete-bin-2-line"></i> Delete Permanently
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  function togglePassword(id) {
    const box = document.getElementById('pw-box-' + id);
    if (!box) return;
    const valEl = box.querySelector('.pw-value');
    const eyeIcon = document.getElementById('eye-icon-' + id);
    if (!valEl || !eyeIcon) return;

    const isHidden = valEl.getAttribute('data-hidden') === 'true';
    const plain = valEl.getAttribute('data-plain') || '';

    if (isHidden) {
      valEl.innerText = plain;
      valEl.setAttribute('data-hidden', 'false');
      eyeIcon.className = 'ri-eye-off-line';
      box.style.background = '#e0f2fe';
      box.style.borderColor = '#7dd3fc';
      box.style.color = '#0369a1';
    } else {
      valEl.innerText = '••••••••';
      valEl.setAttribute('data-hidden', 'true');
      eyeIcon.className = 'ri-eye-line';
      box.style.background = '#f1f5f9';
      box.style.borderColor = '#e2e8f0';
      box.style.color = '#334155';
    }
  }

  function copyPassword(id) {
    const box = document.getElementById('pw-box-' + id);
    if (!box) return;
    const valEl = box.querySelector('.pw-value');
    const copyBtn = document.getElementById('copy-btn-' + id);
    if (!valEl || !copyBtn) return;

    const plain = valEl.getAttribute('data-plain') || '';
    
    // Copy to clipboard
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(plain).then(() => showCopied(copyBtn));
    } else {
      // Fallback
      const tempInput = document.createElement('input');
      tempInput.value = plain;
      document.body.appendChild(tempInput);
      tempInput.select();
      document.execCommand('copy');
      document.body.removeChild(tempInput);
      showCopied(copyBtn);
    }
  }

  function showCopied(btn) {
    const origHtml = btn.innerHTML;
    btn.innerHTML = '<i class="ri-check-line"></i>';
    btn.classList.add('copied');
    setTimeout(() => {
      btn.innerHTML = origHtml;
      btn.classList.remove('copied');
    }, 1500);
  }

  function filterUserTable() {
    const query = (document.getElementById('userLiveSearch').value || '').toLowerCase().trim();
    const rows = document.querySelectorAll('#activeUsersTable tbody tr.user-row');
    rows.forEach(row => {
      const searchData = row.getAttribute('data-search') || '';
      if (!query || searchData.includes(query)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  function generateRandomPassword() {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789@#$';
    let pw = '';
    pw += 'ABCDEFGHJKLMNPQRSTUVWXYZ'[(Math.random() * 24) | 0];
    pw += 'abcdefghijkmnopqrstuvwxyz'[(Math.random() * 24) | 0];
    pw += '23456789'[(Math.random() * 8) | 0];
    pw += '@#$'[(Math.random() * 3) | 0];
    for (let i = 0; i < 4; i++) {
      pw += chars[(Math.random() * chars.length) | 0];
    }
    const input = document.getElementById('newUserPassword');
    if (input) {
      input.value = pw;
    }
  }

  function toggleModalPwVisibility() {
    const input = document.getElementById('newUserPassword');
    const eye = document.getElementById('modalPwEye');
    if (!input || !eye) return;
    if (input.type === 'password') {
      input.type = 'text';
      eye.className = 'ri-eye-off-line';
    } else {
      input.type = 'password';
      eye.className = 'ri-eye-line';
    }
  }

  function handleRoleChange(role) {
    const qual = document.getElementById('lblQualification');
    const head = document.getElementById('lblHeadline');
    const qualInput = document.getElementById('inputQualification');
    const headInput = document.getElementById('inputHeadline');

    document.querySelectorAll('.pe-role-option-card').forEach(card => card.classList.remove('active'));
    const activeRadio = document.querySelector(`input[name="role"][value="${role}"]`);
    if (activeRadio) {
      activeRadio.checked = true;
      const parentLabel = activeRadio.closest('.pe-role-option-card');
      if (parentLabel) parentLabel.classList.add('active');
    }

    if (role === 'student') {
      if (qual) qual.innerText = 'Degree / Year (e.g. BPT 1st Year)';
      if (head) head.innerText = 'College / Institution';
      if (qualInput) qualInput.placeholder = 'e.g. BPT 1st Year, 2nd Year';
      if (headInput) headInput.placeholder = 'e.g. Apex Institute of Physiotherapy';
    } else if (role === 'intern') {
      if (qual) qual.innerText = 'Internship Hospital / Center';
      if (head) head.innerText = 'Clinical Rotation / Department';
      if (qualInput) qualInput.placeholder = 'e.g. AIIMS Orthopedic & Neuro Department';
      if (headInput) headInput.placeholder = 'e.g. 6-Month Compulsory Rotatory Intern';
    } else if (role === 'clinician') {
      if (qual) qual.innerText = 'Clinical Qualifications (e.g. BPT, MPT, MIAP)';
      if (head) head.innerText = 'Clinic / Hospital Name & Specialty';
      if (qualInput) qualInput.placeholder = 'e.g. MPT (Musculoskeletal), MIAP';
      if (headInput) headInput.placeholder = 'e.g. Consultant PT at Care Hospital';
    } else if (role === 'educator') {
      if (qual) qual.innerText = 'Academic Credentials / Faculty Title';
      if (head) head.innerText = 'University / Department';
      if (qualInput) qualInput.placeholder = 'e.g. Associate Professor, MPT, PhD';
      if (headInput) headInput.placeholder = 'e.g. Dept. of Physiotherapy, Metro University';
    } else if (role === 'researcher') {
      if (qual) qual.innerText = 'Research Focus / Fellowship';
      if (head) head.innerText = 'Research Lab / Institution';
      if (qualInput) qualInput.placeholder = 'e.g. Biomechanics & Gait Analysis Research';
      if (headInput) headInput.placeholder = 'e.g. National Center for Health Research';
    } else if (role === 'instructor') {
      if (qual) qual.innerText = 'Teaching Credentials (e.g. MPT, PhD)';
      if (head) head.innerText = 'Designation / Specialization';
      if (qualInput) qualInput.placeholder = 'e.g. MPT (Neuro), Certified Master Trainer';
      if (headInput) headInput.placeholder = 'e.g. Senior Lecturer & Course Author';
    } else {
      if (qual) qual.innerText = 'Department / Title';
      if (head) head.innerText = 'Administrative Scope';
      if (qualInput) qualInput.placeholder = 'e.g. Platform Operations Lead';
      if (headInput) headInput.placeholder = 'e.g. Full Platform & System Superadmin';
    }
  }

  function handleEditRoleChange(role) {
    const qual = document.getElementById('editLblQualification');
    const head = document.getElementById('editLblHeadline');
    const qualInput = document.getElementById('editInputQualification');
    const headInput = document.getElementById('editInputHeadline');

    document.querySelectorAll('.pe-edit-role-card').forEach(card => card.classList.remove('active'));
    const activeRadio = document.querySelector(`input[name="role"][value="${role}"]#editRole_${role}`);
    if (activeRadio) {
      activeRadio.checked = true;
      const parentLabel = activeRadio.closest('.pe-edit-role-card');
      if (parentLabel) parentLabel.classList.add('active');
    }

    if (role === 'student') {
      if (qual) qual.innerText = 'Degree / Year (e.g. BPT 1st Year)';
      if (head) head.innerText = 'College / Institution';
      if (qualInput) qualInput.placeholder = 'e.g. BPT 1st Year, 2nd Year';
      if (headInput) headInput.placeholder = 'e.g. Apex Institute of Physiotherapy';
    } else if (role === 'intern') {
      if (qual) qual.innerText = 'Internship Hospital / Center';
      if (head) head.innerText = 'Clinical Rotation / Department';
      if (qualInput) qualInput.placeholder = 'e.g. AIIMS Orthopedic & Neuro Department';
      if (headInput) headInput.placeholder = 'e.g. 6-Month Compulsory Rotatory Intern';
    } else if (role === 'clinician') {
      if (qual) qual.innerText = 'Clinical Qualifications (e.g. BPT, MPT, MIAP)';
      if (head) head.innerText = 'Clinic / Hospital Name & Specialty';
      if (qualInput) qualInput.placeholder = 'e.g. MPT (Musculoskeletal), MIAP';
      if (headInput) headInput.placeholder = 'e.g. Consultant PT at Care Hospital';
    } else if (role === 'educator') {
      if (qual) qual.innerText = 'Academic Credentials / Faculty Title';
      if (head) head.innerText = 'University / Department';
      if (qualInput) qualInput.placeholder = 'e.g. Associate Professor, MPT, PhD';
      if (headInput) headInput.placeholder = 'e.g. Dept. of Physiotherapy, Metro University';
    } else if (role === 'researcher') {
      if (qual) qual.innerText = 'Research Focus / Fellowship';
      if (head) head.innerText = 'Research Lab / Institution';
      if (qualInput) qualInput.placeholder = 'e.g. Biomechanics & Gait Analysis Research';
      if (headInput) headInput.placeholder = 'e.g. National Center for Health Research';
    } else if (role === 'instructor') {
      if (qual) qual.innerText = 'Teaching Credentials (e.g. MPT, PhD)';
      if (head) head.innerText = 'Designation / Specialization';
      if (qualInput) qualInput.placeholder = 'e.g. MPT (Neuro), Certified Master Trainer';
      if (headInput) headInput.placeholder = 'e.g. Senior Lecturer & Course Author';
    } else {
      if (qual) qual.innerText = 'Department / Title';
      if (head) head.innerText = 'Administrative Scope';
      if (qualInput) qualInput.placeholder = 'e.g. Platform Operations Lead';
      if (headInput) headInput.placeholder = 'e.g. Full Platform & System Superadmin';
    }
  }

  function openEditUserModal(u) {
    if (!u) return;
    const form = document.getElementById('editUserForm');
    if (form) {
      form.action = '/admin/users/' + u.id + '/edit';
    }
    
    document.getElementById('editUserId').value = u.id || '';
    document.getElementById('editUserName').value = u.name || '';
    document.getElementById('editUserEmail').value = u.email || '';
    document.getElementById('editUserCode').value = u.user_code || '';
    document.getElementById('editUserPhone').value = u.phone || '';
    document.getElementById('editUserPassword').value = '';
    document.getElementById('editInputQualification').value = u.qualification || '';
    document.getElementById('editInputHeadline').value = u.headline || '';
    document.getElementById('editUserBio').value = u.bio || '';
    
    const activeCheck = document.getElementById('editUserIsActive');
    if (activeCheck) {
      activeCheck.checked = (u.is_active === 1 || u.is_active === true || u.is_active === '1');
    }

    const currentRole = (u.role === 'academic_educator' || u.role === 'academic_mission') ? 'educator' : (u.role || 'student');
    handleEditRoleChange(currentRole);

    const modalEl = document.getElementById('editUserModal');
    if (modalEl) {
      if (modalEl.parentElement !== document.body) {
        document.body.appendChild(modalEl);
      }
      if (window.bootstrap && bootstrap.Modal) {
        const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
        bsModal.show();
      } else {
        modalEl.classList.add('show');
        modalEl.style.display = 'block';
      }
    }
  }

  function generateEditPassword() {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789@#$';
    let pw = '';
    pw += 'ABCDEFGHJKLMNPQRSTUVWXYZ'[(Math.random() * 24) | 0];
    pw += 'abcdefghijkmnopqrstuvwxyz'[(Math.random() * 24) | 0];
    pw += '23456789'[(Math.random() * 8) | 0];
    pw += '@#$'[(Math.random() * 3) | 0];
    for (let i = 0; i < 4; i++) {
      pw += chars[(Math.random() * chars.length) | 0];
    }
    const input = document.getElementById('editUserPassword');
    if (input) {
      input.value = pw;
      input.type = 'text';
    }
  }

  function toggleEditModalPwVisibility() {
    const input = document.getElementById('editUserPassword');
    const eye = document.getElementById('editModalPwEye');
    if (!input || !eye) return;
    if (input.type === 'password') {
      input.type = 'text';
      eye.className = 'ri-eye-off-line';
    } else {
      input.type = 'password';
      eye.className = 'ri-eye-line';
    }
  }
</script>

