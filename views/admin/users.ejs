                  <div class="pe-role-box">
                    <div class="pe-role-icon text-teal bg-teal-subtle mx-auto mb-1.5 rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-size: 1.15rem;">
                      <i class="ri-microscope-line"></i>
                    </div>
                    <div class="fw-bold text-dark mb-0.5" style="font-size: 0.85rem;">Researcher</div>
                    <div class="text-muted" style="font-size: 0.7rem;">Research scholar & fellow</div>
                  </div>
                </label>
              </div>

              <div class="col-6 col-md-4 col-xl-4">
                <label class="pe-role-option-card d-block p-2.5 rounded-3 text-center h-100 position-relative" onclick="handleRoleChange('instructor')">
