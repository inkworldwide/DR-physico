              <div class="col-6 col-md-4 col-xl-3">
                <label class="pe-role-option-card d-block p-2.5 rounded-3 text-center h-100 position-relative" onclick="handleRoleChange('clinician')">
                  <input type="radio" name="role" value="clinician" class="btn-check" id="roleClinician">
                  <div class="pe-role-box">
                    <div class="pe-role-icon text-success bg-success-subtle mx-auto mb-1.5 rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-size: 1.15rem;">
                      <i class="ri-hospital-line"></i>
                    </div>
