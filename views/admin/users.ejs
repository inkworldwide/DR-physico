                  <div class="pe-role-box">
                    <div class="pe-role-icon text-info bg-info-subtle mx-auto mb-1.5 rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-size: 1.15rem;">
                      <i class="ri-book-read-line"></i>
