<div class="pe-page-header mb-4">
  <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge bg-danger-subtle text-danger px-2.5 py-1 rounded-pill fw-semibold" style="font-size: 0.75rem;">
          <i class="ri-shield-keyhole-line me-1"></i>Super Admin Exclusive
        </span>
      </div>
      <h1 class="h3 fw-bold text-slate-900 mb-1">Instructor Management & Permissions</h1>
      <p class="text-muted small mb-0">Control course creation, lesson authoring, and content publication privileges for instructors.</p>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
  <div class="card-header bg-transparent border-0 px-4 pt-4 pb-3">
    <h5 class="fw-bold text-slate-900 mb-0">Instructor Directory</h5>
  </div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="bg-light text-muted small text-uppercase">
        <tr>
          <th class="ps-4 py-3">Instructor</th>
          <th class="py-3">Headline / Title</th>
          <th class="py-3">Permissions Status</th>
          <th class="py-3">Status</th>
          <th class="text-end pe-4 py-3">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!instructors || instructors.length === 0) { %>
          <tr>
            <td colspan="5" class="text-center py-5 text-muted">
              <i class="ri-presentation-line fs-2 mb-2 d-block text-slate-300"></i>
              No instructors found.
            </td>
          </tr>
        <% } else { %>
          <% instructors.forEach(ins => { %>
            <tr class="hover-bg-light">
              <td class="ps-4 py-3">
                <div class="d-flex align-items-center gap-3">
                  <div class="avatar rounded-circle bg-light border text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <% if (ins.avatar) { %>
                      <img src="<%= ins.avatar %>" alt="<%= ins.name %>" class="rounded-circle w-100 h-100 object-fit-cover">
                    <% } else { %>
                      <%= ins.name.charAt(0).toUpperCase() %>
                    <% } %>
                  </div>
                  <div>
                    <div class="fw-semibold text-slate-900"><%= ins.name %></div>
                    <div class="small text-muted"><%= ins.email %></div>
                    <span class="badge bg-light text-secondary border mt-1" style="font-size: 0.7rem;"><%= ins.user_code %></span>
                  </div>
                </div>
              </td>
              <td class="text-muted text-sm">
                <%= ins.headline || 'Instructor / Educator' %>
              </td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge <%= ins.permissionsCount > 0 ? 'bg-primary-subtle text-primary' : 'bg-secondary-subtle text-secondary' %> px-2 py-0.5 rounded-pill fw-medium">
                    <%= ins.permissionsCount || 0 %> Custom Permissions
                  </span>
                  <a href="/admin/instructors/<%= ins.id %>/permissions" class="btn btn-sm btn-link text-primary p-0 small fw-semibold">
                    Configure <i class="ri-arrow-right-s-line"></i>
                  </a>
                </div>
              </td>
              <td>
                <% if (ins.is_active === 0 || ins.is_active === false) { %>
                  <span class="badge bg-danger-subtle text-danger px-2.5 py-1 rounded-pill">Disabled</span>
                <% } else { %>
                  <span class="badge bg-success-subtle text-success px-2.5 py-1 rounded-pill">Active</span>
                <% } %>
              </td>
              <td class="text-end pe-4">
                <a href="/admin/instructors/<%= ins.id %>/permissions" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 text-xs fw-medium">
                  <i class="ri-key-2-line me-1"></i>Manage Permissions
                </a>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
