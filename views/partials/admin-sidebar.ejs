<div class="pe-sidebar" id="peSidebar">
  <div class="pe-sidebar-brand">
    <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
      <img src="/images/logo-icon.png" alt="PhysioEdvance" class="pe-logo-img" style="height:2.25rem;width:auto;">
      <span class="pe-sidebar-brand-text">Physio<b>Edvance</b></span>
    </a>
  </div>

  <div class="pe-sidebar-menu">
    <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'superadmin')) { %>
      <p class="pe-menu-label">Main</p>
      <% if (isSuperAdmin || hasModulePermission('MODULE_DASHBOARD')) { %>
        <a href="/admin/dashboard" class="pe-menu-link <%= currentPath==='/admin/dashboard'?'active':'' %>">
          <i class="ri-dashboard-2-line pe-icon-sky"></i><span>Dashboard</span>
        </a>
      <% } %>

      <% if (isSuperAdmin || hasModulePermission('MODULE_ADMIN_MANAGEMENT') || hasModulePermission('MODULE_INSTRUCTOR_PERMISSIONS') || hasModulePermission('MODULE_AUDIT_LOGS')) { %>
        <p class="pe-menu-label pe-menu-label-superadmin">
          <i class="ri-shield-keyhole-fill me-1 pe-icon-red"></i>Administration
        </p>
        <% if (isSuperAdmin || hasModulePermission('MODULE_ADMIN_MANAGEMENT')) { %>
          <a href="/admin/admins" class="pe-menu-link <%= currentPath.startsWith('/admin/admins') ? 'active' : '' %>">
            <i class="ri-admin-line pe-icon-red"></i><span>Admin Management</span>
          </a>
        <% } %>
        <% if (isSuperAdmin || hasModulePermission('MODULE_INSTRUCTOR_PERMISSIONS')) { %>
          <a href="/admin/instructors" class="pe-menu-link <%= currentPath.startsWith('/admin/instructors') ? 'active' : '' %>">
            <i class="ri-presentation-line pe-icon-amber"></i><span>Instructor Permissions</span>
          </a>
        <% } %>
        <% if (isSuperAdmin || hasModulePermission('MODULE_AUDIT_LOGS')) { %>
          <a href="/admin/audit-logs" class="pe-menu-link <%= currentPath==='/admin/audit-logs'?'active':'' %>">
            <i class="ri-shield-check-line pe-icon-sky"></i><span>Audit Logs</span>
          </a>
        <% } %>
      <% } %>

      <p class="pe-menu-label">Manage Modules</p>
      <% if (isSuperAdmin || hasModulePermission('MODULE_SUBJECTS') || hasPermission('SUBJECT', 'VIEW')) { %>
        <a href="/admin/categories" class="pe-menu-link <%= (currentPath==='/admin/categories' || currentPath.startsWith('/admin/categories'))?'active':'' %>">
          <i class="ri-folder-2-line pe-icon-indigo"></i><span>Subjects</span>
        </a>
      <% } %>
      <% if (isSuperAdmin || hasModulePermission('MODULE_LEARNING_MODULE')) { %>
        <a href="/admin/learning-modules" class="pe-menu-link <%= currentPath.startsWith('/admin/learning-modules') ? 'active' : '' %>">
          <i class="ri-book-read-line pe-icon-emerald"></i><span>Learning Modules</span>
        </a>
      <% } %>
      <% if (isSuperAdmin || hasModulePermission('MODULE_LIVE_DISCUSSION')) { %>
        <a href="/admin/live-discussions" class="pe-menu-link <%= currentPath.startsWith('/admin/live-discussions') ? 'active' : '' %>">
          <i class="ri-question-answer-line pe-icon-cyan"></i><span>Live Discussions</span>
        </a>
      <% } %>
      <% if (isSuperAdmin || hasModulePermission('MODULE_LIVE_CLASSES')) { %>
        <a href="/admin/live-sessions" class="pe-menu-link <%= currentPath==='/admin/live-sessions'?'active':'' %>">
          <i class="ri-vidicon-line pe-icon-red"></i><span>Live Classes</span>
        </a>
      <% } %>
      <% if (isSuperAdmin || hasModulePermission('MODULE_BLOG')) { %>
        <a href="/admin/blog" class="pe-menu-link <%= currentPath==='/admin/blog'?'active':'' %>">
          <i class="ri-article-line pe-icon-purple"></i><span>Blog</span>
        </a>
      <% } %>
      <% if (isSuperAdmin || hasModulePermission('MODULE_TEAM')) { %>
        <a href="/admin/team" class="pe-menu-link <%= currentPath==='/admin/team'?'active':'' %>">
          <i class="ri-user-star-line pe-icon-amber"></i><span>Team</span>
        </a>
      <% } %>
      <% if (isSuperAdmin || hasModulePermission('MODULE_CONTACT')) { %>
        <a href="/admin/appointments" class="pe-menu-link <%= currentPath==='/admin/appointments'?'active':'' %>">
          <i class="ri-calendar-check-line pe-icon-green"></i><span>Appointments</span>
        </a>
      <% } %>

      <% if (isSuperAdmin || hasModulePermission('MODULE_HOME')) { %>
        <p class="pe-menu-label">Home Page</p>
        <a href="/admin/homepage-sections" class="pe-menu-link <%= currentPath==='/admin/homepage-sections'?'active':'' %>">
          <i class="ri-arrow-up-down-line pe-icon-yellow"></i><span>Sections Position Order</span>
        </a>
        <a href="/admin/hero" class="pe-menu-link <%= currentPath==='/admin/hero'?'active':'' %>">
          <i class="ri-slideshow-line pe-icon-pink"></i><span>Hero Section</span>
        </a>
        <a href="/admin/curriculum" class="pe-menu-link <%= currentPath==='/admin/curriculum'?'active':'' %>">
          <i class="ri-graduation-cap-line pe-icon-blue"></i><span>Curriculum Cards</span>
        </a>
        <a href="/admin/learning-journey" class="pe-menu-link <%= currentPath==='/admin/learning-journey'?'active':'' %>">
          <i class="ri-route-line pe-icon-sky"></i><span>Learning Journey</span>
        </a>
        <a href="/admin/vision-mission" class="pe-menu-link <%= currentPath==='/admin/vision-mission'?'active':'' %>">
          <i class="ri-compass-3-line pe-icon-emerald"></i><span>Vision & Mission</span>
        </a>
        <a href="/admin/cta" class="pe-menu-link <%= currentPath==='/admin/cta'?'active':'' %>">
          <i class="ri-megaphone-line pe-icon-pink"></i><span>Call to Action Banner</span>
        </a>
      <% } %>

      <p class="pe-menu-label">Account</p>
      <a href="/admin/profile" class="pe-menu-link <%= currentPath==='/admin/profile'?'active':'' %>">
        <i class="ri-user-settings-line pe-icon-sky"></i><span>Profile</span>
      </a>
      <a href="/" class="pe-menu-link">
        <i class="ri-global-line pe-icon-green"></i><span>View Site</span>
      </a>

    <% } else if (currentUser && currentUser.role === 'instructor') { %>
      <p class="pe-menu-label">Main</p>
      <a href="/instructor/dashboard" class="pe-menu-link <%= currentPath==='/instructor/dashboard'?'active':'' %>">
        <i class="ri-dashboard-2-line pe-icon-sky"></i><span>Dashboard</span>
      </a>

      <p class="pe-menu-label">Teaching Modules</p>
      <% if (hasModulePermission('MODULE_COURSES') || hasModulePermission('MODULE_SUBJECTS') || hasPermission('COURSE', 'VIEW')) { %>
        <a href="/instructor/courses" class="pe-menu-link <%= currentPath === '/instructor/courses' ? 'active' : '' %>">
          <i class="ri-book-2-line pe-icon-indigo"></i><span>My Courses</span>
        </a>
      <% } %>
      <% if (hasModulePermission('MODULE_COURSES') || hasModulePermission('MODULE_SUBJECTS') || hasPermission('COURSE', 'CREATE')) { %>
        <a href="/instructor/courses/wizard" class="pe-menu-link <%= currentPath === '/instructor/courses/wizard' ? 'active' : '' %>">
          <i class="ri-add-circle-line pe-icon-blue"></i><span>Add / Upload Course</span>
        </a>
      <% } %>
      <% if (hasModulePermission('MODULE_LIVE_CLASSES') || hasPermission('LIVE_CLASS', 'VIEW')) { %>
        <a href="/admin/live-sessions" class="pe-menu-link <%= currentPath === '/admin/live-sessions' ? 'active' : '' %>">
          <i class="ri-video-chat-line pe-icon-red"></i><span>Live Classes</span>
        </a>
      <% } %>
      <% if (hasModulePermission('MODULE_LIVE_DISCUSSION')) { %>
        <a href="/admin/live-discussions" class="pe-menu-link <%= currentPath.startsWith('/admin/live-discussions') ? 'active' : '' %>">
          <i class="ri-question-answer-line pe-icon-cyan"></i><span>Live Discussions</span>
        </a>
      <% } %>

      <p class="pe-menu-label">Account</p>
      <a href="/instructor/profile" class="pe-menu-link <%= currentPath==='/instructor/profile'?'active':'' %>">
        <i class="ri-user-settings-line pe-icon-sky"></i><span>Profile</span>
      </a>
      <a href="/" class="pe-menu-link">
        <i class="ri-global-line pe-icon-green"></i><span>View Site</span>
      </a>
    <% } %>
  </div>
  <script>
    (function() {
      try {
        var sb = document.getElementById('peSidebar');
        if (!sb) return;
        var saved = sessionStorage.getItem('pe_admin_sidebar_scroll');
        if (saved !== null) {
          sb.scrollTop = parseInt(saved, 10) || 0;
        } else {
          var active = sb.querySelector('.pe-menu-link.active');
          if (active) {
            active.scrollIntoView({ block: 'nearest' });
          }
        }
      } catch(e) {}
    })();
  </script>
</div>
