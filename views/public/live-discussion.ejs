  function toggleChildReplies(btnEl, replyId) {
    let btn = (typeof btnEl === 'object' && btnEl && btnEl.nodeType) ? btnEl : null;
    let id = btn ? replyId : btnEl;

    const parentNodes = document.querySelectorAll(`#reply-node-${id}`);
    parentNodes.forEach(parentNode => {
      const scope = parentNode.parentElement;
      const childContainer = parentNode.querySelector(`#child-replies-${id}`) || scope.querySelector(`#child-replies-${id}`);
      const toggleBtn = parentNode.querySelector('.toggle-children-btn');

      if (childContainer) {
        const isHidden = childContainer.classList.contains('d-none');
        if (isHidden) {
          childContainer.classList.remove('d-none');
          if (toggleBtn) {
            const icon = toggleBtn.querySelector('i');
            if (icon) icon.className = 'ri-subtract-line me-0.5';
          }
        } else {
          childContainer.classList.add('d-none');
          if (toggleBtn) {
            const icon = toggleBtn.querySelector('i');
            if (icon) icon.className = 'ri-add-line me-0.5';
          }
        }
      }
    });
  }

  function updateParentSubThreadCount(parentReplyId) {
    const parentNodes = document.querySelectorAll(`#reply-node-${parentReplyId}`);
    parentNodes.forEach(parentNode => {
      const scope = parentNode.parentElement;
      const childContainer = parentNode.querySelector(`#child-replies-${parentReplyId}`) || scope.querySelector(`#child-replies-${parentReplyId}`);
      const directChildren = childContainer ? childContainer.querySelectorAll(':scope > .pe-reply-item').length : 0;

      let toggleBtn = parentNode.querySelector('.toggle-children-btn');
      if (toggleBtn) {
        toggleBtn.classList.remove('d-none');
        toggleBtn.className = 'btn btn-xs btn-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-0.5 text-xs fw-bold d-inline-flex align-items-center gap-1 toggle-children-btn';
        toggleBtn.innerHTML = `<i class="ri-corner-down-right-line me-0.5 text-primary"></i> <span class="child-reply-count">${directChildren}</span> ${directChildren === 1 ? 'Reply' : 'Replies'}`;
      }
    });
  }

  function updateTopicCardReplyCount(disId, totalCount) {
    const repliesContainer = document.getElementById(`replies-${disId}`);
    const card = repliesContainer ? repliesContainer.closest('.pe-discussion-card') : null;
    if (!card) return;

    const replyCountSpan = card.querySelector('.reply-count');
    if (replyCountSpan) {
      replyCountSpan.textContent = totalCount;
    }

    const emptyMsg = repliesContainer.querySelector('.empty-replies-msg');
    if (emptyMsg) emptyMsg.remove();
  }

  function formatTimeAgo(timestamp) {
    if (!timestamp) return 'Just now';
    const date = new Date(timestamp);
    const now = new Date();
    const diffInSec = Math.floor((now - date) / 1000);

    if (diffInSec < 45) return 'Just now';
    const diffInMin = Math.floor(diffInSec / 60);
    if (diffInMin < 60) return diffInMin + 'm ago';
    const diffInHours = Math.floor(diffInMin / 60);
    if (diffInHours < 24) return diffInHours + 'h ago';
    const diffInDays = Math.floor(diffInHours / 24);
    if (diffInDays < 30) return diffInDays + 'd ago';
    const diffInMonths = Math.floor(diffInDays / 30);
    if (diffInMonths < 12) return diffInMonths + 'mo ago';
    const diffInYears = Math.floor(diffInDays / 365);
    return diffInYears + 'y ago';
  }

  function updateAllTimestamps() {
    document.querySelectorAll('.time-ago').forEach(el => {
      const ts = el.getAttribute('data-timestamp');
      if (ts) el.textContent = formatTimeAgo(ts);
    });
  }

  document.addEventListener('DOMContentLoaded', updateAllTimestamps);
  updateAllTimestamps();
  setInterval(updateAllTimestamps, 10000);

  function escapeHtml(text) {
    var map = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    };
    return String(text).replace(/[&<>"']/g, function(m) { return map[m]; });
  }

  function openFullscreenDiscussion(disId) {
    const cardEl = document.querySelector(`.pe-discussion-card[data-id="${disId}"]`);
    if (!cardEl) return;

    const modalEl = document.getElementById('fullscreenDiscussionModal');
    const modalBody = document.getElementById('fullscreenDiscussionModalBody');
    const subjectBadge = document.getElementById('fsModalSubjectBadge');
    const tagBadge = document.getElementById('fsModalTagBadge');

    const categoryBadgeText = cardEl.querySelector('.badge.bg-primary-subtle')?.textContent.trim() || 'Live Discussion';
    const tagBadgeText = cardEl.querySelector('.badge.bg-secondary-subtle')?.textContent.trim() || '# Topic';

    if (subjectBadge) subjectBadge.textContent = categoryBadgeText;
    if (tagBadge) tagBadge.textContent = tagBadgeText;

    const cardContentClone = cardEl.cloneNode(true);
    cardContentClone.classList.remove('h-100');

    // Remove the "View Card" button inside modal
    const fsViewBtn = cardContentClone.querySelector('.view-fullscreen-btn');
    if (fsViewBtn) fsViewBtn.remove();

    // Make title larger inside modal
    const modalTitle = cardContentClone.querySelector('h5');
    if (modalTitle) {
      modalTitle.className = 'fs-3 fw-bold text-slate-900 mb-3';
      modalTitle.removeAttribute('onclick');
      modalTitle.removeAttribute('title');
    }

    // Expand questions box
    const qBox = cardContentClone.querySelector('.p-3.bg-light');
    if (qBox) {
      qBox.className = 'p-4 bg-light rounded-3 border mb-4';
    }

    // Expand replies collapse by default inside modal
    const repliesCollapse = cardContentClone.querySelector('.collapse');
    if (repliesCollapse) {
      repliesCollapse.classList.add('show');
    }

    // Connect form submit
    const modalReplyForm = cardContentClone.querySelector('form[action="/live-discussion/reply"]');
    if (modalReplyForm) {
      modalReplyForm.setAttribute('onsubmit', `submitFsModalReply(event, this, ${disId})`);
    }

    modalBody.innerHTML = '';
    
    const wrapper = document.createElement('div');
    wrapper.className = 'max-w-4xl mx-auto bg-white rounded-4 p-3 p-md-4 border border-slate-100 shadow-sm';
    wrapper.appendChild(cardContentClone);
    
    modalBody.appendChild(wrapper);

    // Sync button handlers
    const modalLikeBtn = wrapper.querySelector('.disc-like-btn');
    const modalDislikeBtn = wrapper.querySelector('.disc-dislike-btn');
    
    if (modalLikeBtn) {
      modalLikeBtn.setAttribute('onclick', `handleFsDiscussionVote(this, ${disId}, 'like')`);
    }
    if (modalDislikeBtn) {
      modalDislikeBtn.setAttribute('onclick', `handleFsDiscussionVote(this, ${disId}, 'dislike')`);
    }

    wrapper.querySelectorAll('.reply-like-btn').forEach(btn => {
      const parentNode = btn.closest('.pe-reply-item');
      if (parentNode) {
        const replyId = parentNode.getAttribute('data-reply-id');
        btn.setAttribute('onclick', `handleFsReplyVote(this, ${replyId}, 'like', ${disId})`);
      }
    });

    wrapper.querySelectorAll('.reply-dislike-btn').forEach(btn => {
      const parentNode = btn.closest('.pe-reply-item');
      if (parentNode) {
        const replyId = parentNode.getAttribute('data-reply-id');
        btn.setAttribute('onclick', `handleFsReplyVote(this, ${replyId}, 'dislike', ${disId})`);
      }
    });

    const bsModal = new bootstrap.Modal(modalEl);
    bsModal.show();
  }

  function handleFsDiscussionVote(btn, disId, voteType) {
    handleDiscussionVote(btn, disId, voteType);
    
    const cardEl = document.querySelector(`.pe-discussion-card[data-id="${disId}"]`);
    if (cardEl) {
      const pageLikeCount = cardEl.querySelector('.disc-like-count');
      const pageDislikeCount = cardEl.querySelector('.disc-dislike-count');
      const fsLikeCount = btn.closest('.d-flex').querySelector('.disc-like-count');
      const fsDislikeCount = btn.closest('.d-flex').querySelector('.disc-dislike-count');
      
      setTimeout(() => {
        if (pageLikeCount && fsLikeCount) pageLikeCount.textContent = fsLikeCount.textContent;
        if (pageDislikeCount && fsDislikeCount) pageDislikeCount.textContent = fsDislikeCount.textContent;
      }, 50);
    }
  }

  function handleFsReplyVote(btn, replyId, voteType, disId) {
    handleReplyVote(btn, replyId, voteType);

    const pageReplyNode = document.getElementById(`reply-node-${replyId}`);
    if (pageReplyNode) {
      const pageLikeCount = pageReplyNode.querySelector('.reply-like-count');
      const pageDislikeCount = pageReplyNode.querySelector('.reply-dislike-count');
      const fsLikeCount = btn.closest('.d-flex').querySelector('.reply-like-count');
      const fsDislikeCount = btn.closest('.d-flex').querySelector('.reply-dislike-count');

      setTimeout(() => {
        if (pageLikeCount && fsLikeCount) pageLikeCount.textContent = fsLikeCount.textContent;
        if (pageDislikeCount && fsDislikeCount) pageDislikeCount.textContent = fsDislikeCount.textContent;
      }, 50);
    }
  }

  function submitFsModalReply(e, formEl, disId) {
    e.preventDefault();
    const inputEl = formEl.querySelector('.main-reply-input');
    const content = (inputEl ? inputEl.value : '').trim();
    if (!content) return;

    fetch('/live-discussion/reply', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ discussion_id: disId, content: content })
    })
    .then(r => r.json())
    .then(data => {
      if (data.success && data.reply) {
        if (inputEl) inputEl.value = '';
        
        const mainCardRepliesList = document.getElementById(`root-replies-${disId}`);
        const modalBody = document.getElementById('fullscreenDiscussionModalBody');
        const modalRepliesList = modalBody ? modalBody.querySelector(`#root-replies-${disId}`) : null;

        const newReplyHtml = createReplyNodeHTML(data.reply, disId, 0);

        if (mainCardRepliesList) {
          const emptyMsg = mainCardRepliesList.querySelector('.empty-replies-msg');
          if (emptyMsg) emptyMsg.remove();
          mainCardRepliesList.insertAdjacentHTML('beforeend', newReplyHtml);
        }

        if (modalRepliesList) {
          const emptyMsg = modalRepliesList.querySelector('.empty-replies-msg');
          if (emptyMsg) emptyMsg.remove();
          modalRepliesList.insertAdjacentHTML('beforeend', newReplyHtml);
        }

        updateTopicCardReplyCount(disId, data.totalRepliesCount);
        updateAllTimestamps();
      } else {
        alert(data.message || 'Failed to post reply.');
      }
    })
    .catch(err => console.error('Error submitting modal reply:', err));
  }
</script>

