<!-- ============ LIVE DISCUSSION HERO BANNER ============ -->
<section class="pe-hero-strip position-relative py-5 text-white overflow-hidden text-center" style="background: linear-gradient(135deg, #0a5dc2 0%, #0284c7 100%);">
  <div class="position-absolute end-0 bottom-0 opacity-10 pe-none me-4 mb-2">
    <i class="ri-discuss-line" style="font-size: 14rem; color: #ffffff;"></i>
  </div>

  <div class="container position-relative z-2 py-4">
    <div class="d-inline-flex align-items-center gap-2 mb-3">
      <% if (typeof headerSettings !== 'undefined' && headerSettings && headerSettings.badge) { %>
        <span class="badge bg-warning text-dark font-weight-bold text-uppercase px-3.5 py-2 rounded-pill shadow-sm" style="font-size: 0.8rem; letter-spacing: 0.05em; background-color: #f59e0b !important;">
          <i class="ri-question-answer-fill me-1"></i> <%= headerSettings.badge %>
        </span>
      <% } else { %>
        <span class="badge bg-warning text-dark font-weight-bold text-uppercase px-3.5 py-2 rounded-pill shadow-sm" style="font-size: 0.8rem; letter-spacing: 0.05em; background-color: #f59e0b !important;">
          <i class="ri-question-answer-fill me-1"></i> Interactive Student & Expert Community
        </span>
      <% } %>

      <% if (typeof headerSettings !== 'undefined' && headerSettings && headerSettings.sub_badge) { %>
        <span class="badge bg-white-20 text-white px-3 py-2 rounded-pill shadow-xs" style="font-size: 0.8rem;">
          <i class="ri-pulse-fill text-success me-1"></i> <%= headerSettings.sub_badge %>
        </span>
      <% } else { %>
        <span class="badge bg-white-20 text-white px-3 py-2 rounded-pill shadow-xs" style="font-size: 0.8rem;">
          <i class="ri-pulse-fill text-success me-1"></i> Live Clinical Rounds
        </span>
      <% } %>
    </div>

    <h1 class="display-4 font-weight-bold text-white mb-2" style="letter-spacing: -0.02em;">
      <%= (typeof headerSettings !== 'undefined' && headerSettings && headerSettings.title) ? headerSettings.title : 'Live Discussion' %>
    </h1>
    <p class="text-white-75 lead mx-auto mb-4" style="font-size: 1.15rem; line-height: 1.6; max-width: 720px;">
      <%= (typeof headerSettings !== 'undefined' && headerSettings && headerSettings.subtitle) ? headerSettings.subtitle : 'Engage in real-time academic discussions, clinical case rounds, differential diagnoses, and evidence-based physiotherapy reasoning with verified mentors and peers.' %>
    </p>

    <!-- Search Bar & Primary Actions -->
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10">
        <div class="input-group input-group-lg bg-white rounded-pill p-1 shadow-lg border-0 mb-3">
          <span class="input-group-text bg-transparent border-0 ps-4 text-muted">
            <i class="ri-search-2-line fs-5"></i>
          </span>
          <input type="text" id="discussionSearchInput" class="form-control border-0 shadow-none text-dark" placeholder="Search case discussions by condition, anatomy, or treatment (e.g. ACL, Stroke, COPD, Tendinopathy)..." style="font-size: 0.95rem;">
          <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold" style="background: #0a5dc2;" onclick="filterDiscussions()">
            Search
          </button>
        </div>

        <div class="d-flex flex-wrap align-items-center justify-content-center gap-2">
          <button type="button" class="btn btn-warning text-dark rounded-pill px-4 py-2 font-weight-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#newDiscussionModal">
            <i class="ri-add-circle-fill me-1.5"></i> Start New Discussion
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ MAIN LIVE DISCUSSION SECTION ============ -->
<section class="pe-section bg-light-subtle py-5">
  <div class="container py-2">

    <!-- Clinical Specialty Topic Selector Tabs -->
    <div class="mb-4">
      <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
          <h4 class="fw-bold text-slate-900 mb-0">Browse by Clinical Specialty & Topics</h4>
          <p class="text-muted small mb-0">Filter discussions by medical sub-discipline or academic examination focus.</p>
        </div>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fw-semibold" id="activeTopicCountBadge">
          Showing All 10 High-Yield Discussions
        </span>
      </div>

      <div class="d-flex gap-2 overflow-auto pb-2 pe-topic-filter-bar" style="scrollbar-width: thin;">
        <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 py-2 fw-semibold text-nowrap topic-tab active" data-category="all" onclick="selectTopicCategory('all', this)">
          <i class="ri-grid-fill me-1"></i> All Topics
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2 fw-medium text-nowrap topic-tab" data-category="orthopedics" onclick="selectTopicCategory('orthopedics', this)">
          <i class="ri-bone-line text-primary me-1"></i> Orthopedics & MSK
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2 fw-medium text-nowrap topic-tab" data-category="neurology" onclick="selectTopicCategory('neurology', this)">
          <i class="ri-brain-line text-danger me-1"></i> Neurology & Neuro-Rehab
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2 fw-medium text-nowrap topic-tab" data-category="cardiopulmonary" onclick="selectTopicCategory('cardiopulmonary', this)">
          <i class="ri-heart-pulse-line text-success me-1"></i> Cardiopulmonary & ICU
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2 fw-medium text-nowrap topic-tab" data-category="sports" onclick="selectTopicCategory('sports', this)">
          <i class="ri-trophy-line text-warning me-1"></i> Sports Physiotherapy
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2 fw-medium text-nowrap topic-tab" data-category="pediatrics" onclick="selectTopicCategory('pediatrics', this)">
          <i class="ri-bear-smile-line text-info me-1"></i> Pediatric Physiotherapy
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2 fw-medium text-nowrap topic-tab" data-category="electrotherapy" onclick="selectTopicCategory('electrotherapy', this)">
          <i class="ri-flashlight-line text-primary me-1"></i> Electrotherapy & Exercise Modalities
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2 fw-medium text-nowrap topic-tab" data-category="exam_prep" onclick="selectTopicCategory('exam_prep', this)">
          <i class="ri-file-list-3-line text-purple me-1"></i> Exam Viva, SAQ & LAQ
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2 fw-medium text-nowrap topic-tab" data-category="research" onclick="selectTopicCategory('research', this)">
          <i class="ri-microscope-line text-teal me-1"></i> Evidence-Based Practice (EBP)
        </button>
      </div>
    </div>

    <!-- Active Discussions Grid / Feed -->
    <div class="row g-4" id="discussionsContainer">

      <% if (typeof discussions !== 'undefined' && discussions && discussions.length > 0) { %>
        <% discussions.forEach((dis, idx) => { 
             const catClass = dis.category === 'orthopedics' ? 'bg-primary-subtle text-primary border-primary-subtle' :
                              dis.category === 'neurology' ? 'bg-danger-subtle text-danger border-danger-subtle' :
                              dis.category === 'cardiopulmonary' ? 'bg-success-subtle text-success border-success-subtle' :
                              dis.category === 'sports' ? 'bg-warning-subtle text-warning-emphasis border-warning-subtle' :
                              dis.category === 'pediatrics' ? 'bg-info-subtle text-info border-info-subtle' :
                              dis.category === 'electrotherapy' ? 'bg-primary-subtle text-primary border-primary-subtle' :
                              dis.category === 'exam_prep' ? 'bg-purple-subtle text-purple border-purple-subtle' :
                              'bg-secondary-subtle text-secondary border-secondary-subtle';
             
             const catIcon = dis.category === 'orthopedics' ? 'ri-bone-line' :
                             dis.category === 'neurology' ? 'ri-brain-line' :
                             dis.category === 'cardiopulmonary' ? 'ri-heart-pulse-line' :
                             dis.category === 'sports' ? 'ri-trophy-line' :
                             dis.category === 'pediatrics' ? 'ri-bear-smile-line' :
                             dis.category === 'electrotherapy' ? 'ri-flashlight-line' :
                             dis.category === 'exam_prep' ? 'ri-file-list-3-line' :
                             'ri-microscope-line';

             const initials = (dis.author_name || 'Faculty').split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
             const qList = (dis.questions || '').split('\n').filter(q => q.trim().length > 0);
        %>
          <div class="col-lg-6 discussion-item" data-category="<%= dis.category %>" data-keywords="<%= (dis.title + ' ' + dis.summary + ' ' + dis.questions + ' ' + dis.author_name).toLowerCase() %>">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 pe-discussion-card transition-all position-relative <%= dis.is_pinned === 1 ? 'border-top border-4 border-warning' : '' %>">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="badge <%= catClass %> border px-3 py-1 rounded-pill text-xs fw-semibold">
                  <i class="<%= catIcon %> me-1"></i> <%= dis.category.replace(/_/g, ' ').toUpperCase() %>
                </span>
                <div class="d-flex align-items-center gap-1.5">
                  <% if (dis.is_pinned === 1) { %>
                    <span class="badge bg-warning-subtle text-warning-emphasis px-2.5 py-1 rounded-pill text-xs fw-semibold">
                      <i class="ri-pushpin-2-fill me-1"></i> Pinned
                    </span>
                  <% } %>
                  <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1 rounded-pill text-xs fw-medium">
                    <i class="ri-fire-line me-1"></i> <%= dis.tag_label || 'Clinical Case' %>
                  </span>
                </div>
              </div>

              <h5 class="fw-bold text-slate-900 mb-2">
                <%= dis.title %>
              </h5>

              <p class="text-secondary text-sm mb-3" style="line-height: 1.6;">
                <strong>Case Summary:</strong> <%= dis.summary %>
              </p>

              <!-- Clinical Discussion Focus -->
              <div class="p-3 bg-light rounded-3 border mb-3">
                <div class="fw-bold text-dark text-xs text-uppercase mb-1.5" style="letter-spacing: 0.05em;">
                  <i class="ri-focus-3-line text-primary me-1"></i> Core Discussion Dilemma:
                </div>
                <% if (qList.length > 1) { %>
                  <ul class="text-xs text-slate-700 mb-0 ps-3" style="line-height: 1.6;">
                    <% qList.forEach(q => { %>
                      <li><%= q.replace(/^\d+[\.\)]\s*/, '') %></li>
                    <% }) %>
                  </ul>
                <% } else { %>
                  <p class="text-xs text-slate-700 mb-0" style="line-height: 1.6;"><%= dis.questions %></p>
                <% } %>
              </div>

              <!-- Expert Literature Takeaway (Expandable) -->
              <% if (dis.takeaway) { %>
                <div class="mb-3">
                  <button class="btn btn-xs btn-outline-primary rounded-pill px-3 py-1 text-xs fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#takeaway-<%= dis.id %>">
                    <i class="ri-book-read-line me-1"></i> View Mentor Literature Rationale <i class="ri-arrow-down-s-line"></i>
                  </button>
                  <div class="collapse mt-2" id="takeaway-<%= dis.id %>">
                    <div class="p-3 rounded-3 bg-primary-subtle text-slate-900 text-xs border border-primary-subtle">
                      <strong>Standard Clinical Consensus:</strong> <%= dis.takeaway %>
                    </div>
                  </div>
                </div>
              <% } %>

              <!-- Author, Stats & Action Bar -->
              <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
                <div class="d-flex align-items-center gap-2">
                  <div class="avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.75rem;">
                    <%= initials %>
                  </div>
                  <div>
                    <div class="fw-semibold text-slate-900 text-xs"><%= dis.author_name %></div>
                    <div class="text-muted text-xs">
                      <%= dis.author_role || 'Faculty' %> • <span class="time-ago" data-timestamp="<%= dis.created_at ? new Date(dis.created_at).toISOString() : new Date().toISOString() %>">Just now</span>
                    </div>
                  </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 text-xs vote-btn" onclick="toggleUpvote(this, <%= dis.id %>, <%= dis.upvotes || 0 %>)">
                    <i class="ri-thumb-up-line me-1"></i> <span class="vote-count"><%= dis.upvotes || 0 %></span>
                  </button>
                  <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 text-xs fw-semibold" data-bs-toggle="collapse" data-bs-target="#replies-<%= dis.id %>">
                    <i class="ri-chat-3-line me-1"></i> <span class="reply-count"><%= (dis.replies ? dis.replies.length : dis.replies_count) || 0 %></span> Replies
                  </button>
                </div>
              </div>

              <!-- Expandable Replies Thread -->
              <div class="collapse mt-3 pt-3 border-top" id="replies-<%= dis.id %>">
                <div class="d-flex flex-column gap-2 mb-3 pe-replies-list">
                  <% if (dis.replies && dis.replies.length > 0) { %>
                    <% dis.replies.forEach(rep => { %>
                      <div class="p-2.5 <%= rep.is_mentor === 1 ? 'bg-primary-subtle border border-primary-subtle' : 'bg-light' %> rounded-3 text-xs">
                        <div class="d-flex justify-content-between font-weight-semibold <%= rep.is_mentor === 1 ? 'text-primary' : 'text-dark' %> mb-1">
                          <span><%= rep.author_name %> <%= rep.author_role ? `(${rep.author_role})` : '' %></span>
                          <div class="d-flex align-items-center gap-1.5">
                            <% if (rep.is_mentor === 1) { %>
                              <span class="badge bg-primary text-white rounded-pill px-2 py-0.5 text-xs"><i class="ri-shield-star-line me-0.5"></i>Mentor Verified</span>
                            <% } %>
                            <span class="text-muted text-xs time-ago" data-timestamp="<%= rep.created_at ? new Date(rep.created_at).toISOString() : new Date().toISOString() %>">Just now</span>
                          </div>
                        </div>
                        <p class="text-secondary mb-0"><%= rep.content %></p>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <div class="text-muted text-xs text-center py-2 empty-replies-msg">No replies yet. Be the first to share your clinical reasoning!</div>
                  <% } %>
                </div>

                <!-- Add Reply Input -->
                <form action="/live-discussion/reply" method="POST" onsubmit="submitReply(event, this, 'replies-<%= dis.id %>')">
                  <input type="hidden" name="discussion_id" value="<%= dis.id %>">
                  <div class="input-group input-group-sm">
                    <input type="text" name="content" class="form-control" placeholder="Add your clinical insight or question..." required>
                    <button class="btn btn-primary fw-semibold" type="submit">Post</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>

    </div>

    <!-- Empty Search State -->
    <div id="noDiscussionsFound" class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center d-none mt-4">
      <div class="d-inline-flex align-items-center justify-content-center bg-light text-muted rounded-circle mb-3" style="width: 64px; height: 64px;">
        <i class="ri-search-eye-line fs-2"></i>
      </div>
      <h5 class="fw-bold text-dark mb-1">No matching clinical discussions found</h5>
      <p class="text-muted small mb-3">Try adjusting your keywords, or be the first to start a discussion thread on this topic!</p>
      <button type="button" class="btn btn-primary rounded-pill px-4 py-2 font-weight-semibold mx-auto" data-bs-toggle="modal" data-bs-target="#newDiscussionModal">
        <i class="ri-add-circle-fill me-1"></i> Start New Discussion
      </button>
    </div>

  </div>
</section>

<!-- ============ COMMUNITY GUIDELINES & BEST PRACTICES ============ -->
<section class="pe-section bg-white py-5 border-top">
  <div class="container py-2">
    <div class="text-center mb-4">
      <h4 class="fw-bold text-slate-900 mb-1">Clinical Discussion Professional Conduct</h4>
      <p class="text-muted small mb-0">Upholding highest standards of healthcare education and evidence-based exchange.</p>
    </div>

    <div class="row g-4 justify-content-center">
      <div class="col-md-4">
        <div class="card h-100 border rounded-4 p-3.5 bg-light-subtle shadow-none">
          <div class="d-flex align-items-center gap-2.5 mb-2">
            <div class="w-8 h-8 rounded-2 bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
              <i class="ri-microscope-fill"></i>
            </div>
            <h6 class="fw-bold text-slate-900 mb-0">Evidence-Based Reasoning</h6>
          </div>
          <p class="text-secondary small mb-0" style="line-height: 1.55;">Support treatment proposals with standard literature references, physiological mechanisms, or validated clinical practice guidelines.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card h-100 border rounded-4 p-3.5 bg-light-subtle shadow-none">
          <div class="d-flex align-items-center gap-2.5 mb-2">
            <div class="w-8 h-8 rounded-2 bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
              <i class="ri-user-unfollow-fill"></i>
            </div>
            <h6 class="fw-bold text-slate-900 mb-0">Patient De-Identification</h6>
          </div>
          <p class="text-secondary small mb-0" style="line-height: 1.55;">Ensure all real clinical case descriptions are anonymized with no identifiable patient names, exact addresses, or hospital tags.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card h-100 border rounded-4 p-3.5 bg-light-subtle shadow-none">
          <div class="d-flex align-items-center gap-2.5 mb-2">
            <div class="w-8 h-8 rounded-2 bg-warning-subtle text-warning-emphasis d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
              <i class="ri-medal-fill"></i>
            </div>
            <h6 class="fw-bold text-slate-900 mb-0">Faculty Peer Review</h6>
          </div>
          <p class="text-secondary small mb-0" style="line-height: 1.55;">Key discussion takeaways and high-yield questions are actively reviewed and verified by senior physiotherapy professors.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ START NEW DISCUSSION MODAL POP-UP ============ -->
<div class="modal fade" id="newDiscussionModal" tabindex="-1" aria-labelledby="newDiscussionModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
      <div class="modal-header bg-primary text-white p-4">
        <h5 class="modal-title font-weight-bold text-white d-flex align-items-center gap-2" id="newDiscussionModalLabel">
          <i class="ri-chat-new-fill text-warning fs-4"></i> Start New Clinical Discussion
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form id="newDiscussionForm" action="/live-discussion/create" method="POST">
        <div class="modal-body p-4">
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label font-weight-bold small text-slate-800">Specialty Category <span class="text-danger">*</span></label>
              <select name="category" id="newDisCategory" class="form-select rounded-3" required>
                <option value="orthopedics" selected>Orthopedics & MSK</option>
                <option value="neurology">Neurology & Neuro-Rehab</option>
                <option value="cardiopulmonary">Cardiopulmonary & ICU</option>
                <option value="sports">Sports Physiotherapy</option>
                <option value="pediatrics">Pediatric Physiotherapy</option>
                <option value="electrotherapy">Electrotherapy & Modalities</option>
                <option value="exam_prep">Exam Viva, SAQ & LAQ</option>
                <option value="research">Evidence-Based Practice</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label font-weight-bold small text-slate-800">Discussion Tag / Focus</label>
              <select name="tag_label" id="newDisTag" class="form-select rounded-3">
                <option value="Clinical Case Round" selected>Clinical Case Round</option>
                <option value="Differential Diagnosis">Differential Diagnosis</option>
                <option value="Treatment Protocol">Treatment Protocol</option>
                <option value="Exam Viva Question">Exam Viva Question</option>
                <option value="Literature Appraisal">Literature Appraisal</option>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label font-weight-bold small text-slate-800">Discussion Title / Clinical Headline <span class="text-danger">*</span></label>
            <input type="text" name="title" id="newDisTitle" class="form-control rounded-3" placeholder="e.g. 45yo Carpenter with Lateral Epicondylalgia refractory to standard eccentric loading" required>
          </div>

          <div class="mb-3">
            <label class="form-label font-weight-bold small text-slate-800">Patient Presentation & History <span class="text-danger">*</span></label>
            <textarea name="summary" id="newDisSummary" rows="3" class="form-control rounded-3" placeholder="Describe age, symptoms, onset, functional limitations, assessment tests, and previous interventions..." required></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label font-weight-bold small text-slate-800">Core Clinical Dilemmas / Specific Questions <span class="text-danger">*</span></label>
            <textarea name="questions" id="newDisQuestions" rows="3" class="form-control rounded-3" placeholder="What specific questions would you like fellow physiotherapists and faculty to analyze?" required></textarea>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label font-weight-bold small text-slate-800">Your Name / Title <span class="text-danger">*</span></label>
              <input type="text" name="author_name" id="newDisAuthor" class="form-control rounded-3" placeholder="e.g. Dr. Priya Patel (PT)" value="<%= currentUser ? currentUser.name : '' %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label font-weight-bold small text-slate-800">Designation / Role</label>
              <input type="text" name="author_role" id="newDisRole" class="form-control rounded-3" placeholder="e.g. BPT 4th Year / MPT Intern" value="<%= currentUser ? (currentUser.headline || currentUser.role) : '' %>">
            </div>
          </div>
        </div>

        <div class="modal-footer bg-light p-3 border-top justify-content-between">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4.5 font-weight-bold shadow-sm py-2">
            <i class="ri-send-plane-fill me-1"></i> Publish Discussion
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  let currentCategory = 'all';

  function selectTopicCategory(cat, btn) {
    currentCategory = cat;
    document.querySelectorAll('.topic-tab').forEach(b => {
      b.classList.remove('btn-dark', 'active');
      b.classList.add('btn-outline-secondary');
    });
    btn.classList.remove('btn-outline-secondary');
    btn.classList.add('btn-dark', 'active');

    filterDiscussions();
  }

  function filterDiscussions() {
    const query = (document.getElementById('discussionSearchInput').value || '').toLowerCase().trim();
    const items = document.querySelectorAll('.discussion-item');
    let visibleCount = 0;

    items.forEach(item => {
      const itemCat = item.getAttribute('data-category');
      const itemKeywords = (item.getAttribute('data-keywords') || '') + ' ' + (item.innerText || '').toLowerCase();

      const matchCategory = (currentCategory === 'all' || itemCat === currentCategory);
      const matchSearch = (!query || itemKeywords.includes(query));

      if (matchCategory && matchSearch) {
        item.style.display = '';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    const badge = document.getElementById('activeTopicCountBadge');
    if (badge) {
      badge.innerText = `Showing ${visibleCount} Discussions`;
    }

    const emptyState = document.getElementById('noDiscussionsFound');
    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('d-none');
      } else {
        emptyState.classList.add('d-none');
      }
    }
  }

  document.getElementById('discussionSearchInput').addEventListener('input', filterDiscussions);

  function toggleUpvote(btn, disId, baseCount) {
    const countSpan = btn.querySelector('.vote-count');
    const isVoted = btn.classList.contains('btn-primary');
    let current = parseInt(countSpan.innerText, 10) || baseCount || 0;
    if (isVoted) {
      btn.classList.remove('btn-primary');
      btn.classList.add('btn-outline-secondary');
      countSpan.innerText = Math.max(0, current - 1);
    } else {
      btn.classList.remove('btn-outline-secondary');
      btn.classList.add('btn-primary');
      countSpan.innerText = current + 1;
      if (disId) {
        fetch('/live-discussion/' + disId + '/upvote', {
          method: 'POST',
          headers: { 'Accept': 'application/json' }
        }).catch(err => console.error('Upvote error:', err));
      }
    }
  }

  function submitReply(e, form, repliesId) {
    e.preventDefault();
    const input = form.querySelector('input[name="content"]');
    const text = (input ? input.value : '').trim();
    if (!text) return;

    const list = form.parentElement.querySelector('.pe-replies-list');
    const emptyMsg = list ? list.querySelector('.empty-replies-msg') : null;
    if (emptyMsg) emptyMsg.remove();

    const authorName = '<%= currentUser ? currentUser.name : "Student Member" %>';
    const nowIso = new Date().toISOString();
    
    const replyDiv = document.createElement('div');
    replyDiv.className = 'p-2.5 bg-primary-subtle rounded-3 text-xs border border-primary-subtle';
    replyDiv.innerHTML = `
      <div class="d-flex justify-content-between font-weight-semibold text-primary mb-1">
        <span>${escapeHtml(authorName)}</span>
        <span class="text-muted text-xs time-ago" data-timestamp="${nowIso}">Just now</span>
      </div>
      <p class="text-dark mb-0">${escapeHtml(text)}</p>
    `;
    
    // Put new reply at the very TOP of the replies list
    if (list) {
      list.insertAdjacentElement('afterbegin', replyDiv);
    }

    // Submit formData in background
    const formData = new FormData(form);
    const params = new URLSearchParams();
    for (const pair of formData.entries()) {
      params.append(pair[0], pair[1]);
    }

    fetch('/live-discussion/reply', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json'
      },
      body: params.toString()
    }).catch(err => console.error('Reply submission error:', err));

    if (input) input.value = '';

    // Update count badge
    const card = form.closest('.pe-discussion-card');
    const replyCountSpan = card ? card.querySelector('.reply-count') : null;
    if (replyCountSpan) {
      replyCountSpan.innerText = (parseInt(replyCountSpan.innerText, 10) || 0) + 1;
    }

    updateAllTimestamps();
  }

  function formatTimeAgo(timestamp) {
    if (!timestamp) return 'Just now';
    const date = new Date(timestamp);
    const now = new Date();
    const diffInSec = Math.floor((now - date) / 1000);

    if (diffInSec < 45) {
      return 'Just now';
    }
    const diffInMin = Math.floor(diffInSec / 60);
    if (diffInMin < 60) {
      return diffInMin + 'm ago';
    }
    const diffInHours = Math.floor(diffInMin / 60);
    if (diffInHours < 24) {
      return diffInHours + 'h ago';
    }
    const diffInDays = Math.floor(diffInHours / 24);
    if (diffInDays < 30) {
      return diffInDays + 'd ago';
    }
    const diffInMonths = Math.floor(diffInDays / 30);
    if (diffInMonths < 12) {
      return diffInMonths + 'mo ago';
    }
    const diffInYears = Math.floor(diffInDays / 365);
    return diffInYears + 'y ago';
  }

  function updateAllTimestamps() {
    document.querySelectorAll('.time-ago').forEach(el => {
      const ts = el.getAttribute('data-timestamp');
      if (ts) {
        el.textContent = formatTimeAgo(ts);
      }
    });
  }

  // Initial update and periodic refresh every 10 seconds
  document.addEventListener('DOMContentLoaded', updateAllTimestamps);
  updateAllTimestamps();
  setInterval(updateAllTimestamps, 10000);

  function escapeHtml(text) {
    var map = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    };
    return String(text).replace(/[&<>"']/g, function(m) { return map[m]; });
  }
</script>
