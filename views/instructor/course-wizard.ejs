                    <label class="form-label small font-weight-semibold">Document Title / Note Name</label>
                    <input type="text" name="note_title[]" class="form-control rounded-3" value="<%= n.title || '' %>" placeholder="e.g. Full Lecture Notes & High-Yield Summary">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label small font-weight-semibold text-primary">
                      <i class="ri-upload-cloud-2-line me-1"></i> Upload Replacement Document / Image File
                    </label>
                    <input type="file" name="note_file_<%= idx %>" class="form-control rounded-3" accept="image/*,.png,.jpg,.jpeg,.webp,.svg,.pdf,.doc,.docx,.txt,.ppt,.pptx,.xls,.xlsx,.zip,*" onchange="autoParseNoteDocument(this)">
                    <% if (n.file_url) { %>
                      <span class="text-muted small d-block mt-1">
                        Current Attached File: <strong class="text-dark"><%= n.file_url.split('/').pop() %></strong>
                      </span>
                    <% } %>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label small font-weight-semibold text-secondary">Or Enter Document Link / Drive URL</label>
                    <input type="text" name="note_url[]" class="form-control rounded-3" value="<%= (n.file_url && n.file_url !== '/images/logo-icon.png') ? n.file_url : '' %>" placeholder="https://drive.google.com/...">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label small font-weight-semibold">Notes Summary & Key Takeaways</label>
                    <input type="text" name="note_content[]" class="form-control rounded-3" value="<%= (n.content || '').substring(0, 300) %>" placeholder="Key points, summary notes, or exam highlights...">
                  </div>

                  <% if (isImageNote && n.file_url) { %>
                    <!-- LIVE DISPLAYED IMAGE PREVIEW CONTAINER -->
                    <div class="col-12 mt-2 note-live-img-preview">
                      <div class="p-3 bg-dark rounded-3 border border-secondary text-center">
                        <span class="badge bg-success text-white mb-2 font-weight-bold small">
                          <i class="ri-image-fill me-1"></i> Uploaded Text Image Display Preview
                        </span>
                        <div class="d-block">
                          <img src="<%= n.file_url %>" alt="<%= n.title %>" class="img-fluid rounded shadow note-live-img" style="max-height: 220px; object-fit: contain; cursor: zoom-in;" onclick="window.open(this.src, '_blank')" onerror="this.style.display='none'">
                        </div>
                        <span class="text-white-50 small d-block mt-1.5">
                          <i class="ri-checkbox-circle-fill text-success me-1"></i> This uploaded image is set and will be displayed in the interactive subject portal.
                        </span>
                      </div>
                    </div>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="p-3 bg-white rounded-3 border mb-2">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label small font-weight-semibold">Document Title / Note Name</label>
                  <input type="text" name="note_title[]" class="form-control rounded-3" placeholder="e.g. Full Lecture Notes & High-Yield Summary">
                </div>
                <div class="col-md-6">
                  <label class="form-label small font-weight-semibold text-primary">
                    <i class="ri-upload-cloud-2-line me-1"></i> Upload Document File (PDF, DOC, DOCX, TXT, PPT, etc.)
                  </label>
                  <input type="file" name="note_file_0" class="form-control rounded-3" accept=".pdf,.doc,.docx,.txt,.ppt,.pptx,.xls,.xlsx,.zip,*" onchange="autoParseNoteDocument(this)">
                  <span class="text-muted small d-block mt-1">Select any document format from your device.</span>
                </div>
                <div class="col-md-6">
                  <label class="form-label small font-weight-semibold text-secondary">Or Enter Document Link / Drive URL</label>
                  <input type="text" name="note_url[]" class="form-control rounded-3" placeholder="https://drive.google.com/...">
                </div>
                <div class="col-md-6">
                  <label class="form-label small font-weight-semibold">Notes Summary & Key Takeaways</label>
                  <input type="text" name="note_content[]" class="form-control rounded-3" placeholder="Key points, summary notes, or exam highlights...">
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <div class="card border-0 shadow-sm p-4 bg-light rounded-4 mb-4 border d-none" id="portal-panel-7">
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
          <h6 class="fw-bold text-dark mb-0"><i class="ri-pulse-line text-info me-2 fs-5"></i>7. MRIs & Radiology Clinical Cases</h6>
          <button type="button" class="btn btn-sm btn-outline-info rounded-pill font-weight-bold" onclick="addRadiologyRow()">+ Add Scan Case</button>
        </div>
        <div id="radiologyContainer">
          <div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
            <div class="col-md-5"><input type="text" name="mri_title[]" class="form-control rounded-3" placeholder="e.g. ACL Tear & Meniscal Injury MRI Scan"></div>
            <div class="col-md-3"><select name="mri_type[]" class="form-select rounded-3"><option value="MRI T2">MRI T2</option><option value="X-Ray">X-Ray</option><option value="CT Scan">CT Scan</option></select></div>
            <div class="col-md-4"><input type="text" name="mri_image[]" class="form-control rounded-3" placeholder="/images/radiology/acl-mri.jpg"></div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm p-4 bg-light rounded-4 mb-4 border d-none" id="portal-panel-8">
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
          <h6 class="fw-bold text-dark mb-0"><i class="ri-file-text-line text-danger me-2 fs-5"></i>8. Study Notes & Document Uploads Configuration</h6>
          <button type="button" class="btn btn-sm btn-outline-danger rounded-pill font-weight-bold" onclick="addNotesRow()">+ Add Notes / Document File</button>
        </div>
        <div id="notesContainer">
          <div class="p-3 bg-white rounded-3 border mb-2">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label small font-weight-semibold">Document Title / Note Name</label>
                <input type="text" name="note_title[]" class="form-control rounded-3" placeholder="e.g. Unit 1 Clinical Notes & Study Guide">
              </div>
              <div class="col-md-6">
                <label class="form-label small font-weight-semibold text-danger">
                  <i class="ri-upload-cloud-2-line me-1"></i> Upload Document File (PDF, DOC, DOCX, TXT, PPT, etc.)
                </label>
                <input type="file" name="note_file_0" class="form-control rounded-3" accept=".pdf,.doc,.docx,.txt,.ppt,.pptx,.xls,.xlsx,.zip,*" onchange="autoParseNoteDocument(this)">
                <span class="text-muted small d-block mt-1">Select any document format from your device.</span>
              </div>
              <div class="col-md-6">
                <label class="form-label small font-weight-semibold text-secondary">Or Enter Document Link / Drive URL</label>
                <input type="text" name="note_url[]" class="form-control rounded-3" placeholder="https://drive.google.com/...">
              </div>
              <div class="col-md-6">
                <label class="form-label small font-weight-semibold">Notes Summary & Key Points</label>
                <input type="text" name="note_content[]" class="form-control rounded-3" placeholder="Key takeaways, summary notes, or exam topics...">
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm p-4 bg-light rounded-4 mb-4 border d-none" id="portal-panel-9">
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
          <h6 class="fw-bold text-dark mb-0"><i class="ri-heart-pulse-line text-danger me-2 fs-5"></i>9. Stroke & Clinical Pathology Protocols</h6>
          <button type="button" class="btn btn-sm btn-outline-danger rounded-pill font-weight-bold" onclick="addPathologyRow()">+ Add Pathology Item</button>
        </div>
        <div id="pathologyContainer">
          <div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
            <div class="col-md-5"><input type="text" name="path_name[]" class="form-control rounded-3" placeholder="e.g. Hemiplegic Stroke Gait & Spasticity"></div>
            <div class="col-md-7"><input type="text" name="path_desc[]" class="form-control rounded-3" placeholder="Bobath technique, weight bearing exercises, gait retraining"></div>
          </div>
        </div>
      </div>

    </div>

    <!-- ============ CLEAN & PROFESSIONAL STICKY ACTION BAR ============ -->
    <div class="card border border-light-subtle shadow-sm rounded-4 p-3 bg-white sticky-bottom mb-4 z-3">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-2">
          <i class="ri-checkbox-circle-fill text-success fs-5"></i>
          <span class="fw-semibold text-dark small">Course configuration auto-saves upon submission</span>
        </div>
        <div class="d-flex align-items-center gap-2.5">
          <button type="submit" name="is_publish" value="0" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
            <i class="ri-save-line me-1"></i> Save Draft
          </button>
          <button type="submit" name="is_publish" value="1" class="btn btn-primary rounded-pill px-4.5 fw-semibold shadow-sm" style="background: #0a5dc2; border-color: #0a5dc2;">
            <i class="ri-check-double-line me-1"></i> Publish Course
          </button>
        </div>
      </div>
    </div>

  </form>

</div>

<!-- INTERACTIVE JS CLICK HANDLERS -->
<script>
  function syncActivePortalFeaturesInput() {
    const activeList = [];
    for (let i = 1; i <= 9; i++) {
      const card = document.getElementById('card-' + i);
      const panel = document.getElementById('portal-panel-' + i);
      const isActive = (panel && !panel.classList.contains('d-none')) || (card && card.classList.contains('active-card'));
      if (isActive) {
        activeList.push(String(i));
      }
    }
    const input = document.getElementById('activePortalFeaturesInput');
    if (input) input.value = JSON.stringify(activeList);
  }

  function togglePortalPanel(id) {
    const card = document.getElementById('card-' + id);
    const badge = document.getElementById('badge-' + id);
    const panel = document.getElementById('portal-panel-' + id);

    if (panel) {
      if (panel.classList.contains('d-none')) {
        panel.classList.remove('d-none');
        if (card) {
          card.classList.add('border-primary', 'shadow', 'active-card');
          card.style.borderWidth = '2px';
        }
        if (badge) {
          badge.classList.remove('d-none', 'bg-secondary');
          badge.classList.add('bg-primary');
        }
      } else {
        panel.classList.add('d-none');
        if (card) {
          card.classList.remove('border-primary', 'shadow', 'active-card');
          card.style.borderWidth = '1px';
        }
        if (badge) {
          badge.classList.add('d-none');
        }
      }
    } else if (card) {
      if (card.classList.contains('active-card')) {
        card.classList.remove('border-primary', 'shadow', 'active-card');
        card.style.borderWidth = '1px';
        if (badge) badge.classList.add('d-none');
      } else {
        card.classList.add('border-primary', 'shadow', 'active-card');
        card.style.borderWidth = '2px';
        if (badge) {
          badge.classList.remove('d-none', 'bg-secondary');
          badge.classList.add('bg-primary');
        }
      }
    }
    syncActivePortalFeaturesInput();
  }

  function addRegionRow() {
    const html = `<div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
      <div class="col-md-5"><input type="text" name="region_name[]" class="form-control rounded-3" placeholder="Region Name"></div>
      <div class="col-md-7"><input type="text" name="region_desc[]" class="form-control rounded-3" placeholder="Description & Nerve Pathways"></div>
    </div>`;
    document.getElementById('regionsContainer').insertAdjacentHTML('beforeend', html);
  }

  function addCrossSectionRow() {
    const html = `<div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
      <div class="col-md-4"><input type="text" name="cross_title[]" class="form-control rounded-3" placeholder="Section Title"></div>
      <div class="col-md-4"><input type="text" name="cross_image[]" class="form-control rounded-3" placeholder="Image URL / File"></div>
      <div class="col-md-4"><input type="text" name="cross_desc[]" class="form-control rounded-3" placeholder="Tissue Layer Description"></div>
    </div>`;
    document.getElementById('crossSectionsContainer').insertAdjacentHTML('beforeend', html);
  }

  function addHDVideoRow() {
    const html = `<div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
      <div class="col-md-6"><input type="text" name="hd_video_title[]" class="form-control rounded-3" placeholder="Lecture Title"></div>
      <div class="col-md-6"><input type="text" name="hd_video_url[]" class="form-control rounded-3" placeholder="Embed Stream URL"></div>
    </div>`;
    document.getElementById('hdVideosContainer').insertAdjacentHTML('beforeend', html);
  }

  function addHotspotRow() {
    const html = `<div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
      <div class="col-md-4"><input type="text" name="pin_title[]" class="form-control rounded-3" placeholder="Pin Title"></div>
      <div class="col-md-4"><input type="text" name="pin_origin[]" class="form-control rounded-3" placeholder="Origin & Insertion"></div>
      <div class="col-md-4"><input type="text" name="pin_nerve[]" class="form-control rounded-3" placeholder="Nerve Supply & Action"></div>
    </div>`;
    document.getElementById('hotspotsContainer').insertAdjacentHTML('beforeend', html);
  }

  function addRadiologyRow() {
    const html = `<div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
      <div class="col-md-5"><input type="text" name="mri_title[]" class="form-control rounded-3" placeholder="Case Title"></div>
      <div class="col-md-3"><select name="mri_type[]" class="form-select rounded-3"><option value="MRI T2">MRI T2</option><option value="X-Ray">X-Ray</option><option value="CT Scan">CT Scan</option></select></div>
      <div class="col-md-4"><input type="text" name="mri_image[]" class="form-control rounded-3" placeholder="Image URL / File"></div>
    </div>`;
    document.getElementById('radiologyContainer').insertAdjacentHTML('beforeend', html);
  }

  let noteCounter = <%= (locals.notes && notes.length > 0) ? notes.length : 0 %>;
  function addNotesRow() {
    noteCounter++;
    const html = `<div class="p-3 bg-white rounded-3 border mb-3 note-row-card">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="badge bg-secondary rounded-pill px-3 py-1 font-weight-bold">New Unsaved Document ${noteCounter}</span>
        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 font-weight-semibold" onclick="deleteNoteDocument('', this)">
          <i class="ri-delete-bin-line me-1"></i> Remove Row
        </button>
      </div>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label small font-weight-semibold">Document Title / Note Name</label>
          <input type="text" name="note_title[]" class="form-control rounded-3" placeholder="e.g. Additional Notes Document ${noteCounter + 1}">
        </div>
        <div class="col-md-6">
          <label class="form-label small font-weight-semibold text-danger">
            <i class="ri-upload-cloud-2-line me-1"></i> Upload Document File (PDF, DOC, DOCX, TXT, PPT, etc.)
          </label>
