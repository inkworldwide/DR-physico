                    <% if (n.file_url) { %>
                      <a href="<%= n.file_url %>" target="_blank" class="btn btn-sm <%= isImageNote ? 'btn-outline-success' : 'btn-outline-primary' %> rounded-pill px-3 py-1 font-weight-semibold">
                        <i class="<%= isImageNote ? 'ri-image-line' : 'ri-external-link-line' %> me-1"></i> <%= isImageNote ? 'View High-Res Image' : 'View / Download File' %>
                      </a>
                    <% } %>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 font-weight-semibold" onclick="deleteNoteDocument('<%= n.id %>', this)" title="Delete Document">
                      <i class="ri-delete-bin-line me-1"></i> Delete Document
                    </button>
                  </div>
                </div>
                <div class="row g-3">
