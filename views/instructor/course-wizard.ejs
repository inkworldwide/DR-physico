  function isJunkTitle(t) {
    if (!t) return true;
    const s = t.trim().toLowerCase();
    if (s.length < 3) return true;
    if (/^page\s*[-:#.]?\s*\d+/i.test(s)) return true;
    if (/^pg?\.?\s*[-:#.]?\s*\d+/i.test(s)) return true;
    if (/^\d+(\s*(of|\/|-)\s*\d+)?$/i.test(s)) return true;
    if (/^(slide|sheet|section)\s*[-:#.]?\s*\d+/i.test(s)) return true;
    if (/^(untitled|document|file|notes|study notes|pdf|scan|download|sample|reading material|handout)$/i.test(s)) return true;
    if (/^(uploaded course|uploaded pdf study guide|uploaded file resource|uploaded study notes)$/i.test(s)) return true;
    return false;
  }

  // INSTANT AUTO-FILL DOCUMENT TITLE, OBJECTIVES & INTERACTIVE FEATURES PARSER
  async function autoParseNoteDocument(input) {
    if (!input.files || input.files.length === 0) return;
    const file = input.files[0];
    const card = input.closest('.note-row-card') || input.closest('.lesson-row-card') || input.closest('.p-3');

    const titleInput = card ? card.querySelector('input[name="note_title[]"], input[name="lesson_title"], input[name="title"]') : null;
    const summaryInput = card ? card.querySelector('input[name="note_content[]"], textarea[name="lesson_notes"], textarea[name="description"]') : null;
    const urlInput = card ? card.querySelector('input[name="note_url[]"], input[name="pdf_url"]') : null;

    // 1. INSTANT ZERO-DELAY AUTO-FILL FROM FILENAME
    const rawName = file.name.replace(/\.[^/.]+$/, '');
    const cleanName = rawName.replace(/[-_]+/g, ' ').trim();
    const formattedTitle = cleanName.split(' ').map(w => w ? w.charAt(0).toUpperCase() + w.slice(1).toLowerCase() : '').join(' ');

    const ext = (file.name.split('.').pop() || '').toLowerCase();
    const imgExts = ['jpg', 'jpeg', 'png', 'webp', 'svg', 'gif', 'dicom'];
    const videoExts = ['mp4', 'webm', 'mov', 'avi', 'mkv'];
    const modelExts = ['glb', 'gltf', 'zip', 'html', 'htm'];

    let smartSummary = '';
    if (imgExts.includes(ext)) {
      smartSummary = `[INTERACTIVE_MODULE] High-definition anatomical cross-section & imaging diagram for ${formattedTitle}. Features interactive pin hotspots, structural landmarks, and clinical pathology annotations.`;
    } else if (videoExts.includes(ext)) {
      smartSummary = `[INTERACTIVE_MODULE] HD Video lecture & clinical prosection demonstration covering ${formattedTitle}. Key features: 360° camera view, step-by-step physical examination, and self-assessment quiz.`;
    } else if (modelExts.includes(ext)) {
      smartSummary = `[INTERACTIVE_MODULE] 360° Rotatable WebGL 3D anatomical model & interactive clinical simulation portal for ${formattedTitle}.`;
    } else {
      smartSummary = `• Core concepts and clinical reading guide extracted from ${file.name}.\n• High-yield definitions, examination protocols, and interactive self-study notes.`;
    }

    if (titleInput && (!titleInput.value || isJunkTitle(titleInput.value))) {
      titleInput.value = formattedTitle;
    }
    if (summaryInput) {
      summaryInput.value = smartSummary;
    }

    if (imgExts.includes(ext) && card) {
      let previewBox = card.querySelector('.note-live-img-preview');
      let previewImg = card.querySelector('.note-live-img');
      if (!previewBox) {
        const row = card.querySelector('.row') || card;
        const previewHtml = `<div class="col-12 mt-2 note-live-img-preview">
          <div class="p-3 bg-dark rounded-3 border border-secondary text-center">
            <span class="badge bg-success text-white mb-2 font-weight-bold small">
              <i class="ri-image-fill me-1"></i> Uploaded Text Image Display Preview
            </span>
            <div class="d-block">
              <img src="" class="img-fluid rounded shadow note-live-img" style="max-height: 220px; object-fit: contain; cursor: zoom-in;" onclick="window.open(this.src, '_blank')">
            </div>
            <span class="text-white-50 small d-block mt-1.5">
              <i class="ri-checkbox-circle-fill text-success me-1"></i> This uploaded image is set and will be displayed in the interactive subject portal.
            </span>
          </div>
        </div>`;
        row.insertAdjacentHTML('beforeend', previewHtml);
        previewBox = card.querySelector('.note-live-img-preview');
        previewImg = card.querySelector('.note-live-img');
      }
      if (previewImg) {
        const reader = new FileReader();
        reader.onload = function(e) {
          previewImg.src = e.target.result;
          if (previewBox) previewBox.classList.remove('d-none');
        };
        reader.readAsDataURL(file);
      }
    }

    // Auto-fill main Step 1 course title if blank or junk
    const mainTitle = document.querySelector('input[name="title"]');
    if (mainTitle && (!mainTitle.value || isJunkTitle(mainTitle.value))) {
      mainTitle.value = formattedTitle;
    }

    let statusBadge = card ? card.querySelector('.parse-status-badge') : null;
    if (card && !statusBadge) {
      statusBadge = document.createElement('div');
      statusBadge.className = 'parse-status-badge small mt-1 font-weight-bold text-primary';
      input.parentNode.appendChild(statusBadge);
    }
    if (statusBadge) {
      statusBadge.className = 'parse-status-badge small mt-1 font-weight-bold text-primary';
      statusBadge.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> ⚡ Extracting document title & key takeaways...';
    }

    const noteIdInput = card ? card.querySelector('input[name="note_id[]"]') : null;
    const formData = new FormData();
    formData.append('doc_file', file);
    if (noteIdInput && noteIdInput.value) {
      formData.append('note_id', noteIdInput.value);
    }

    try {
      const res = await fetch('/instructor/courses/wizard/parse-document', {
        method: 'POST',
        body: formData
      });
      const result = await res.json();

      if (result.success) {
        if (result.pdf_url && urlInput) {
          urlInput.value = result.pdf_url;
        }

        const data = result.data;
        if (data) {
          if (titleInput) {
            if (data.title && !isJunkTitle(data.title)) {
              titleInput.value = data.title;
            } else if (!titleInput.value || isJunkTitle(titleInput.value)) {
              titleInput.value = formattedTitle;
            }
          }
          if (summaryInput && data.keyHighlights && !imgExts.includes(ext) && !videoExts.includes(ext) && !modelExts.includes(ext)) {
            summaryInput.value = data.keyHighlights;
          }
        }

        if (statusBadge) {
          const finalTitle = (titleInput && titleInput.value) ? titleInput.value : formattedTitle;
          statusBadge.className = 'parse-status-badge small mt-1 font-weight-bold text-success';
          statusBadge.innerHTML = '✨ Document title set: ' + finalTitle;
        }
      } else if (statusBadge) {
        statusBadge.className = 'parse-status-badge small mt-1 font-weight-bold text-success';
        statusBadge.innerHTML = '✨ Auto-filled from filename: ' + formattedTitle;
      }
    } catch (err) {
      console.warn('Auto parse server warning:', err);
      if (statusBadge) {
        statusBadge.className = 'parse-status-badge small mt-1 font-weight-bold text-success';
        statusBadge.innerHTML = '✨ Auto-filled from filename: ' + formattedTitle;
      }
    }
  }

  // COURSE FORMAT SELECTION (HYBRID VS PDF DOCUMENT ONLY)
  function selectCourseFormat(format) {
    const input = document.getElementById('courseTypeInput');
    if (input) input.value = format;
    const cardHybrid = document.getElementById('cardFormatHybrid');
    const cardPdf = document.getElementById('cardFormatPdf');
    if (format === 'pdf_document') {
      if (cardHybrid) cardHybrid.className = 'card p-3 border rounded-3 cursor-pointer delivery-type-card';
      if (cardPdf) cardPdf.className = 'card p-3 border rounded-3 cursor-pointer delivery-type-card border-success bg-success-subtle';
    } else {
      if (cardHybrid) cardHybrid.className = 'card p-3 border rounded-3 cursor-pointer delivery-type-card border-primary bg-primary-subtle';
      if (cardPdf) cardPdf.className = 'card p-3 border rounded-3 cursor-pointer delivery-type-card';
    }
  }

  const allWizardSubjectOptions = <%- JSON.stringify(categories.map(c => ({
    value: String(c.id),
    text: c.name,
    year: String(c.year || 'other')
  }))) %>;

  function filterSubjectsByYear(selectedYearValue) {
    let yearNum = "1";
    if (selectedYearValue.includes("1")) yearNum = "1";
    else if (selectedYearValue.includes("2")) yearNum = "2";
    else if (selectedYearValue.includes("3")) yearNum = "3";
    else if (selectedYearValue.includes("4")) yearNum = "4";
    else yearNum = "other";

    const subjectSelect = document.getElementById('subjectCategorySelector');
    if (!subjectSelect) return;

    const currentVal = subjectSelect.value;
    subjectSelect.innerHTML = '';

    let firstVal = null;
    let hasMatch = false;

    allWizardSubjectOptions.forEach(optData => {
      const optYear = optData.year;
      const isMatch = (yearNum === 'other')
        ? (optYear === 'null' || optYear === 'other' || !optYear || optYear === '0')
        : (optYear === yearNum);

      if (isMatch) {
        const newOpt = document.createElement('option');
        newOpt.value = optData.value;
        newOpt.textContent = optData.text;
        newOpt.setAttribute('data-year', optData.year);
        if (!firstVal) firstVal = optData.value;
        if (optData.value === currentVal) {
          newOpt.selected = true;
          hasMatch = true;
        }
        subjectSelect.appendChild(newOpt);
      }
    });

    if (!hasMatch && firstVal) {
      subjectSelect.value = firstVal;
    }
  }

  const preselectedSubjectId = "<%= (course && course.category_id) ? course.category_id : (selectedCategoryId || '') %>";

  function initWizardFilter() {
    const yearSelect = document.getElementById('yearSelector');
    if (yearSelect) {
      filterSubjectsByYear(yearSelect.value);
      if (preselectedSubjectId) {
        const subjectSelect = document.getElementById('subjectCategorySelector');
        if (subjectSelect) {
          subjectSelect.value = preselectedSubjectId;
        }
      }
    }
  }

  initWizardFilter();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWizardFilter);
  }
</script>
