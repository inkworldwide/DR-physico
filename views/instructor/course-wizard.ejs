  async function deleteNoteDocument(noteId, buttonEl) {
    const card = buttonEl.closest('.note-row-card') || buttonEl.closest('.border');
    if (!noteId) {
      if (card) card.remove();
      return;
    }
    if (!confirm('Are you sure you want to delete this study note document permanently?')) {
      return;
    }
    try {
      buttonEl.disabled = true;
      buttonEl.innerHTML = '<i class="ri-loader-4-line spin me-1"></i> Deleting...';
      const res = await fetch(`/instructor/notes/${noteId}/delete`, {
        method: 'POST',
        headers: { 'Accept': 'application/json' }
      });
      const data = await res.json();
      if (data.success) {
        if (card) card.remove();
        const countHeader = document.querySelector('#portal-panel-6 h6');
        if (countHeader) {
          const remaining = document.querySelectorAll('#notesContainer6 .note-row-card').length;
          countHeader.innerHTML = `<i class="ri-file-text-line text-primary me-2 fs-5"></i>6. Study Notes & Document Uploads Configuration ${remaining > 0 ? `(${remaining} Documents Attached)` : ''}`;
        }
      } else {
        alert(data.message || 'Could not delete note document.');
        buttonEl.disabled = false;
        buttonEl.innerHTML = '<i class="ri-delete-bin-line me-1"></i> Delete Document';
      }
    } catch (err) {
      console.error('Delete note error:', err);
      alert('Could not delete note document. Please try again.');
      buttonEl.disabled = false;
      buttonEl.innerHTML = '<i class="ri-delete-bin-line me-1"></i> Delete Document';
    }
  }

