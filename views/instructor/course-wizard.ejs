      </div>

      <!-- DEDICATED FEATURE CONFIGURATION PANELS 1 TO 9 -->
      <div class="card border-0 shadow-sm p-4 bg-light rounded-4 mb-4 border" id="portal-panel-1">
        <h6 class="fw-bold text-dark mb-3 border-bottom pb-2"><i class="ri-film-line text-primary me-2 fs-5"></i>1. Center 3D Video Stream Configuration</h6>
        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label small font-weight-semibold">3D Video Stream Endpoint / MP4 URL</label>
            <input type="text" class="form-control rounded-3" value="/videos/stream/anat-m1-l1">
            <span class="form-text text-muted">Streams natively inside PhysioEdvance with zero YouTube dependencies.</span>
          </div>
          <div class="col-md-4">
            <label class="form-label small font-weight-semibold">Lesson Video Duration (Mins)</label>
            <input type="number" class="form-control rounded-3" value="18">
          </div>
        </div>
      </div>



      <div class="card border-0 shadow-sm p-4 bg-light rounded-4 mb-4 border d-none" id="portal-panel-3">
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
          <h6 class="fw-bold text-dark mb-0"><i class="ri-brain-line text-info me-2 fs-5"></i>3. Anatomical Regions & Maps Configuration</h6>
          <button type="button" class="btn btn-sm btn-outline-info rounded-pill font-weight-bold" onclick="addRegionRow()">+ Add Region</button>
        </div>
        <div id="regionsContainer">
          <div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
            <div class="col-md-5"><input type="text" name="region_name[]" class="form-control rounded-3" placeholder="e.g. Upper Limb & Shoulder Girdle"></div>
            <div class="col-md-7"><input type="text" name="region_desc[]" class="form-control rounded-3" placeholder="Bony landmarks, clavicle, scapula, rotator cuff & brachial plexus."></div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm p-4 bg-light rounded-4 mb-4 border d-none" id="portal-panel-4">
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
          <h6 class="fw-bold text-dark mb-0"><i class="ri-layout-grid-line text-success me-2 fs-5"></i>4. Cross-Sections Configuration</h6>
          <button type="button" class="btn btn-sm btn-outline-success rounded-pill font-weight-bold" onclick="addCrossSectionRow()">+ Add Cross-Section</button>
        </div>
        <div id="crossSectionsContainer">
          <div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
            <div class="col-md-4"><input type="text" name="cross_title[]" class="form-control rounded-3" placeholder="e.g. Mid-Thigh Transverse Cross-Section"></div>
            <div class="col-md-4"><input type="text" name="cross_image[]" class="form-control rounded-3" placeholder="/images/cross/mid-thigh.jpg"></div>
            <div class="col-md-4"><input type="text" name="cross_desc[]" class="form-control rounded-3" placeholder="Quadriceps, femoral artery, sciatic nerve compartment"></div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm p-4 bg-light rounded-4 mb-4 border d-none" id="portal-panel-5">
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
          <h6 class="fw-bold text-dark mb-0"><i class="ri-vidicon-line text-danger me-2 fs-5"></i>5. HD Video Lectures & Dissections</h6>
          <button type="button" class="btn btn-sm btn-outline-danger rounded-pill font-weight-bold" onclick="addHDVideoRow()">+ Add HD Video</button>
        </div>
        <div id="hdVideosContainer">
          <div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
            <div class="col-md-6"><input type="text" name="hd_video_title[]" class="form-control rounded-3" placeholder="e.g. Brachial Plexus C5-T1 Dissection Masterclass"></div>
            <div class="col-md-6"><input type="text" name="hd_video_url[]" class="form-control rounded-3" placeholder="/videos/stream/brachial-masterclass"></div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm p-4 bg-light rounded-4 mb-4 border <%= (locals.notes && notes.length > 0) ? '' : 'd-none' %>" id="portal-panel-6">
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2 flex-wrap gap-2">
          <h6 class="fw-bold text-dark mb-0">
            <i class="ri-file-text-line text-primary me-2 fs-5"></i>6. Notes & Interactive Modules Configuration <%= (locals.notes && notes.length > 0) ? `(${notes.length} Items Attached)` : '' %>
          </h6>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill font-weight-bold" onclick="addNotesRow()">
              <i class="ri-file-add-line me-1"></i> + Add Study Notes File
            </button>
            <button type="button" class="btn btn-sm btn-outline-success rounded-pill font-weight-bold" onclick="addTextImageModuleRow()">
              <i class="ri-image-line me-1"></i> + Add Text Image / Diagram
            </button>
          </div>
        </div>
        <div id="notesContainer6">
          <% if (locals.notes && notes.length > 0) { %>
            <% notes.forEach((n, idx) => { %>
              <% 
                const noteExt = ((n.file_url || '').split('.').pop() || '').toLowerCase();
                const isImageNote = ['png', 'jpg', 'jpeg', 'webp', 'svg', 'gif'].includes(noteExt) || (n.content || '').includes('[INTERACTIVE_MODULE:TEXT_IMAGE]') || (n.title || '').toLowerCase().includes('image') || (n.title || '').toLowerCase().includes('diagram');
                const is3dNote = ['glb', 'gltf', 'zip', 'html', 'htm'].includes(noteExt) || (n.content || '').includes('[INTERACTIVE_MODULE:3D]') || (n.title || '').toLowerCase().includes('3d') || (n.title || '').toLowerCase().includes('webgl');
              %>
              <div class="p-3 bg-white rounded-3 border <%= isImageNote ? 'border-success' : is3dNote ? 'border-info' : '' %> mb-3 note-row-card shadow-sm" style="<%= isImageNote ? 'background-color: #f0fdf4 !important;' : is3dNote ? 'background-color: #f0f9ff !important;' : '' %>">
                <input type="hidden" name="note_id[]" value="<%= n.id %>">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <% if (isImageNote) { %>
                    <span class="badge bg-success rounded-pill px-3 py-1 font-weight-bold"><i class="ri-image-line me-1"></i>Text Image / Diagram #<%= idx + 1 %>: <%= n.title %></span>
                  <% } else if (is3dNote) { %>
                    <span class="badge bg-info text-dark rounded-pill px-3 py-1 font-weight-bold"><i class="ri-box-3-line me-1"></i>3D WebGL Model #<%= idx + 1 %>: <%= n.title %></span>
                  <% } else { %>
                    <span class="badge bg-primary rounded-pill px-3 py-1 font-weight-bold"><i class="ri-file-pdf-line me-1"></i>Document #<%= idx + 1 %>: <%= n.title %></span>
                  <% } %>
