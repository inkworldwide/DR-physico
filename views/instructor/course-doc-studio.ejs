<!-- ============ DEDICATED PDF & DOCUMENT COURSE UPLOAD STUDIO ============ -->
<div class="container-fluid py-4">
  
  <!-- Header Title & Quick Actions -->
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
      <h3 class="fw-bold text-dark mb-1">
        <i class="ri-file-pdf-2-fill text-danger me-2"></i>Dedicated PDF & Document Course Studio
      </h3>
      <p class="text-secondary small mb-0">Upload pure reading-based physiotherapy courses, PDF study guides, ebooks, and module handouts.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/instructor/courses" class="btn btn-outline-secondary rounded-pill px-3.5 font-weight-medium">
        <i class="ri-arrow-left-line me-1"></i> My Courses
      </a>
      <a href="/instructor/courses/wizard" class="btn btn-outline-primary rounded-pill px-3.5 font-weight-medium">
        <i class="ri-video-line me-1"></i> Video Course Studio
      </a>
    </div>
  </div>

  <!-- UPLOAD FORM -->
  <form action="/instructor/courses/wizard/save" method="POST" enctype="multipart/form-data" id="docCourseForm">
    <input type="hidden" name="course_id" value="<%= course ? course.id : '' %>">
    <input type="hidden" name="course_type" value="pdf_document">
    <input type="hidden" name="is_publish" id="isPublishInput" value="1">

    <!-- ============ SECTION 1: PDF DOCUMENT QUICK AUTO-FILL & GENERAL INFO ============ -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border mb-4">
      
      <!-- AI SMART AUTO-FILL BANNER -->
      <div class="card border-0 shadow-sm rounded-4 p-3.5 mb-4 text-white" style="background: linear-gradient(135deg, #7c2d12 0%, #c2410c 50%, #ea580c 100%);">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
          <div>
            <span class="badge bg-white text-danger rounded-pill px-3 py-1 font-weight-bold mb-1">
              <i class="ri-flashlight-fill me-1"></i> Quick PDF Auto-Extractor
            </span>
            <h5 class="fw-bold mb-1 text-white"><i class="ri-file-pdf-line me-1"></i> Upload Syllabus or Study Guide PDF</h5>
            <p class="small text-white-50 mb-0">Drop your PDF notes file here to automatically extract the Course Title, Description, and Module outline!</p>
          </div>
          <div>
            <label for="pdfStudioDocInput" class="btn btn-light text-danger font-weight-bold rounded-pill px-4 shadow-sm mb-0 cursor-pointer">
              <i class="ri-upload-cloud-2-line me-1"></i> Select PDF File
            </label>
            <input type="file" id="pdfStudioDocInput" class="d-none" accept=".pdf,.docx,.doc,.txt" onchange="handleStudioPdfUpload(this)">
          </div>
        </div>
        <div id="pdfStudioProgress" class="d-none mt-3 p-2 bg-white bg-opacity-10 rounded-3">
          <div class="d-flex align-items-center gap-2 small text-white">
            <div class="spinner-border spinner-border-sm text-light" role="status"></div>
            <span id="pdfStudioStatusText">Extracting PDF text and generating study guide hierarchy...</span>
          </div>
        </div>
      </div>

      <div class="row g-3">
        <div class="col-12">
          <label class="form-label font-weight-semibold text-dark">Course / Study Guide Title <span class="text-danger">*</span></label>
          <input type="text" name="title" id="docCourseTitle" class="form-control rounded-3 font-weight-bold" value="<%= course ? course.title : '' %>" placeholder="e.g. Rural Community Health & Sociology Comprehensive PDF Notes" required>
        </div>

        <!-- 1. ACADEMIC YEAR SELECTOR -->
        <div class="col-md-6">
          <label class="form-label font-weight-semibold text-dark"><i class="ri-calendar-event-line text-primary me-1"></i> 1. Academic Year / Program <span class="text-danger">*</span></label>
          <select name="target_exam" id="docYearSelector" class="form-select rounded-3 font-weight-bold border-primary text-primary" onchange="filterDocSubjectsByYear(this.value)" required>
            <option value="BPT 1st Year" <%= (course && course.target_exam === 'BPT 1st Year') ? 'selected' : '' %>>BPT 1st Year (First Year Foundation)</option>
            <option value="BPT 2nd Year" <%= (course && course.target_exam === 'BPT 2nd Year') ? 'selected' : '' %>>BPT 2nd Year (Second Year Core Clinical)</option>
            <option value="BPT 3rd Year" <%= (course && course.target_exam === 'BPT 3rd Year') ? 'selected' : '' %>>BPT 3rd Year (Third Year Advanced Clinical)</option>
            <option value="BPT 4th Year" <%= (course && course.target_exam === 'BPT 4th Year') ? 'selected' : '' %>>BPT 4th Year (Fourth Year Specialisation)</option>
            <option value="Other Electives" <%= (course && course.target_exam === 'Other Electives') ? 'selected' : '' %>>Other Subjects / Electives</option>
          </select>
        </div>

        <!-- 2. DEPENDENT SUBJECT CATEGORY SELECTOR -->
        <div class="col-md-6">
          <label class="form-label font-weight-semibold text-dark"><i class="ri-book-open-line text-success me-1"></i> 2. Target Subject Category <span class="text-danger">*</span></label>
          <select name="category_id" id="docSubjectSelector" class="form-select rounded-3 font-weight-bold" onchange="syncDocVisualSubject(this.value)" required>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" data-year="<%= cat.year || 'other' %>" <%= (course && course.category_id === cat.id) ? 'selected' : '' %>>
                <%= cat.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-12">
          <label class="form-label font-weight-semibold text-dark">Subtitle / Short Summary</label>
          <input type="text" name="subtitle" id="docSubtitle" class="form-control rounded-3" value="<%= course ? course.subtitle : '' %>" placeholder="e.g. Health hazards of rural populations, tribal communities, and health delivery models.">
        </div>

        <div class="col-12">
          <label class="form-label font-weight-semibold text-dark">Full Syllabus Description</label>
          <textarea name="description" id="docDescription" rows="3" class="form-control rounded-3" placeholder="Overview of topics covered in this PDF study guide..."><%= course ? course.description : '' %></textarea>
        </div>

        <div class="col-md-6">
          <label class="form-label font-weight-semibold text-dark">Difficulty Level</label>
          <select name="level" class="form-select rounded-3">
            <option value="Beginner" <%= (course && course.level === 'Beginner') ? 'selected' : '' %>>Beginner</option>
            <option value="Intermediate" <%= (course && course.level === 'Intermediate') ? 'selected' : '' %>>Intermediate</option>
            <option value="Advanced" <%= (course && course.level === 'Advanced') ? 'selected' : '' %>>Advanced</option>
          </select>
        </div>

        <div class="col-md-6">
          <label class="form-label font-weight-semibold text-dark">Estimated Reading Time (Hours)</label>
          <input type="number" name="duration_hours" class="form-control rounded-3" value="<%= course ? course.duration_hours : 6 %>">
        </div>

        <!-- THUMBNAIL COVER -->
        <div class="col-md-6">
          <label class="form-label font-weight-semibold text-dark">
            <i class="ri-image-line text-danger me-1"></i> Upload Course Cover Image (File)
          </label>
          <input type="file" name="thumbnail_file" class="form-control rounded-3" accept="image/*">
        </div>

        <div class="col-md-6">
          <label class="form-label font-weight-semibold text-dark">
            <i class="ri-link text-secondary me-1"></i> Or Cover Image URL
          </label>
          <input type="text" name="thumbnail" class="form-control rounded-3" value="<%= course ? course.thumbnail : '/images/courses/course-placeholder.jpg' %>">
        </div>

      </div>
    </div>

    <!-- ============ SECTION 2: PDF DOCUMENT CHAPTERS & FILES ============ -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border mb-4">
      <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
        <h5 class="fw-bold text-dark mb-0">
          <span class="badge bg-danger rounded-circle me-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">2</span> PDF Documents & Chapter Handouts
        </h5>
        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill font-weight-bold" onclick="addDocLessonRow()">
          <i class="ri-add-line me-1"></i> + Add Another PDF Chapter
        </button>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label small font-weight-semibold">Module / Section Title</label>
          <input type="text" name="module_title" id="docModuleTitle" class="form-control rounded-3" value="Module 1: Complete PDF Study Guide & Handouts" placeholder="e.g. Module 1: Comprehensive Study Notes">
        </div>
        <div class="col-md-6">
          <label class="form-label small font-weight-semibold">Module Description</label>
          <input type="text" name="module_description" class="form-control rounded-3" value="Primary reading materials and lecture documents." placeholder="Module overview...">
        </div>
      </div>

      <div id="docLessonsContainer">
        <!-- PRIMARY PDF LESSON ROW -->
        <div class="p-3 bg-light rounded-3 border mb-3 doc-lesson-card">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="badge bg-danger rounded-pill px-3 py-1 font-weight-bold"><i class="ri-file-pdf-fill me-1"></i> PDF Reading Lesson 1</span>
          </div>
          <div class="row g-3">
            <div class="col-md-7">
              <label class="form-label small font-weight-semibold">Lesson / Chapter Title <span class="text-danger">*</span></label>
              <input type="text" name="lesson_title" id="docLessonTitle_0" class="form-control rounded-3 font-weight-bold" placeholder="e.g. Chapter 1: Meaning & Features of Rural Communities" required>
            </div>
            <div class="col-md-5">
              <label class="form-label small font-weight-semibold">Estimated Reading Time (Minutes)</label>
              <input type="number" name="duration_minutes" class="form-control rounded-3" value="30">
            </div>

            <div class="col-md-6">
              <label class="form-label small font-weight-semibold text-danger"><i class="ri-file-upload-line me-1"></i> Upload PDF Document File <span class="text-danger">*</span></label>
              <input type="file" name="pdf_file_0" id="docPdfFile_0" class="form-control rounded-3" accept=".pdf,.doc,.docx,.ppt,.pptx">
              <span class="text-muted small d-block mt-1">Upload `.pdf` or `.docx` file from your device.</span>
            </div>
            <div class="col-md-6">
              <label class="form-label small font-weight-semibold text-secondary"><i class="ri-link me-1"></i> Or Enter Direct PDF File URL</label>
              <input type="text" name="pdf_url" id="docPdfUrl_0" class="form-control rounded-3" placeholder="/uploads/notes/rural_community.pdf">
            </div>

            <div class="col-12">
              <label class="form-label small font-weight-semibold">In-Built Reading Notes & Key Highlights</label>
              <textarea name="lesson_notes" id="docLessonNotes_0" rows="2" class="form-control rounded-3" placeholder="Key bullet points or summary for Chapter 1..."></textarea>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- SUBMIT BUTTONS -->
    <div class="d-flex align-items-center justify-content-end gap-3 p-3 bg-white border rounded-4 shadow-sm mb-5">
      <button type="submit" onclick="document.getElementById('isPublishInput').value='0'" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 font-weight-bold">
        <i class="ri-save-line me-1"></i> Save as Draft
      </button>
      <button type="submit" onclick="document.getElementById('isPublishInput').value='1'" class="btn btn-danger rounded-pill px-5 py-2.5 font-weight-bold shadow">
        <i class="ri-send-plane-fill me-1"></i> Publish PDF Course Now
      </button>
    </div>

  </form>

</div>

<script>
  let docLessonCounter = 1;

  function addDocLessonRow() {
    docLessonCounter++;
    const idx = docLessonCounter - 1;
    const html = `<div class="p-3 bg-light rounded-3 border mb-3 doc-lesson-card">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="badge bg-danger rounded-pill px-3 py-1 font-weight-bold"><i class="ri-file-pdf-fill me-1"></i> PDF Reading Lesson ${docLessonCounter}</span>
      </div>
      <div class="row g-3">
        <div class="col-md-7">
          <label class="form-label small font-weight-semibold">Lesson / Chapter Title <span class="text-danger">*</span></label>
          <input type="text" name="lesson_title" id="docLessonTitle_${idx}" class="form-control rounded-3 font-weight-bold" placeholder="e.g. Chapter ${docLessonCounter}: Advanced Topic Handout" required>
        </div>
        <div class="col-md-5">
          <label class="form-label small font-weight-semibold">Estimated Reading Time (Minutes)</label>
          <input type="number" name="duration_minutes" class="form-control rounded-3" value="30">
        </div>
        <div class="col-md-6">
          <label class="form-label small font-weight-semibold text-danger"><i class="ri-file-upload-line me-1"></i> Upload PDF Document File</label>
          <input type="file" name="pdf_file_${idx}" class="form-control rounded-3" accept=".pdf,.doc,.docx,.ppt,.pptx">
        </div>
        <div class="col-md-6">
          <label class="form-label small font-weight-semibold text-secondary"><i class="ri-link me-1"></i> Or Enter Direct PDF File URL</label>
          <input type="text" name="pdf_url" id="docPdfUrl_${idx}" class="form-control rounded-3" placeholder="/uploads/notes/handout.pdf">
        </div>
        <div class="col-12">
          <label class="form-label small font-weight-semibold">In-Built Reading Notes & Key Highlights</label>
          <textarea name="lesson_notes" id="docLessonNotes_${idx}" rows="2" class="form-control rounded-3" placeholder="Key points..."></textarea>
        </div>
      </div>
    </div>`;
    document.getElementById('docLessonsContainer').insertAdjacentHTML('beforeend', html);
  }

  // VISUAL SUBJECT SELECTION FOR PDF STUDIO
  function selectDocVisualSubject(catId) {
    const select = document.getElementById('docSubjectSelector');
    if (select) {
      select.value = catId;
      syncDocVisualSubject(catId);
    }
  }

  function syncDocVisualSubject(selectedCatId) {
    document.querySelectorAll('.doc-subject-card-wrapper').forEach(wrapper => {
      const cardId = wrapper.getAttribute('data-cat-id');
      const card = wrapper.querySelector('.doc-visual-card');
      const badge = wrapper.querySelector('.doc-check-badge');
      if (cardId === String(selectedCatId)) {
        if (card) {
          card.classList.add('border-danger', 'shadow-sm', 'bg-danger-subtle');
          card.style.borderWidth = '2px';
        }
        if (badge) badge.classList.remove('d-none');
      } else {
        if (card) {
          card.classList.remove('border-danger', 'shadow-sm', 'bg-danger-subtle');
          card.style.borderWidth = '1px';
        }
        if (badge) badge.classList.add('d-none');
      }
    });
  }

  const allDocSubjectOptions = <%- JSON.stringify(categories.map(c => ({
    value: String(c.id),
    text: c.name,
    year: String(c.year || 'other')
  }))) %>;

  function filterDocSubjectsByYear(selectedYearValue) {
    let yearNum = "1";
    if (selectedYearValue.includes("1")) yearNum = "1";
    else if (selectedYearValue.includes("2")) yearNum = "2";
    else if (selectedYearValue.includes("3")) yearNum = "3";
    else if (selectedYearValue.includes("4")) yearNum = "4";
    else yearNum = "other";

    const subjectSelect = document.getElementById('docSubjectSelector');
    if (!subjectSelect) return;

    const currentVal = subjectSelect.value;
    subjectSelect.innerHTML = '';

    let firstVal = null;
    let hasMatch = false;

    allDocSubjectOptions.forEach(optData => {
      const optYear = optData.year;
      const isMatch = (yearNum === 'other')
        ? (optYear === 'null' || optYear === 'other' || !optYear || optYear === '0')
        : (optYear === yearNum);

      if (isMatch) {
        const newOpt = document.createElement('option');
        newOpt.value = optData.value;
        newOpt.textContent = optData.text;
        newOpt.setAttribute('data-year', optData.year);
        if (!firstVal) firstVal = optData.value;
        if (optData.value === currentVal) {
          newOpt.selected = true;
          hasMatch = true;
        }
        subjectSelect.appendChild(newOpt);
      }
    });

    if (!hasMatch && firstVal) {
      subjectSelect.value = firstVal;
    }
  }

  async function handleStudioPdfUpload(input) {
    if (!input.files || !input.files[0]) return;
    const file = input.files[0];
    
    const progressBox = document.getElementById('pdfStudioProgress');
    const statusText = document.getElementById('pdfStudioStatusText');
    if (progressBox) progressBox.classList.remove('d-none');
    if (statusText) statusText.textContent = `Extracting contents from "${file.name}"...`;

    const formData = new FormData();
    formData.append('doc_file', file);

    let parsed = null;
    let pdfUrl = '';

    try {
      const res = await fetch('/instructor/courses/wizard/parse-document', {
        method: 'POST',
        body: formData
      });
      const contentType = res.headers.get('content-type') || '';
      if (contentType.includes('application/json')) {
        const json = await res.json();
        if (json && json.success) {
          parsed = json.data;
          pdfUrl = json.pdf_url || '';
        }
      }
    } catch (err) {
      console.warn('Server parse fallback notice:', err);
    }

    // Zero-fail fallback from uploaded document name
    if (!parsed) {
      const cleanName = file.name.replace(/\.[^/.]+$/, '').replace(/[-_]/g, ' ').trim();
      parsed = {
        title: cleanName || 'Uploaded PDF Study Guide',
        subtitle: 'Comprehensive reading notes and study guide.',
        description: `Complete study guide and curriculum reading notes for ${cleanName}.`,
        keyHighlights: '• Core Concepts & Clinical Principles\n• Key Definitions & Terminology\n• Examination & Treatment Protocols',
        modules: [{ title: 'Module 1: Complete Study Notes', lessons: [{ title: 'Chapter 1: Reading Material' }] }]
      };
    }

    function isJunkTitle(t) {
      if (!t) return true;
      const s = t.trim().toLowerCase();
      if (s.length < 3) return true;
      if (/^page\s*[-:#.]?\s*\d+/i.test(s)) return true;
      if (/^pg?\.?\s*[-:#.]?\s*\d+/i.test(s)) return true;
      if (/^\d+(\s*(of|\/|-)\s*\d+)?$/i.test(s)) return true;
      if (/^(slide|sheet|section)\s*[-:#.]?\s*\d+/i.test(s)) return true;
      if (/^(untitled|document|file|notes|study notes|pdf|scan|download|sample|reading material|handout)$/i.test(s)) return true;
      return false;
    }

    // 1. Auto-fill Course Title
    const titleInput = document.getElementById('docCourseTitle');
    const cleanDocName = file.name.replace(/\.[^/.]+$/, '').replace(/[-_]/g, ' ').trim();
    const formattedDocTitle = cleanDocName.split(' ').map(w => w ? w.charAt(0).toUpperCase() + w.slice(1).toLowerCase() : '').join(' ');
    if (titleInput) {
      if (parsed.title && !isJunkTitle(parsed.title)) {
        titleInput.value = parsed.title;
      } else {
        titleInput.value = formattedDocTitle;
      }
    }

    // 2. Auto-fill Subtitle & Description
    const subtitleInput = document.getElementById('docSubtitle');
    if (subtitleInput && parsed.subtitle) subtitleInput.value = parsed.subtitle;

    const descInput = document.getElementById('docDescription');
    if (descInput && parsed.description) descInput.value = parsed.description;

    // 3. Auto-fill In-Built Reading Notes & Key Highlights
    const notesInput = document.getElementById('docLessonNotes_0');
    if (notesInput && parsed.keyHighlights) notesInput.value = parsed.keyHighlights;

    // 4. Auto-fill PDF File URL & attach File to input
    const pdfUrlInput = document.getElementById('docPdfUrl_0');
    if (pdfUrlInput && pdfUrl) pdfUrlInput.value = pdfUrl;

    const fileInput0 = document.getElementById('docPdfFile_0');
    if (fileInput0) {
      try {
        const dt = new DataTransfer();
        dt.items.add(file);
        fileInput0.files = dt.files;
      } catch (e) {
        console.warn('DataTransfer notice:', e);
      }
    }

    // 5. Auto-fill First PDF Lesson Title & Module Title
    if (parsed.modules && parsed.modules.length > 0) {
      const firstMod = parsed.modules[0];
      const modTitleInput = document.getElementById('docModuleTitle');
      if (modTitleInput && firstMod.title) modTitleInput.value = firstMod.title;

      if (firstMod.lessons && firstMod.lessons.length > 0) {
        const firstLessonTitle = document.getElementById('docLessonTitle_0');
        if (firstLessonTitle && firstMod.lessons[0].title) {
          firstLessonTitle.value = firstMod.lessons[0].title;
        }

        for (let i = 1; i < firstMod.lessons.length; i++) {
          addDocLessonRow();
          const titleEl = document.getElementById(`docLessonTitle_${i}`);
          if (titleEl) titleEl.value = firstMod.lessons[i].title;
          const notesEl = document.getElementById(`docLessonNotes_${i}`);
          if (notesEl && parsed.keyHighlights) notesEl.value = parsed.keyHighlights;
        }
      }
    }

    setTimeout(() => {
      if (progressBox) progressBox.classList.add('d-none');
      alert(`🎉 PDF Study Guide Parsed & Auto-Filled!\n\n- Title: ${parsed.title}\n- Attached File: ${file.name}\n- Summary & Highlights: Auto-Populated!`);
    }, 300);
  }

  function initDocFilter() {
    const yearSelect = document.getElementById('docYearSelector');
    if (yearSelect) {
      filterDocSubjectsByYear(yearSelect.value);
    }
  }

  // Run immediately so dropdown options are filtered before user interacts
  initDocFilter();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDocFilter);
  }
</script>
